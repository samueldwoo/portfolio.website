---
import Base from '../layouts/Base.astro';
import SiteFoot from '../components/SiteFoot.astro';
import HeroCanvas from '../components/HeroCanvas.tsx';
---

<Base
    title="Samuel Woo — Software Engineer"
    description="Samuel Woo — software engineer, robotics enthusiast. Robotics and embedded systems at Amazon Lab126."
    page="home"
    skipTarget="home"
>
    <!-- Scrolling content -->
    <main class="content">

        <!-- HOME -->
        <section id="home" class="band band-home" aria-labelledby="home-title">
            <!-- Generative atmosphere layer. This REPLACES the old static
                 `.hero-motif` line-draw SVG: same sage stroke register, but a
                 living contour field that eases toward the pointer. It is a
                 direct child of the band (not `.home-inner`) so it sits at
                 z-index 0 under `.band > .band-inner`'s z-index 1 — no
                 stacking-context surprises, and nothing anime.js or GSAP
                 touches lives inside it.

                 client:load (not client:visible): the hero is above the fold on
                 every viewport, so client:visible's IntersectionObserver would
                 fire on the very first frame anyway — it only adds a round-trip
                 before the atmosphere appears. The island still ships as a
                 deferred module, so it never blocks first paint. -->
            <HeroCanvas client:load />
            <div class="band-inner home-inner">
                <p class="hero-meta reveal reveal-clip">
                    <span>Sunnyvale</span>
                    <span class="hero-meta-dot" aria-hidden="true">·</span>
                    <span>robotics @ Amazon</span>
                    <span class="hero-meta-dot" aria-hidden="true">·</span>
                    <span class="hero-status">UCSD EE</span><span class="type-caret" aria-hidden="true">_</span>
                </p>
                <h1 id="home-title" class="hero-name">
                    <span class="hero-line reveal reveal-clip">Samuel</span>
                    <span class="hero-line reveal reveal-clip"><span class="hero-accent">Woo</span></span>
                </h1>
                <p class="hero-subtitle reveal" id="rotating-subtitle">software engineer, part-time robot wrangler</p>
                <div class="hero-lower">
                    <p class="hero-intro reveal">I'm Sam — a robotics engineer in the Bay. I build software for quadruped robots at Amazon, studied electrical engineering at UCSD, and spend most of my free time on a volleyball court or working through a long list of restaurants I keep meaning to finish. This is where I keep the stuff that doesn't fit on a résumé.</p>
                    <a class="explore-cue reveal" href="#interests">
                        <span class="explore-text">Explore</span>
                        <span class="explore-arrow" aria-hidden="true">↓</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- INTERESTS -->
        <!-- First of the two dark plates. The page used to run five light
             bands in a row; inverting this one puts a hard tonal break
             immediately after the hero, so the scroll reads
             light / dark / inset-plate / dark / light instead of one
             uninterrupted sheet. All the colour inversion lives in
             `.band--dark` in styles.css (local custom-property overrides),
             so the markup below is unchanged by it. -->
        <section id="interests" class="band band--shapes band--dark" aria-labelledby="interests-title">
            <!-- Decorative line-art field: draws itself in on enter, then drifts.
                 Same sage stroke register as the hero signature motif. -->
            <svg class="shape-field shape-field--interests" viewBox="0 0 260 260" fill="none" aria-hidden="true">
                <g class="shape-drift">
                    <circle class="shape-ring" cx="132" cy="120" r="86" />
                    <circle class="shape-ring" cx="132" cy="120" r="58" />
                    <path class="shape-line" d="M46 120 C 90 40, 174 40, 218 120" />
                    <path class="shape-line" d="M46 120 C 90 200, 174 200, 218 120" />
                    <path class="shape-line" d="M132 34 L 132 206" />
                    <circle class="shape-dot" cx="132" cy="34" r="4.5" />
                    <circle class="shape-dot shape-dot--soft" cx="218" cy="120" r="4" />
                    <circle class="shape-dot shape-dot--soft" cx="46" cy="120" r="4" />
                    <path class="shape-tick" d="M24 236 L 40 236 M52 236 L 68 236 M80 236 L 96 236 M108 236 L 124 236 M136 236 L 152 236 M164 236 L 180 236" />
                </g>
            </svg>
            <!-- data-rail: the rotated mono running head in the band's left
                 margin (layout.css). Decorative — it repeats the <h2> below,
                 is drawn with generated content so it is never in the a11y
                 tree, and only exists at >=1280px where the gutter does. -->
            <div class="band-inner" data-rail="01 / Interests">
                <div class="section-head">
                    <h2 id="interests-title" class="section-title reveal reveal-clip">Interests</h2>
                </div>

                <div class="section-body">
                    <div class="interests-editorial">
                        <article class="interest-block interest-block--lead reveal">
                            <div class="interest-lead-head">
                                <span class="interest-index" aria-hidden="true">01</span>
                                <h3 class="interest-heading">Sports &amp; Staying Active</h3>
                            </div>
                            <p class="interest-copy">Basketball and baseball growing up, now mostly volleyball on Mondays — the highlight of my week — and golf, which I picked up last year and am still very much learning.</p>
                        </article>

                        <div class="interest-columns">
                            <article class="interest-block reveal">
                                <span class="interest-index" aria-hidden="true">02</span>
                                <h3 class="interest-heading">Food &amp; Restaurants</h3>
                                <p class="interest-copy">I keep a running list of places to try and happily plan a trip around one good meal. A few I recommend often:</p>
                                <ul class="bubble-list">
                                    <li class="bubble">Wolf in the Woods</li>
                                    <li class="bubble">Double Chicken Please</li>
                                    <li class="bubble">San Ho Won</li>
                                    <li class="bubble">Arsicault</li>
                                    <li class="bubble">Zareen's</li>
                                    <li class="bubble">Duc Huong</li>
                                </ul>
                            </article>

                            <article class="interest-block reveal">
                                <span class="interest-index" aria-hidden="true">03</span>
                                <h3 class="interest-heading">Investing &amp; Markets</h3>
                                <p class="interest-copy">I like following the market and thinking about where technology's headed — mostly index funds, with a few bets in areas I actually follow closely.</p>
                                <ul class="bubble-list bubble-list--tickers">
                                    <li><a class="bubble ticker" href="https://finance.yahoo.com/quote/FTEC/" target="_blank" rel="noopener">FTEC</a></li>
                                    <li><a class="bubble ticker" href="https://finance.yahoo.com/quote/VCX/" target="_blank" rel="noopener">VCX</a></li>
                                    <li><a class="bubble ticker" href="https://finance.yahoo.com/quote/RKLB/" target="_blank" rel="noopener">RKLB</a></li>
                                    <li><a class="bubble ticker" href="https://finance.yahoo.com/quote/HOOD/" target="_blank" rel="noopener">HOOD</a></li>
                                    <li><a class="bubble ticker" href="https://finance.yahoo.com/quote/NBIS/" target="_blank" rel="noopener">NBIS</a></li>
                                </ul>
                            </article>
                        </div>
                    </div>

                    <h3 class="subhead reveal">Random Favorites</h3>
                    <div class="favorites-grid">
                        <div class="favorite-item reveal">
                            <span class="favorite-label">Sport</span>
                            <span class="favorite-value">Volleyball (Mondays!)</span>
                        </div>
                        <div class="favorite-item reveal">
                            <span class="favorite-label">Workout</span>
                            <span class="favorite-value">Chest day</span>
                        </div>
                        <div class="favorite-item reveal">
                            <span class="favorite-label">Drink</span>
                            <span class="favorite-value">Iced Americano</span>
                        </div>
                        <div class="favorite-item reveal">
                            <span class="favorite-label">Restaurant</span>
                            <span class="favorite-value">Wolf in the Woods</span>
                        </div>
                        <div class="favorite-item reveal">
                            <span class="favorite-label">Podcast</span>
                            <span class="favorite-value">The Zurkie Show</span>
                        </div>
                        <div class="favorite-item reveal">
                            <span class="favorite-label">Activity</span>
                            <span class="favorite-value">Running &amp; clearing my head</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PROJECTS -->
        <!-- The one INSET band on the page: `band--plate` gives the section
             its own margins, hairline and rounded corners so it reads as a
             sheet laid on the page rather than another full-bleed slab. It
             sits between the two dark plates, which is what makes the
             bleed/inset alternation legible. -->
        <section id="projects" class="band band--shapes band--plate" aria-labelledby="projects-title">
            <!-- Stacked-cards / layered-sheet abstraction, in line-art -->
            <svg class="shape-field shape-field--projects" viewBox="0 0 240 240" fill="none" aria-hidden="true">
                <g class="shape-drift">
                    <path class="shape-line" d="M30 88 L 120 44 L 210 88 L 120 132 Z" />
                    <path class="shape-line" d="M30 128 L 120 84 L 210 128 L 120 172 Z" />
                    <path class="shape-line" d="M30 168 L 120 124 L 210 168 L 120 212 Z" />
                    <circle class="shape-dot" cx="120" cy="44" r="4.5" />
                    <circle class="shape-dot shape-dot--soft" cx="120" cy="212" r="4" />
                </g>
            </svg>
            <div class="band-inner" data-rail="02 / Projects">
                <div class="section-head">
                    <h2 id="projects-title" class="section-title reveal reveal-clip">Projects</h2>
                    <p class="section-intro reveal">A couple I've written up, plus a few still on the bench.</p>
                </div>

                <div class="section-body">
                    <!-- Bento mosaic (layout.css §8). Four tiles on a
                         12-column grid with OFFSET seams — row 1 splits 7/5,
                         row 2 splits 5/7 — so the vertical join moves as the
                         eye travels down. DOM order matches visual order on
                         every breakpoint, including the single-column
                         collapse below 900px. -->
                    <div class="project-grid">
                        <a class="card project-card project-feature reveal spotlight" href="projects.html#cs-finance-title">
                            <span class="project-index" aria-hidden="true">01</span>
                            <ul class="feature-chips" aria-hidden="true">
                                <li>Runs 100% locally</li>
                                <li>Multi-format parsing</li>
                                <li>Cash-flow Sankey</li>
                            </ul>
                            <h4 class="card-title">Ka-ching — Finance Dashboard</h4>
                            <p class="project-tech">Python · JavaScript</p>
                            <p>A local Mint alternative that turns a pile of bank statements into one honest picture of where the money went — no subscriptions, no linked logins, runs entirely on my machine.</p>
                            <span class="card-cta">Read case study <span aria-hidden="true">→</span></span>
                        </a>

                        <a class="card project-card project-card--tall reveal spotlight" href="projects.html#cs-site-title">
                            <span class="project-index" aria-hidden="true">02</span>
                            <h4 class="card-title">This Website</h4>
                            <p class="project-tech">HTML/CSS/JS</p>
                            <p>Hand-written, no framework, reduced-motion aware. You're looking at it.</p>
                            <span class="card-cta">Read case study <span aria-hidden="true">→</span></span>
                        </a>

                        <!-- The mosaic's fourth tile: pure type + procedural
                             hatch, no imagery. It exists to break the run of
                             three near-identical cards with a surface that
                             isn't a card, and to carry the biggest numeral on
                             the page against its 11px mono label. -->
                        <div class="bento-plate reveal">
                            <span class="bento-plate-k">On the record</span>
                            <span class="bento-plate-n">05</span>
                            <p class="bento-plate-note">projects tracked. Two written up end to end, three still on the bench.</p>
                        </div>

                        <a class="card project-card project-card--wide reveal spotlight" href="projects.html">
                            <span class="project-index" aria-hidden="true">→</span>
                            <h4 class="card-title">See all projects</h4>
                            <p class="project-tech">Full case studies + what's cooking</p>
                            <p>The dating-app idea, the robot-nav UI, and the ML project that started it all.</p>
                            <span class="card-cta">Browse all <span aria-hidden="true">→</span></span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- WORK -->
        <!-- The one inverted band on the site. `#work` is the substantive middle
             of the scroll, so making it a dark plate gives the page a centre of
             gravity and turns the light sections above and below into a
             deliberate frame rather than an unbroken sheet. All the colour
             inversion lives in `.band--dark` in styles.css (local custom-property
             overrides — no filters), so the content markup is untouched. -->
        <section id="work" class="band band--dark" aria-labelledby="work-title">
            <div class="band-inner" data-rail="03 / Work">
                <div class="section-head">
                    <h2 id="work-title" class="section-title reveal reveal-clip">Work</h2>
                    <p class="section-intro reveal">The professional stuff, if you're into that.</p>
                </div>

                <div class="section-body">
                    <h3 class="subhead subhead-flush reveal">What I Do</h3>
                    <div class="prose">
                        <p class="reveal">I'm an SDE II at Amazon Lab126. These days I work on the data pipeline for autonomous delivery robots — the C++ software that pulls terabytes of sensor data off the vehicles and into the cloud. Before that I owned the camera stack on Amazon's smart delivery glasses, which mostly meant making cameras crash a whole lot less.</p>
                    </div>

                    <h3 class="subhead reveal">Skills &amp; Tools</h3>
                    <ul class="skills-list reveal">
                        <li>C++ / Python</li>
                        <li>ROS2</li>
                        <li>Embedded Linux</li>
                        <li>Camera Systems / HAL</li>
                        <li>AWS (S3, IoT, KMS)</li>
                        <li>MQTT</li>
                        <li>RAID</li>
                        <li>SED / TCG</li>
                        <li>Edge Computing</li>
                        <li>PyTorch / Keras</li>
                        <li>Docker</li>
                    </ul>

                    <h3 class="subhead reveal">Experience</h3>
                    <div class="timeline">
                        <!-- Read-progress rail: scrubs from 0 to full as the
                             timeline scrolls past. Rests filled with motion off. -->
                        <span class="timeline-rail" aria-hidden="true"></span>
                        <article class="exp-item reveal">
                            <div class="exp-head">
                                <h4 class="exp-title">Software Development Engineer II</h4>
                                <span class="exp-date">February 2024 – Present</span>
                            </div>
                            <p class="exp-company">Amazon Lab126</p>
                            <p>Building the high-throughput data pipeline for autonomous delivery robots — a C++ edge appliance that ingests self-encrypting drives of vehicle sensor data into S3, moving 40+ Gbps across drives uploading in parallel. Owns the drive security lifecycle end to end: keyless cloud auth, encrypted-drive unlock, and audited crypto-erase.</p>
                            <p>Before this, was the SME for the camera stack on Amazon's smart delivery glasses — drove camera failure rates from 30.7% down to 0.5% and shipped hardware dewarp that cut CPU ~80%, across 244 devices and 270k+ deliveries.</p>
                        </article>

                        <article class="exp-item reveal">
                            <div class="exp-head">
                                <h4 class="exp-title">Software Development Engineer Intern</h4>
                                <span class="exp-date">June 2022 – September 2022</span>
                            </div>
                            <p class="exp-company">Amazon Lab126</p>
                            <p>Architected and trained 10+ two-branch convolutional neural networks on IMU sensor data, achieving 90% accuracy via device-collected data through Keras' functional API and scikit-learn.</p>
                            <p>Implemented 4 models onto the device to perform real-time classification in 1.5 seconds at 90% accuracy using ROS (rospy and roscpp) and an internal API that executes .tflite models in C++.</p>
                        </article>

                        <article class="exp-item reveal">
                            <div class="exp-head">
                                <h4 class="exp-title">ECE Department Tutor</h4>
                                <span class="exp-date">September 2020 – June 2023</span>
                            </div>
                            <p class="exp-company">UC San Diego, Jacobs School of Engineering</p>
                            <p>Tutored 800+ students with homework and exam preparation over 10 academic quarters across 2 different courses. Achieved 100% recommendation rate from student surveys.</p>
                        </article>
                    </div>

                    <p class="resume-line reveal"><a href="./25_Woo_Resume_Software.pdf" class="btn-resume" target="_blank" rel="noopener">Download Résumé <span aria-hidden="true">↗</span></a></p>
                </div>
            </div>
        </section>

        <!-- CONNECT -->
        <section id="connect" class="band band--shapes" aria-labelledby="connect-title">
            <!-- Signal / node-graph abstraction — "reach out" in line-art -->
            <svg class="shape-field shape-field--connect" viewBox="0 0 240 240" fill="none" aria-hidden="true">
                <g class="shape-drift">
                    <circle class="shape-ring" cx="120" cy="120" r="34" />
                    <circle class="shape-ring" cx="120" cy="120" r="66" />
                    <circle class="shape-ring" cx="120" cy="120" r="98" />
                    <path class="shape-line" d="M120 120 L 214 66" />
                    <path class="shape-line" d="M120 120 L 40 174" />
                    <path class="shape-line" d="M120 120 L 168 208" />
                    <circle class="shape-dot" cx="214" cy="66" r="5" />
                    <circle class="shape-dot shape-dot--soft" cx="40" cy="174" r="4.5" />
                    <circle class="shape-dot shape-dot--soft" cx="168" cy="208" r="4" />
                </g>
            </svg>
            <div class="band-inner" data-rail="04 / Connect">
                <div class="section-head">
                    <h2 id="connect-title" class="section-title reveal reveal-clip">Connect</h2>
                    <p class="section-intro reveal">Always happy to talk robotics, food, or whatever you're building. Don't be a stranger.</p>
                </div>

                <div class="section-body">
                    <div class="connect-split">
                        <div class="connect-col">
                            <h3 class="subhead subhead-flush reveal">Find Me Online</h3>
                            <div class="contact-links">
                                <a href="mailto:samuel.dw.woo@gmail.com" class="card contact-link reveal spotlight">
                                    <span class="link-label">Email</span>
                                    <span class="link-value">samuel.dw.woo@gmail.com</span>
                                </a>
                                <a href="https://linkedin.com/in/samueldwwoo" class="card contact-link reveal spotlight" target="_blank" rel="noopener">
                                    <span class="link-label">LinkedIn</span>
                                    <span class="link-value">samueldwwoo</span>
                                </a>
                                <a href="https://github.com/samueldwoo" class="card contact-link reveal spotlight" target="_blank" rel="noopener">
                                    <span class="link-label">GitHub</span>
                                    <span class="link-value">samueldwoo</span>
                                </a>
                            </div>
                        </div>

                        <div class="connect-col contact-form reveal">
                            <h3 class="subhead subhead-flush">Or Send a Message</h3>
                            <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
                                <div class="field">
                                    <label for="name">Name</label>
                                    <input type="text" id="name" name="name" placeholder="Your name" required>
                                </div>
                                <div class="field">
                                    <label for="email">Email</label>
                                    <input type="email" id="email" name="email" placeholder="Your email" required>
                                </div>
                                <div class="field">
                                    <label for="message">Message</label>
                                    <textarea id="message" name="message" placeholder="What's on your mind?" rows="5" required></textarea>
                                </div>
                                <button type="submit">Send</button>
                            </form>
                        </div>
                    </div>

                    <SiteFoot right="built" />
                </div>
            </div>
        </section>
    </main>
</Base>

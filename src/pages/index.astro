        {/* READING */}
        {/* A shelf seen edge-on, which is how a shelf actually looks: you read
             spines, not covers. Placed here so the scroll keeps its tonal
             alternation — hero (light) / interests (dark) / THIS (light) /
             projects (inset plate) / work (dark) / connect (light).

             It needs no nav edit. script.js harvests the section model from the
             page's own `.band` elements, so this band earns a rail tick, a
             drawer row, a palette result and a scroll-spy entry on its own; the
             topbar link row is the curated short list and deliberately stays
             five items. */}
        <section id="reading" class="band" aria-labelledby="reading-title">
            <div class="band-inner" data-rail="02 / Reading">
                <div class="section-head">
                    <h2 id="reading-title" class="section-title reveal reveal-clip">Reading</h2>
                    <p class="section-intro reveal">Mostly rereading the books I loved at twelve, plus whatever I have talked myself into this month. Each spine is as wide as the book is thick.</p>
                </div>

                <div class="section-body">
                    <figure class="shelf-figure reveal">
                        <ul class="shelf" aria-label={`Bookshelf, ${books.length} books`}>
                            {books.map((b) => (
                                <li
                                    class:list={['book', `book--${b.status}`, b.trim ? `book--${b.trim}` : null,
                                                 b.series ? `book--series-${b.series}` : null]}
                                    style={`--spine:${spineWidth(b)}px`}
                                >
                                    {/* The title is REAL vertical text, not an image and not a
                                        label on a decorative box: `writing-mode: vertical-rl`
                                        turns it on its side the way a printed spine is, and it
                                        stays selectable and readable by a screen reader in DOM
                                        order with no extra tab stop. */}
                                    <span class="book-spine" title={b.title}>
                                        <span class="book-title">{b.short ?? b.title}</span>
                                    </span>
                                    {/* Everything the spine cannot fit. A 26px-wide spine has
                                        room for a short title and nothing else, so the author,
                                        the reading state and the page count live here — real
                                        text in the a11y tree, no extra tab stop. The full title
                                        is repeated when the spine shows an abbreviation. */}
                                    <span class="visually-hidden">
                                        {b.short ? `${b.title}. ` : ''}{b.author}
                                        {' — '}{STATUS_WORD[b.status]}
                                        {b.pagesKnown === false ? '' : `, ${b.pages} pages`}.
                                    </span>
                                </li>
                            ))}
                        </ul>

                        <figcaption class="shelf-caption">
                            <span class="shelf-series" aria-hidden="true">Ranger's Apprentice 1–{seriesCount}</span>
                            <span class="shelf-stats">
                                {books.length} books · {readingNow} on the go · ~{shelfPages.toLocaleString('en-US')} pages of shelf
                            </span>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </section>

        {/* PROJECTS */}
        {/* The one INSET band on the page: `band--plate` gives the section
             its own margins, hairline and rounded corners so it reads as a
             sheet laid on the page rather than another full-bleed slab. It

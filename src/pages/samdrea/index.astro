---
/**
 * /samdrea — the front door. Act I.
 *
 * ---------------------------------------------------------------------------
 * WHAT THIS PAGE IS
 *
 * A deliberately crude "access terminal" that asks her three questions about me
 * and, when she gets them, tears itself down and hands her the studio. The bad
 * design is the joke and the payoff is the cut.
 *
 * WHAT IT IS NOT is a security boundary. Nothing on this page decides anything:
 * the prompts are public, the answers are checked only by /api/us/gate against
 * keyed digests, and the session cookie is set by that endpoint. Reading this
 * file's source tells you the questions and nothing else — which is the design.
 *
 * It deliberately loads NONE of the portfolio's stylesheets or vendored motion
 * libraries. Different world, no shared cascade, and no 400KB of GSAP to render
 * a page whose entire aesthetic is "Times New Roman".
 * ---------------------------------------------------------------------------
 */
import { publicQuestions, isConfigured, missingConfig, gateNeedsReview } from '../../lib/us/config';
import { SESSION_SECRET } from '../../lib/us/config';
import { readCookie, verify } from '../../lib/us/session';

export const prerender = false;

// Already through? Skip the bit entirely. Nobody wants the gag twice.
const secret = SESSION_SECRET();
const already = secret ? verify(secret, 'session', readCookie(Astro.cookies, 'session', Astro.url)) : null;

/**
 * `next` comes off the query string, which means it is attacker-controlled, so
 * it is only honoured when it is a path inside this wing. Anything else — a full
 * URL, a protocol-relative `//evil.com`, an unrelated absolute path — is
 * discarded. Otherwise this is an open redirect wearing my domain's reputation.
 */
/**
 * Where a signed-in visitor is sent when `?next=` is present.
 *
 * AN ALLOWLIST OF REAL ROUTES, not a prefix test, and the difference was an
 * INFINITE REDIRECT LOOP.
 *
 * The old rule asked "is this path inside the wing". That is the right question
 * for an open redirect and the wrong one for a destination, because a path can be
 * inside the wing and not exist:
 *
 *   1. middleware.ts guards everything under /samdrea/vault, finds no route for
 *      /samdrea/vault/nope, and 302s to the gate with ?next=/samdrea/vault/nope
 *   2. the gate, holding a valid session, 302s straight back to that `next`
 *   3. go to 1
 *
 * Verified before this fix: curl gave up at 25 hops, exit code 47. It only
 * happens SIGNED IN — signed out the gate simply renders — which means it only
 * happens in the INSTALLED APP, where there is no URL bar and no reload button,
 * so iOS shows "too many redirects" in a window she cannot leave without
 * force-quitting from the app switcher.
 *
 * An allowlist cannot loop, because every entry is a route that renders. It is
 * also a strictly tighter answer to the open-redirect question the prefix test
 * existed for, so nothing is given up. `/samdrea` is deliberately ABSENT:
 * sending the gate back to the gate is the same loop with one fewer hop.
 */
const NEXT_ALLOWED = new Set([
  '/samdrea/vault',
  '/samdrea/vault/today',
  '/samdrea/vault/room',
  '/samdrea/vault/letters',
  '/samdrea/vault/day',
  '/samdrea/dj',
]);

const rawNext = (Astro.url.searchParams.get('next') ?? '').replace(/\/+$/, '');
const safeNext = NEXT_ALLOWED.has(rawNext) ? rawNext : '/samdrea/vault';

if (already) return Astro.redirect(safeNext, 302);

const questions = publicQuestions();
const ready = isConfigured();
// Only ever rendered by `astro dev`. In production a misconfigured gate is a
// blank wall, not a checklist of which secret I forgot to paste.
const missing = import.meta.env.DEV ? missingConfig() : [];

/**
 * Unreviewed-answers warning, shown in DEV ONLY.
 *
 * Called unconditionally on purpose — it also emits the console.error that lands
 * in Vercel's production logs, the only channel that reaches me once deployed.
 * But the BANNER is dev-gated, because telling an unauthenticated visitor "the
 * answers to these questions are probably guessable" would be helpfully
 * completing the attack for them.
 */
const showPlaceholderWarning = import.meta.env.DEV && gateNeedsReview();
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- viewport-fit=cover is REQUIRED for env(safe-area-inset-*) to be
         anything but 0. The pages set apple-mobile-web-app-status-bar-style
         to black-translucent, so iOS draws content UNDER the notch and the
         home indicator; without this attribute there is no opt-out AND no
         way to pad around it, so the studio's "exit" link sat behind the
         battery icon. The insets are applied in us.css and us-studio.css. -->
    <meta name="color-scheme" content="light">
    <!-- Belt and braces: the middleware also sends X-Robots-Tag, which covers
         the redirects and JSON responses that cannot carry a meta tag. -->
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>private</title>
    <!-- Absolute path: this page is at /samdrea, so "css/us.css" would
         resolve to /samdrea/css/us.css and 404. -->
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/assets/us/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="[us]">
    <meta name="theme-color" content="#000000">
    <link rel="stylesheet" href="/css/us.css">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23000'/%3E%3Ctext x='16' y='23' font-family='monospace' font-size='20' font-weight='700' text-anchor='middle' fill='%233e7bff'%3E%5B%5D%3C/text%3E%3C/svg%3E">
</head>
<body class="crude" id="crude">
{/* ============================================================
    NOTHING BUT THE QUESTION.

    This page used to carry a name, a subtitle, three horizontal
    rules, two paragraphs explaining what a private page is, a
    three-row "verification status" table listing every question
    with ASKING / LOCKED beside it, a "Question 1 of 3" counter,
    a "Your answer" label and a footer.

    All of it is gone. Every one of those was a website EXPLAINING
    ITSELF, and the joke only works if the page seems not to know
    it is a page. A status table is a design decision; a question
    alone on a white screen is a person who does not make
    websites. The second one is funny, so the second one is what
    this is.

    WHAT SURVIVES, AND ONLY BECAUSE IT HAS TO:
      the question            — the entire content
      the input and a button  — the entire mechanism
      #q-msg                  — WRONG. / HINT: ; she has to be
                                told, and it is hidden until then
      #q-giveup               — the mailto, hidden until 3 misses,
                                so she is never actually stuck
      <noscript>              — invisible unless JS is off, and
                                without it the page is inert with
                                no explanation at all

    The input keeps its name via aria-label rather than a <label>,
    so it is still announced to a screen reader while showing
    nothing on screen. Deleting the label outright would have
    traded the joke for an unlabelled field.

    #status-body, #q-count and #q-n are GONE, and the script was
    made safe for their absence rather than left to throw on a
    null: setStatus() already returned early when its cell was
    missing, and the q-n write is now guarded the same way.
    ============================================================ */}
<div class="crude-wrap" id="crude-wrap" data-spot="0">

    {/* Only when she has been sent back here by an expired session. Arriving at
        a bare question with no explanation is fine; being BOUNCED to one is not. */}
    {Astro.url.searchParams.get('e') === 'unauthorized' && (
        <p>you got signed out. answer them again.</p>
    )}

    {/* Dev only, and one line. It used to be a paragraph with two npm commands
        and an env var in it, which is a lot of screen for a note to myself. */}
    {showPlaceholderWarning && (
        <p class="crude-noscript">dev &mdash; gate answers not confirmed private.</p>
    )}

    <noscript>
        <p class="crude-noscript">
            THIS TERMINAL REQUIRES JAVASCRIPT. Please enable it and reload.
            (Sorry. I know. Very 1999 of me.)
        </p>
    </noscript>

    <div id="quiz" data-total={questions.length}>
        <p class="crude-q" id="q-prompt">{questions[0]?.prompt ?? '(no questions configured)'}</p>

        <!-- A real <form>: Enter-to-submit, and the on-screen keyboard shows a Go
             key. The script intercepts submit; it does not replace the semantics. -->
        <form class="crude-form" id="q-form" autocomplete="off" novalidate>
            <input
                class="crude-input"
                id="q-input"
                name="answer"
                type="text"
                inputmode="text"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                placeholder={questions[0]?.placeholder ?? ''}
                aria-label="Your answer"
                aria-describedby="q-msg"
                required
                disabled={!ready}
            >
            <button class="crude-submit" id="q-submit" type="submit" disabled={!ready}>SUBMIT</button>
        </form>

        <!-- aria-live so a screen reader hears the verdict without focus moving. -->
        <p class="crude-msg" id="q-msg" role="status" aria-live="polite" hidden></p>

        <p id="q-giveup" hidden>
            <a href="mailto:samuel.dw.woo@gmail.com?subject=your%20stupid%20website%20won't%20let%20me%20in&body=it%20says%20i%20am%20not%20on%20the%20list.%20i%20am%20definitely%20on%20the%20list.">
                email the administrator
            </a>
        </p>
    </div>

    {/* SHE IS BEING SENT A LINK to a page with no branding, one question and a
        submit button — which is, structurally, what a phishing page looks like.
        One line fixes that, and it does the job better by also explaining why the
        page looks like this, so it reassures and lands the joke at once.

        Outside #quiz on purpose: the box moves, this does not. It is a fixed fact
        about the page rather than part of the question. */}
    <p class="crude-sig">
        it&rsquo;s sam. <a href="https://www.samueldwoo.com">samueldwoo.com</a>. i know how this looks.
    </p>
</div>

<script is:inline define:vars={{ questions, ready }}>
/* --------------------------------------------------------------------------
   Act I client script. Inline and un-bundled on purpose: it is ~70 lines and
   loading a module graph to run it would be the only modern thing about this
   page.

   It holds NO answers and makes NO decisions. Every submit goes to
   /api/us/gate, and the server's reply is the only source of truth for what
   happens next — including which question comes next, which is why `next`
   is read off the response rather than tracked by incrementing a counter here.
   -------------------------------------------------------------------------- */
(function () {
    if (!ready) return;

    var form = document.getElementById('q-form');
    var input = document.getElementById('q-input');
    var submit = document.getElementById('q-submit');
    var msg = document.getElementById('q-msg');
    var prompt = document.getElementById('q-prompt');
    var qn = document.getElementById('q-n');
    var giveUp = document.getElementById('q-giveup');
    var step = 0;

    function say(kind, text) {
        // The prefix means the message never relies on colour to be understood.
        var prefix = kind === 'bad' ? 'WRONG. ' : kind === 'hint' ? 'HINT: ' : 'OK. ';
        msg.dataset.kind = kind;
        msg.hidden = false;
        msg.textContent = prefix + text;
    }

    function setStatus(i, label, cls) {
        var cell = document.querySelector('[data-status="' + i + '"]');
        if (!cell) return;
        cell.textContent = label;
        cell.className = cls;
    }

    /* THE BOX MOVES ON EVERY ANSWER.

       Derived from the step index, not Math.random(): the same question always
       lands in the same place, so it is reproducible and it can never twice in a
       row put the input somewhere awkward. Random would eventually drop it under
       her thumb or half off the screen, and that is where whimsy turns into a bug.

       Question 1 stays at spot 0, which is centred — the first impression has to
       look deliberate. The CSS owns where each spot actually is, and clamps the
       range hard on a phone; this only says WHICH one. */
    var SPOTS = 4;
    function moveBox(i) {
        var wrap = document.getElementById('crude-wrap');
        if (!wrap) return;
        wrap.dataset.spot = String(i % SPOTS);
    }

    function goTo(i) {
        step = i;
        moveBox(i);
        prompt.textContent = questions[i].prompt;
        input.placeholder = questions[i].placeholder || '';
        input.value = '';
        /* #q-n was the "Question 1 of 3" counter and is gone with the rest of
           the chrome. Guarded rather than removed, so the script still works if
           a counter is ever put back. setStatus() already guards the same way. */
        if (qn) qn.textContent = String(i + 1);
        giveUp.hidden = true;
        for (var j = 0; j < questions.length; j++) {
            if (j === i) setStatus(j, 'ASKING', 'is-now');
        }
        input.focus();
    }

    form.addEventListener('submit', async function (event) {
        event.preventDefault();
        var answer = input.value.trim();
        if (!answer) { say('bad', 'type something.'); input.focus(); return; }

        submit.disabled = true;
        submit.textContent = 'CHECKING';

        var data;
        try {
            var res = await fetch('/api/us/gate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                // Cookies carry the signed progress token, so the request must
                // be credentialed. Same-origin is the default, but being
                // explicit here documents that the token is load-bearing.
                credentials: 'same-origin',
                body: JSON.stringify({ step: step, answer: answer })
            });
            data = await res.json();

            if (res.status === 429) {
                say('bad', 'too many tries. wait ' + (data.retryAfter || 60) + ' seconds.');
                return;
            }
            if (res.status === 503) {
                say('bad', 'the terminal is offline. not your fault.');
                return;
            }
        } catch (err) {
            say('bad', 'the server did not answer. try again.');
            return;
        } finally {
            submit.disabled = false;
            submit.textContent = 'SUBMIT';
        }

        if (!data || data.ok !== true) {
            say(data && data.hint ? 'hint' : 'bad', (data && data.hint) || 'not that.');
            if (data && data.giveUp) giveUp.hidden = false;
            input.select();
            return;
        }

        setStatus(step, 'VERIFIED', 'is-done');

        if (data.done) {
            say('good', 'you are on the list.');
            input.disabled = true;
            submit.disabled = true;
            document.getElementById('crude').classList.add('is-opening');
            var to = data.redirect || '/samdrea/vault';
            // Long enough to read the line and see the lights go out.
            setTimeout(function () { window.location.assign(to); }, 700);
            return;
        }

        msg.hidden = true;
        goTo(typeof data.next === 'number' ? data.next : step + 1);
    });

    input.focus();
})();
</script>
</body>
</html>

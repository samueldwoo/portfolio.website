---
/**
 * /samdrea/dj — my side. Paste a link, write a note, post it.
 *
 * ---------------------------------------------------------------------------
 * THIS PAGE GUARDS ITSELF, AND THAT IS THE WHOLE DESIGN
 *
 * src/middleware.ts deliberately does NOT list this path as needing the admin
 * token, and the comment there explains why: this is the admin LOGIN page, and a
 * login page guarded by the credential it exists to collect is a locked door with
 * the key inside. So the guard lives here instead, as a single branch:
 *
 *   no valid `admin` cookie  ->  render ONLY a passcode form. Nothing else.
 *   valid `admin` cookie     ->  render the posting UI.
 *
 * That is safe because this page holds no secrets of its own. The passcode is
 * verified by /api/us/admin against a keyed digest, and /api/us/song's POST
 * independently demands the admin token before it writes anything. The worst case
 * for a bug in the branch below is that a stranger sees an empty passcode box.
 *
 * ---------------------------------------------------------------------------
 * IT IS BUILT FOR ONE DEVICE: A PHONE, IN THE MORNING, ONE-HANDED
 *
 * Everything follows from that. Two visible fields in the common case. A real
 * <form method="post"> that works with JavaScript switched off, because the
 * offline-ish moment on a train is exactly when I will want to post. Inputs at
 * 16px so iOS does not zoom the viewport on focus. Targets past 44px. The
 * enhancement script exists for one reason that actually matters: if the post
 * fails, a native form submit has already navigated away and taken the note I
 * just typed with it, and retyping a paragraph on a phone is the difference
 * between doing this every day and not.
 * ---------------------------------------------------------------------------
 */
import { ADMIN_PASSCODE_DIGEST, ANSWER_PEPPER, SESSION_SECRET } from '../../lib/us/config';
import { readCookie, verify } from '../../lib/us/session';
import {
  REACTIONS,
  durationLabel,
  emptyPair,
  getExchange,
  getReactions,
  getReply,
  getSong,
  isWingDate,
  pairFrom,
  storeTier,
  summarize,
  wingDate,
  wingDateLabel,
  type DayPair,
  type Rhythm,
  type Side,
  type TrackRecord,
} from '../../lib/us/kv';

export const prerender = false;

const secret = SESSION_SECRET();
const admin = secret ? verify(secret, 'admin', readCookie(Astro.cookies, 'admin', Astro.url)) : null;

/**
 * Whether an admin login can even be evaluated. Checked here as well as in the
 * endpoint so the page can say "not configured" instead of rendering a form that
 * is guaranteed to reject a correct passcode.
 */
const configured = Boolean(secret && ANSWER_PEPPER() && ADMIN_PASSCODE_DIGEST());

/* Query-string state, set by the 303 redirects in /api/us/admin and
   /api/us/song. These are the no-JavaScript path's only way to report an
   outcome, so every code an endpoint can emit needs a sentence here. An
   unrecognised code still produces a message rather than an empty banner. */
const errorCode = Astro.url.searchParams.get('e') ?? '';
const postedDate = Astro.url.searchParams.get('posted') ?? '';
const retryAfter = Astro.url.searchParams.get('s') ?? '';

const ERRORS: Record<string, string> = {
  'bad-passcode': 'no. that passcode is not it.',
  rate: `too many tries. wait ${retryAfter || '600'} seconds.`,
  unconfigured: 'this is not configured on the server yet. missing env vars.',
  unauthorized: 'your admin session expired. passcode again.',
  'bad-request': 'the server could not read that submission.',
  'bad-url': 'that is not a spotify TRACK link. copy the link from the song itself.',
  'bad-date': 'that date is not a real date.',
  'future-date': 'that date is in the future. she would never see it.',
  store: 'the store refused the write. NOTHING WAS SAVED.',
};
const errorText = errorCode ? (ERRORS[errorCode] ?? 'something went wrong.') : '';

const today = wingDate();
const tier = storeTier();

/**
 * The day this page is looking at.
 *
 * `postedDate` arrives in a query string, so it is validated before it is used as a
 * store key AND before it is printed. Neither was ever dangerous — getSong()
 * rejects a non-date and Astro escapes on render — but this comment used to claim
 * both and only did the first: wingDateLabel() returns a non-date verbatim, so
 * `?posted=<script>…` landed, escaped and inert, inside a green "saved —
 * posted for …" banner. An adversarial review caught the gap between the claim and
 * the code. A confirmation is the last place a page should repeat text it was
 * handed, so an invalid value now produces no banner at all — which is also the
 * honest answer, because we cannot confirm a day that is not a day.
 */
const confirmedDate = isWingDate(postedDate) ? postedDate : '';
const wantDate = confirmedDate || today;

/** How far back the numbers count. Same window, same reasoning, as her page. */
const HISTORY_WINDOW = 365;

/**
 * THE WHOLE DAY I AM LOOKING AT — both halves, as one pair.
 *
 * Read from the store rather than echoed back from the redirect, so the preview is
 * the actual persisted record. A preview built from the form I just submitted
 * would happily show me a song that never saved, which is the one thing this page
 * exists to rule out.
 *
 * FOUR READS IN PARALLEL, AND THE EXACT-DATE ONES ARE SEPARATE ON PURPOSE.
 * getExchange() returns the newest N days, which is the right window for counting
 * but the wrong lookup for a confirmation: if I backfill a day older than that
 * window, it would not be in the list and this page would tell me "nothing yet"
 * about a song that saved perfectly. Being wrong in that direction is the single
 * failure this page exists to prevent, so the previewed day is fetched by key as
 * well. Promise.all means it costs one round trip, not four.
 *
 * pairFrom() rather than assembling the day here: her page folds days with
 * buildPairs(), and a second fold on this page is how a preview starts disagreeing
 * with the thing it previews.
 */
let pair: DayPair = emptyPair(wantDate);
let rhythm: Rhythm | null = null;
let storeUnreachable = false;
if (admin) {
  try {
    const [exchange, song, reply, reactions] = await Promise.all([
      getExchange(HISTORY_WINDOW),
      getSong(wantDate),
      getReply(wantDate),
      getReactions([wantDate]),
    ]);
    pair = pairFrom(wantDate, song, reply, reactions[wantDate] ?? []);
    rhythm = summarize({ today, pairs: exchange.pairs });
  } catch (err) {
    console.error('[us] dj page could not read the store:', err);
    storeUnreachable = true;
  }
}

/** Which of her reactions landed on the previewed day, as emoji + words. */
const chosenReactions = REACTIONS.filter((r) => pair.reactions.includes(r.key));

/**
 * Album, year, length — whichever of them we actually know.
 *
 * Empty array when nothing is known, because these three only exist when the
 * Spotify Web API credentials do. Same function, same contract, as her page: the
 * correct rendering of "unknown" is no line, never a placeholder.
 */
function metaBits(track: TrackRecord): string[] {
  return [track.album ?? '', track.year ?? '', durationLabel(track.durationMs)].filter(Boolean);
}

/* ============================================================================
   THE TWO SLOTS, FROM MY SIDE

   Same array, same one-loop card template, same rules as her page — the only
   differences are the WORDS ("me" / "her" rather than "me" / "you") and what an
   empty slot says. That is deliberate to the point of being the design: if this
   page assembled its own preview markup, the confirmation surface would slowly
   stop resembling the page it is confirming, and I would be checking a rendering
   nobody else ever sees.
   ========================================================================= */

interface Slot {
  side: Side;
  who: string;
  track: TrackRecord | null;
  open: string;
  openSub: string;
  unnamed: string;
}

const slots: Slot[] = [
  {
    side: 'his',
    who: 'me',
    track: pair.his,
    open: storeUnreachable ? 'Unknown.' : 'Nothing filed for this day.',
    openSub: storeUnreachable
      ? 'The store did not answer, so this is not evidence of anything.'
      : 'Her page says so honestly rather than showing yesterday. The form above files one.',
    unnamed: '(Spotify gave us no title — the embeds will still name it)',
  },
  {
    side: 'hers',
    who: 'her',
    track: pair.hers,
    open: storeUnreachable ? 'Unknown.' : 'Nothing from her on this day.',
    // NOT a nudge, and not a complaint. There is no action for me here, and any
    // wording that implied one would be inventing an obligation she never took on.
    openSub: storeUnreachable
      ? 'The store did not answer, so this is not evidence of anything.'
      : 'Which is a fine way for a day to be.',
    unnamed: '(Spotify gave us no title — the embed will still name it)',
  },
];

/**
 * The state of the habit, as one sentence.
 *
 * A sentence rather than her page's stat grid, because this page is a form and a
 * dashboard above a form is a dashboard I would stop reading.
 *
 * THE STREAK IS THE SHARED ONE, and that changed what this sentence is allowed to
 * promise. The old version said "post one and it is N+1", which was true when the
 * streak counted only my mornings. It counts days we BOTH posted now, so posting
 * cannot extend it on my own — and a nudge that quietly implies otherwise is a
 * nudge that will be wrong most mornings. What is left is honest: my half is half.
 *
 * Empty string on day one, and the page renders nothing rather than a row of
 * zeroes.
 */
function rhythmLine(r: Rhythm | null): string {
  if (!r || r.days === 0) return '';

  const parts: string[] = [];
  if (r.streak > 1) {
    parts.push(
      r.streakLive
        ? `${r.streak} days in a row with both of us on them.`
        : `${r.streak} in a row through yesterday — mine is half of keeping it.`,
    );
  }

  parts.push(r.days === 1 ? 'One day altogether.' : `${r.days} days altogether.`);

  if (r.both === 0) parts.push('None yet with both of us on it.');
  else if (r.both === r.days) parts.push('Both of us on every one.');
  else parts.push(`Both of us on ${r.both}.`);

  // Stated in one clause with one shape, so neither number reads as the score to
  // beat. They are two counts of the same habit, not a league table.
  parts.push(`Mine ${r.his}, hers ${r.hers}.`);

  if (r.reacted > 0) {
    parts.push(r.reacted === 1 ? 'One day she reacted.' : `${r.reacted} days she reacted.`);
  }
  if (r.best > r.streak) parts.push(`Best shared run: ${r.best}.`);

  return parts.join(' ');
}

const habit = rhythmLine(rhythm);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- viewport-fit=cover is REQUIRED for env(safe-area-inset-*) to be
         anything but 0. The pages set apple-mobile-web-app-status-bar-style
         to black-translucent, so iOS draws content UNDER the notch and the
         home indicator; without this attribute there is no opt-out AND no
         way to pad around it, so the studio's "exit" link sat behind the
         battery icon. The insets are applied in us.css and us-studio.css. -->
    <meta name="color-scheme" content="dark">
    <!-- Belt and braces: the middleware also sends X-Robots-Tag, which covers
         the redirects and JSON responses that cannot carry a meta tag. -->
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>dj</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Absolute paths: this page is at /samdrea/dj, so "css/us.css" would
         resolve to /samdrea/css/us.css and 404. us.css first — it owns every
         token us-song.css then uses. -->
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/assets/us/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="[us]">
    <meta name="theme-color" content="#000000">
    <link rel="stylesheet" href="/css/us.css">
    <link rel="stylesheet" href="/css/us-song.css">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23000'/%3E%3Ctext x='16' y='23' font-family='monospace' font-size='20' font-weight='700' text-anchor='middle' fill='%233e7bff'%3E%5B%5D%3C/text%3E%3C/svg%3E">
</head>
<body class="studio">
<div class="studio-wrap dj-wrap">

    <p class="studio-kicker">line 01 &middot; the booth</p>

    <h1 class="us-mark">
        <span class="us-mark-bracket" aria-hidden="true">[</span>dj<span
              class="us-mark-bracket" aria-hidden="true">]</span>
    </h1>

    {/* role="status" so the outcome of a no-JavaScript form POST is announced
        when the page loads, not just seen. Every notice carries a word as well
        as a colour. */}
    {errorText && (
        <p class="notice" data-kind="bad" role="status">no &mdash; {errorText}</p>
    )}

    {confirmedDate && !errorText && (
        <p class="notice" data-kind="ok" role="status">
            saved &mdash; posted for {wingDateLabel(confirmedDate, { withYear: true })}.
        </p>
    )}

    {/* Not a dev-only diagnostic. A non-durable store is a fact about whether
        the thing I just posted still exists tomorrow, and I want to be told. */}
    {admin && tier === 'memory' && (
        <p class="notice" data-kind="warn">
            heads up &mdash; the store is IN-PROCESS MEMORY. Nothing posted here
            survives a server restart, and a second serverless instance cannot see
            it. Set the <code>R2_*</code> variables (or Upstash) before this counts.
        </p>
    )}

    {admin && storeUnreachable && (
        <p class="notice" data-kind="bad" role="status">
            no &mdash; could not read the store, so the preview below is missing.
            Posting may also fail.
        </p>
    )}

    {!configured && (
        <p class="notice" data-kind="bad">
            no &mdash; not configured. Run <code>npm run gate:hash</code> and give it
            an admin passcode, then restart the dev server.
        </p>
    )}

    {!admin ? (
        /* ---------------------------------------------------------------
           LOCKED. One field, and nothing else on the page — no preview, no
           archive, no hint about what is behind it. There is no JavaScript in
           this branch at all: a native form POST to /api/us/admin gets a 303
           back here with the cookie set, which is fewer moving parts than any
           fetch and works on a phone with a dead connection to everything
           except my own origin.
           --------------------------------------------------------------- */
        <>
            <p class="studio-lede">
                Booth's locked. Passcode.
            </p>

            <form class="dj-form dj-lock" method="post" action="/api/us/admin">
                <div class="dj-field">
                    <label class="dj-label" for="passcode">Admin passcode</label>
                    <input
                        class="dj-input"
                        id="passcode"
                        name="passcode"
                        type="password"
                        autocomplete="current-password"
                        autocapitalize="none"
                        autocorrect="off"
                        spellcheck="false"
                        required
                        disabled={!configured}
                    >
                    <p class="dj-hint">
                        Compared exactly as typed &mdash; case and punctuation count.
                    </p>
                </div>
                <button class="dj-submit" type="submit" disabled={!configured}>unlock</button>
            </form>
        </>
    ) : (
        /* ---------------------------------------------------------------
           UNLOCKED. The posting form, then a preview of what is actually in
           the store for the day being looked at.
           --------------------------------------------------------------- */
        <>
            <p class="studio-lede">
                What could you not stop playing this morning?
            </p>

            {/* Counted from stored records by summarize() in kv.ts — the same
                function her page uses, so the two can never quote different
                streaks at us. Absent on day one rather than showing zeroes. */}
            {habit && <p class="dj-rhythm">{habit}</p>}

            <hr class="studio-rule">

            <form class="dj-form" id="post-form" method="post" action="/api/us/song">
                <div class="dj-field">
                    <label class="dj-label" for="url">Spotify link</label>
                    {/* type="text" with inputmode="url", NOT type="url": the
                        native URL validator rejects `spotify:track:...`, which
                        the endpoint accepts, so type="url" would block a valid
                        paste before it ever reached the server. */}
                    <input
                        class="dj-input"
                        id="url"
                        name="url"
                        type="text"
                        inputmode="url"
                        autocomplete="off"
                        autocapitalize="none"
                        autocorrect="off"
                        spellcheck="false"
                        placeholder="open.spotify.com/track/..."
                        aria-describedby="url-hint"
                        required
                    >
                    <p class="dj-hint" id="url-hint">
                        Share &rarr; Copy link, from the SONG. Album and playlist links
                        are rejected.
                    </p>
                </div>

                <div class="dj-field">
                    <label class="dj-label" for="note">
                        The note <span class="dj-opt">&mdash; the actual point</span>
                    </label>
                    <textarea
                        class="dj-textarea"
                        id="note"
                        name="note"
                        rows="5"
                        maxlength="600"
                        placeholder="why this one, today."
                    ></textarea>
                </div>

                <div class="dj-field">
                    <label class="dj-label" for="artist">
                        Artist <span class="dj-opt">&mdash; optional</span>
                    </label>
                    <input
                        class="dj-input"
                        id="artist"
                        name="artist"
                        type="text"
                        maxlength="120"
                        autocapitalize="words"
                        aria-describedby="artist-hint"
                    >
                    <p class="dj-hint" id="artist-hint">
                        Spotify's credential-free metadata endpoint returns the title and
                        the art but not the artist. Leave it blank and her card just omits
                        the line.
                    </p>
                </div>

                <div class="dj-field">
                    <label class="dj-label" for="date">
                        Day <span class="dj-opt">&mdash; optional, for backfilling</span>
                    </label>
                    <input
                        class="dj-input"
                        id="date"
                        name="date"
                        type="date"
                        max={today}
                        aria-describedby="date-hint"
                    >
                    <p class="dj-hint" id="date-hint">
                        Blank means today ({wingDateLabel(today)}). The future is rejected
                        &mdash; she would never see it.
                    </p>
                </div>

                <button class="dj-submit" id="post-submit" type="submit">post it</button>

                {/* The enhancement script's channel. Empty and aria-live, so a
                    result is announced without moving focus. hidden until there
                    is something to say. */}
                <p class="notice" id="post-status" role="status" aria-live="polite" hidden></p>
            </form>

            <hr class="studio-rule">

            <p class="song-eyebrow">
                the day so far &mdash; {wingDateLabel(pair.date, { withYear: true })}
            </p>

            {/* ==============================================================
                THE PAIR, FROM MY SIDE

                THE HALF THAT USED TO BE MISSING IS HER HALF, AND IT IS NOT A
                SECTION ANY MORE — IT IS A SLOT. Her reactions and her songs
                have always been written to the store, but reading them needs
                her page, which needs a SESSION token that this admin cookie
                deliberately is not. So the round trip the whole feature is
                built around ("so I can see she listened") used to be
                write-only from where I stand, and the first fix for that was a
                "what came back" block bolted under my card.

                That block was the asymmetry in miniature: my song was a card,
                her song was an appendix. Both halves now render from the same
                loop and the same template her page uses — so a change to the
                card cannot make my preview lie, and cannot quietly promote one
                of us again.

                BOTH CARDS GET A PLAYER, including mine, which I do not need.
                One template rendered twice is worth more than saving myself an
                iframe: the moment this page special-cases a side, it stops
                being a preview of hers.
                ============================================================== */}
            <section class="pair" aria-label={`both sides of ${wingDateLabel(pair.date, { withYear: true })}`}>
                {slots.map((slot) => (
                    <article
                        class={`song song--${slot.side}`}
                        aria-labelledby={`who-${slot.side}`}
                        data-open={slot.track ? undefined : 'true'}
                    >
                        <h2 class="song-side" id={`who-${slot.side}`}>{slot.who}</h2>

                        {slot.track ? (
                            <>
                                <div class="song-head">
                                    <span class="song-frame">
                                        {slot.track.art ? (
                                            <img
                                                class="song-art"
                                                src={slot.track.art}
                                                alt=""
                                                width="320"
                                                height="320"
                                                loading="lazy"
                                                decoding="async"
                                                referrerpolicy="no-referrer"
                                            >
                                        ) : (
                                            <span class="song-art--empty" aria-hidden="true">[ ]</span>
                                        )}
                                    </span>

                                    <div class="song-body">
                                        <p class="song-day">
                                            {wingDateLabel(slot.track.date, { withYear: true })}
                                        </p>

                                        {slot.track.title ? (
                                            <h3 class="song-title">{slot.track.title}</h3>
                                        ) : (
                                            <h3 class="song-title song-title--unknown">{slot.unnamed}</h3>
                                        )}

                                        {slot.track.artist && <p class="song-artist">{slot.track.artist}</p>}

                                        {/* Album, year, length. Present only when
                                            the Spotify Web API credentials are
                                            configured — the whole pre-credential
                                            archive has none of these and renders no
                                            line at all, which is also how I can tell
                                            at a glance whether the enrichment is
                                            actually working. */}
                                        {metaBits(slot.track).length > 0 && (
                                            <ul class="song-meta">
                                                {metaBits(slot.track).map((bit) => <li>{bit}</li>)}
                                            </ul>
                                        )}
                                    </div>
                                </div>

                                {slot.track.note ? (
                                    <p class="song-note">{slot.track.note}</p>
                                ) : (
                                    <p class="song-note song-note--empty">No note. Just the song.</p>
                                )}

                                {/* The id has been through /^[A-Za-z0-9]{22}$/
                                    twice — once in extractTrackId when it was
                                    pasted, once in parseTrack when it was read
                                    back out of the store — before it reaches this
                                    src, which is the only reason interpolating it
                                    here is safe. No autoplay: two embeds that
                                    could start on their own is a page that
                                    ambushes you. */}
                                <div class="song-player">
                                    <iframe
                                        src={`https://open.spotify.com/embed/track/${slot.track.id}`}
                                        title={slot.track.title
                                            ? `Spotify player: ${slot.track.title}`
                                            : 'Spotify player'}
                                        width="100%"
                                        height="152"
                                        loading="lazy"
                                        allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture"
                                        referrerpolicy="no-referrer"
                                    ></iframe>
                                </div>

                                <p class="song-links">
                                    <a
                                        href={`https://open.spotify.com/track/${slot.track.id}`}
                                        target="_blank"
                                        rel="noreferrer noopener"
                                    >open in spotify &nearr;</a>
                                </p>
                            </>
                        ) : (
                            <p class="song-open">
                                {slot.open}
                                <span class="song-open-sub">{slot.openSub}</span>
                            </p>
                        )}

                        {/* WHAT SHE SAID, on the song she said it about.

                            It hangs off MY card because that is whose track it
                            answers: /api/us/react takes her session and refuses
                            this admin cookie, so a reaction from me does not
                            exist and her card correctly has no equivalent. That
                            is the one thing in the feature still going one way,
                            and it is stated rather than papered over — see the
                            header of /api/us/react for what making it mutual
                            would actually take. */}
                        {slot.side === 'his' && slot.track && (
                            <div>
                                <p class="song-eyebrow">what she said</p>
                                {chosenReactions.length > 0 ? (
                                    <ul class="said">
                                        {chosenReactions.map((r) => (
                                            <li>
                                                {/* The emoji is decorative and the
                                                    words are the content — the same
                                                    pairing rule as her page's
                                                    buttons, so this is never a glyph
                                                    a screen reader has to guess at. */}
                                                <span aria-hidden="true">{r.emoji}</span>
                                                <span class="said-label">{r.label}</span>
                                            </li>
                                        ))}
                                    </ul>
                                ) : (
                                    <p class="said-quiet">
                                        {storeUnreachable
                                            ? 'Unknown — the store did not answer.'
                                            : 'Nothing tapped on this one.'}
                                    </p>
                                )}
                            </div>
                        )}
                    </article>
                ))}
            </section>

            <div class="dj-foot">
                {/* NO LONGER "needs the gate too", and the label used to say so.
                    Every page in the wing self-guards on `session` specifically —
                    deliberately, so a routing mistake degrades to "empty page"
                    rather than "everything is public". The side effect was that
                    this admin token alone was redirected off all five of her
                    pages, so logging in here left me one passcode in and still
                    locked out, needing to answer the quiz as well on every device.

                    /api/us/admin now mints a session alongside the admin and
                    whoami tokens: the passcode is a stronger credential than three
                    answers about me, so presenting it has already cleared a higher
                    bar than the gate asks. The pages' `session` check is unchanged.

                    Points at the HUB rather than at /today, because the hub is the
                    front door and carries the two clocks, the countdown, presence
                    and the four rooms. */}
                <a href="/samdrea/vault">the vault &rarr;</a>
                <form class="studio-out" method="post" action="/api/us/out"><button class="studio-out-btn" type="submit">sign out of everything</button></form>
            </div>
    <script is:inline>
    /* --------------------------------------------------------------------------
       Posting, enhanced. Inline and un-bundled to match the gate page: it is a
       handful of lines and a module graph would be the only modern thing here.

       It lives INSIDE the unlocked branch, so it is never sent to a visitor who
       has not passed the passcode. That is not about secrecy of the code — there
       is nothing secret in it — but about not handing an unauthenticated stranger
       a list of my endpoint names. The wing's stated property is that an
       unauthorized caller cannot even tell which endpoints exist (middleware.ts
       is default-deny for exactly that reason), and shipping this script to the
       locked page would have quietly undone it for the price of 2KB nobody runs.

       The getElementById bail-out below is kept anyway, as the belt to that
       braces: if this ever gets hoisted out of the branch, it does nothing rather
       than throwing on a form that is not there.

       The form ALREADY WORKS without this — method="post" action="/api/us/song",
       303 back to this page. Everything below buys exactly one thing: when a post
       fails, the note I just typed is still in the textarea. A native submit has
       navigated away by then and the text is gone, and retyping a paragraph on a
       phone is the difference between doing this daily and not.

       On success it hands control back to the server (?posted=<date>) rather than
       patching the preview from the response, so what I look at afterwards is what
       is actually in the store — not what I hoped I sent.
       -------------------------------------------------------------------------- */
    (function () {
        var form = document.getElementById('post-form');
        var submit = document.getElementById('post-submit');
        var status = document.getElementById('post-status');
        if (!form || !submit || !status) return;

        var MESSAGES = {
            'bad-url': 'not a spotify TRACK link. copy the link from the song itself.',
            'bad-date': 'that date is not a real date.',
            'future-date': 'that date is in the future. she would never see it.',
            'bad-request': 'the server could not read that.',
            unauthorized: 'admin session expired. reload and enter the passcode again.',
            unconfigured: 'not configured on the server.',
            store: 'the store refused the write. NOTHING WAS SAVED.',
            rate: 'too many posts too fast. wait a bit.'
        };

        function say(kind, text) {
            /* UNHIDDEN FIRST, THEN WRITTEN. A `hidden` element is not in the
               accessibility tree, and several screen-reader/browser pairs only
               announce MUTATIONS to a live region that is already there — so
               writing the text before revealing the region is how you get an
               aria-live region that silently announces nothing. Same fix, same
               reason, as the one on her page. */
            status.hidden = false;
            // The word is part of the message, so this never depends on colour.
            status.dataset.kind = kind;
            status.textContent = (kind === 'bad' ? 'no — ' : 'saved — ') + text;
        }

        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            var body = {
                url: form.elements.url.value.trim(),
                note: form.elements.note.value,
                artist: form.elements.artist.value.trim(),
                date: form.elements.date.value
            };
            if (!body.url) { say('bad', 'paste a link first.'); form.elements.url.focus(); return; }

            submit.disabled = true;
            submit.textContent = 'posting';

            var res, data;
            try {
                res = await fetch('/api/us/song', {
                    method: 'POST',
                    // JSON in, JSON out. The endpoint keys its response shape off
                    // this header, so a form POST still gets its redirect.
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(body)
                });
                data = await res.json();
            } catch (err) {
                say('bad', 'the server did not answer. nothing was saved. try again.');
                return;
            } finally {
                submit.disabled = false;
                submit.textContent = 'post it';
            }

            if (!res.ok || !data || data.ok !== true) {
                var code = (data && data.error) || 'no';
                say('bad', MESSAGES[code] || 'something went wrong. nothing was saved.');
                return;
            }

            if (data.degraded) {
                // Said out loud rather than left as a half-empty card I would
                // otherwise assume was a bug in my own code.
                say('ok', 'posted, but Spotify would not give us a title or art. Her embed still names it.');
            } else {
                say('ok', 'posted.');
            }

            // Let the server re-render the preview from the store. The short pause
            // is so the status line above is actually readable first.
            setTimeout(function () {
                window.location.assign('/samdrea/dj?posted=' + encodeURIComponent(data.date));
            }, 650);
        });
    })();
    </script>
        </>
    )}
</div>

</body>
</html>

---
/**
 * /samdrea/vault — Act II, the hub.
 *
 * ---------------------------------------------------------------------------
 * THE SESSION IS RE-VERIFIED HERE, AND THAT IS NOT THEATRE
 *
 * src/middleware.ts has already verified a signed, unexpired `session` cookie, or
 * this render never happened and she was bounced to the gate instead.
 *
 * The re-check below is what makes a routing mistake in the middleware degrade to
 * "empty page" instead of "everything is public". If NEEDS_SESSION ever stops
 * matching this path, this page still refuses to render.
 *
 * ---------------------------------------------------------------------------
 * WHAT THIS PAGE IS FOR NOW
 *
 * It used to be a menu. The problem with a menu is that it looks identical whether
 * or not anything has happened, so the only way for her to find out I had posted was
 * to open both rooms and compare them against her memory. She had to guess and
 * check, every time, forever.
 *
 * So the hub now answers two questions before she clicks anything:
 *
 *   1. WHAT CHANGED SINCE SHE WAS LAST HERE. A quiet marker on each room that has
 *      something in it, plus one line above the grid. Everything is derived from
 *      stored records — see status.ts's newSince(); nothing here is estimated and no
 *      count exists because the layout wanted a badge.
 *
 *   2. HOW LONG UNTIL THEY ARE IN THE SAME PLACE. One date in status.ts, rendered
 *      server-side so both of them see the same number from opposite sides of the
 *      Atlantic. Invisible when unset.
 *
 * THE EMPTY STATE IS THE DESIGN TARGET, not the fallback. Most visits will have
 * nothing new in them, so "nothing new since you were last here — everything is
 * exactly where you left it" is the sentence this page says most often, and it has
 * to read as a room at rest rather than as a zero or a fault.
 *
 * ---------------------------------------------------------------------------
 * IT COUNTS THE VISIT, AND IT HAS TO
 *
 * countVisitSafe, not getVisits: THIS PAGE LOAD IS A VISIT, exactly as it is in
 * room.astro. It is also load-bearing for the markers above, because the baseline
 * they compare against is Visits.prev, and `prev` only means "her previous visit"
 * once countVisit has stamped the current one. Reading without counting would leave
 * `prev` one visit stale and the markers would describe the wrong window.
 *
 * The twenty-minute debounce inside countVisit is what makes the markers survive a
 * refresh — see the VISIT DEBOUNCE and Visits.prev in marks.ts, which document the
 * interaction and the one accepted consequence of it.
 *
 * ---------------------------------------------------------------------------
 * EVERY READ HERE FAILS SOFT
 *
 * This page is the front door. A store that is down must cost her the markers, never
 * the door: marks.ts's *Safe wrappers already do that by policy, and getSongs()
 * (which throws by policy, because kv.ts's writes must fail loud) is caught to an
 * empty array right at the call. An empty array yields no markers, and no markers is
 * a state this page renders correctly on purpose.
 * ---------------------------------------------------------------------------
 */
import { HER_NAME, HER_NAME_OPT, SESSION_SECRET, hasKV, hasPush, pushConfig } from '../../../lib/us/config';
import { sentenceCase, whoWords } from '../../../lib/us/who-words';
import { readCookie, verify } from '../../../lib/us/session';
import { getSongs, wingDate, wingDateLabel, type SongRecord } from '../../../lib/us/kv';
import { countVisitSafe, getMarksSafe } from '../../../lib/us/marks';
import { countdown, newSince } from '../../../lib/us/status';
import { presenceLine, touchAndRead } from '../../../lib/us/presence';
import {
  ANSWER_MAX,
  HER_TZ,
  HIS_TZ,
  HUB_DAY_WINDOW,
  ITEM_MAX,
  LATE_ANSWER_DAYS,
  OPEN_CAP,
  TOTAL_CAP,
  answerParagraphs,
  apartLine,
  board,
  clocks,
  getAllSafe,
  identify,
  isWeekPrompt,
  otherOne,
  sentLine,
  thinkingLine,
  togetherTier,
  visibleDay,
  type VisibleDay,
  type Who,
} from '../../../lib/us/together';

export const prerender = false;

const secret = SESSION_SECRET();
const session = secret ? verify(secret, 'session', readCookie(Astro.cookies, 'session', Astro.url)) : null;
if (!session) return Astro.redirect('/samdrea', 302);

/**
 * WHICH OF THEM IS READING THIS PAGE.
 *
 * ---------------------------------------------------------------------------
 * THIS IS PURELY ADDITIVE AND CANNOT GRANT ACCESS TO ANYTHING
 *
 * The `session` check above is unchanged and still the only thing that decides
 * whether this page renders. My admin token cannot open her vault and this does not
 * change that — the redirect on line 72 fires first, and identify() runs afterwards.
 *
 * What it does is decide whose SIDE of the three new blocks to show. The wing has
 * been strictly one-directional until now, so every other page could safely assume
 * its reader was her. "Thinking of you" and the daily question are two-sided, so the
 * pronouns, the clock labels and which half of an exchange is "yours" all depend on
 * who is holding the cookie.
 *
 * It resolves to 'him' when an admin token is present, because I know the answers to
 * my own questions and can therefore hold BOTH cookies at once — see the PART ZERO
 * comment in together.ts, which owns this rule. The endpoints call the same function,
 * so a tap attributed to 'him' on write is rendered as 'him' here. Two
 * implementations of that would eventually put one person's words under the other's
 * name, which is the worst bug this feature has available.
 *
 * `session` is non-null by the time this runs, so identify() cannot return null in
 * practice; the `?? 'her'` is there so the type is `Who` rather than `Who | null` and
 * no expression below has to defend against a state that cannot happen.
 */
const viewer: Who = identify(Astro.cookies, Astro.url) ?? 'her';
const them = otherOne(viewer);

const her = HER_NAME();

/* WHAT TO CALL THE TWO OF THEM — see who-words.ts for the rule and for why
   there is now one module instead of a copy on each page.

   Declared HERE, up with `viewer`, and not down in the copy helpers where it
   started: presenceLine() a few lines below needs it, and `const` does not
   hoist, so a definition further down is a ReferenceError on the first render
   rather than a wrong word. */
const words = whoWords(viewer, HER_NAME_OPT());

/** Today in the wing's timezone. Passed into everything; never re-derived. */
const today = wingDate();

/**
 * ONE clock reading for the whole render.
 *
 * Every relative phrase on this page ("this morning", "half an hour ago") and both
 * wall clocks derive from this single number rather than each calling Date.now(). Two
 * readings a few milliseconds apart cannot disagree in any way a human would notice —
 * but they CAN straddle a minute boundary, and a page that renders "18:42" in one
 * place and computes "an hour ago" against 18:43 in another is a page with two clocks
 * in it. Same discipline status.ts and kv.ts's derivations apply to `today`.
 */
const nowMs = Date.now();

/**
 * How far back to look for songs written since her last visit.
 *
 * 365, matching today.astro's HISTORY_WINDOW and the ceiling getSongs() enforces,
 * so this is "everything there is" rather than a window that silently truncates.
 * That matters for the "I went back and changed an older morning" case
 * specifically: getSongs orders by DATE, so a note I rewrote today on a morning from
 * six months ago sits near the bottom of the list, and a 60-row window would simply
 * never see it.
 *
 * The cost is smallest on the tier that is live: on R2 the entire history is one
 * JSON object, so 365 days costs exactly what 60 does. On Upstash it widens one
 * MGET — more bytes, same two round trips.
 */
const HISTORY_WINDOW = 365;

/**
 * Four reads, in parallel, because none of them depends on another.
 *
 * Two of them hit the marks document, one hits the songs document, and one hits the
 * together document. On the R2 tier that is two GETs of the same marks object, which
 * is a real if small waste — the honest alternative would be a seventh operation on
 * marks.ts's Store interface returning marks and visits together, and that interface's
 * own header sets the bar: a new operation has to justify itself three times over, once
 * per tier. Saving one GET on one page does not clear it.
 *
 * The together read is ONE call for all three new features rather than three, which is
 * why together.ts exposes getAll() instead of a getter per feature — three separate
 * reads would be three GETs of one R2 object on every render of the front door.
 */
const [songs, marks, visits, togetherRead] = await Promise.all([
  getSongs(HISTORY_WINDOW).catch((err): SongRecord[] => {
    // kv.ts throws on read failure by policy. Here that is decoration failing, so it
    // degrades to "nothing new" rather than to an error page.
    console.error('[us] the hub could not read the songs; rendering it without markers.', err);
    return [];
  }),
  getMarksSafe(),
  countVisitSafe(),
  /* The *Safe wrapper, matching every other read on this page. together.ts's header
     states the policy: writes fail loud, reads fail soft, and this page is the front
     door — a dead store must cost her the three blocks and never the door. It returns a
     snapshot with today's (empty) day present, which is a state the markup renders
     correctly. */
  getAllSafe(today, HUB_DAY_WINDOW),
]);

/* SPLIT OUT, so the page can tell "nothing happened" from "I could not ask".
   getAllSafe returns an empty snapshot on failure, and an empty snapshot is
   indistinguishable from a quiet day — so without this flag the hub asserted
   "Nothing from him today" and rendered the daily question as unanswered when the
   truth was that nothing had been read. She would have no way to tell.
   today.astro already hedged correctly on the song page; this is the same idea. */
const together = togetherRead.snapshot;
const storeReachable = togetherRead.reachable;

const fresh = newSince({ today, visits, songs, marks });

/** null when Sam has not set a date, or has set one that has passed. Renders nothing. */
const until = countdown(today);

/* ============================================================================
   THE TWO CLOCKS

   Both wall clocks from the one `nowMs` above. `mine` and `theirs` rather than
   `her` and `him` so the markup below never branches on who is reading — the
   perspective is resolved once, here.
   ========================================================================= */
const twoClocks = clocks(nowMs);

/* WHEN YOU CAN BOTH BE HERE. Derived from the two clocks above and the awake
   window in together.ts — no storage, no endpoint, nothing either of them sets.
   The clocks say where each of you is; this says whether reaching the other one
   right now reaches a person or a phone on a nightstand. Nine hours apart, that
   sum is the one both of them were doing in their heads and getting wrong. */

/* AND WHETHER THEY ARE BOTH HERE *NOW*. One pipelined Upstash call that stamps
   the reader's clock and reads the other's. Resolves to null on any failure and
   whenever Upstash is absent, in which case the line simply does not render —
   see presence.ts on why a durable fallback for this would be a lie. */
const seen = await touchAndRead(viewer, nowMs);
const seenLine = presenceLine(seen, words.them);
const myClock = viewer === 'her' ? twoClocks.her : twoClocks.him;
const theirClock = viewer === 'her' ? twoClocks.him : twoClocks.her;
/** '' most of the time. Only worth saying when the gap has crossed a date line. */
const theirDayNote = twoClocks.differentDay
  ? theirClock.date > myClock.date
    ? 'already tomorrow'
    : 'still yesterday'
  : '';

/* ============================================================================
   THINKING OF YOU

   Two sentences, and either can be ''. `incoming` is what THEY sent, rendered in
   MY timezone (see warmAgo — "this morning" is a claim about the reader's morning,
   so it has to be computed in the reader's zone or it is wrong for both of them).
   `outgoing` is my own receipt.
   ========================================================================= */
const myTz = viewer === 'her' ? HER_TZ : HIS_TZ;

const incoming = thinkingLine({
  record: together.thinking[them],
  nowMs,
  readerTz: myTz,
  today,
  /* Sentence-initial: this renders into .tg-think-line, which is the one place a
     person's word starts a sentence with no CSS uppercase over it. With the name
     set it is already capital; sentenceCase is for the unset fallback, which is
     a real state here — an env var that misses a deploy ships silently. */
  theirName: sentenceCase(words.them),
});
const outgoing = sentLine(together.thinking[viewer], nowMs, myTz);

/* ============================================================================
   THE DAILY QUESTION

   ---------------------------------------------------------------------------
   EVERY DAY ON THIS PAGE GOES THROUGH visibleDay() AND NOTHING ELSE

   `together.days` holds raw DayRecords, which contain BOTH answers. Not one of them
   is rendered directly. visibleDay(rec, viewer, today) is the seal: it returns an
   object whose `theirs` field is ABSENT — not blanked, not hidden behind a class —
   unless both of them have answered. letters.ts's visibleLetter() does exactly this
   for a sealed body, and the reasoning is the same: the page cannot leak what it was
   never given, and `display: none` on something I promised not to show her yet is a
   promise broken by View Source.
   ========================================================================= */

/** Today's, always present — getAll() unions today in even when nobody has answered. */
const dayToday: VisibleDay = visibleDay(
  together.days[today] ?? { date: today, her: '', herAt: 0, him: '', himAt: 0 },
  viewer,
  today,
);

/**
 * The past days worth showing, newest first.
 *
 * THREE KINDS SURVIVE THE FILTER and the rest are dropped, which is a deliberate
 * choice about what a past day is FOR:
 *
 *   revealed        both answered. The archive. This is the good part.
 *   canAnswer       I never answered and it is still inside the window — so this is
 *                   an invitation, and it belongs on the page precisely because
 *                   answering it now still works and still reveals both halves.
 *   closed + theirs-answered
 *                   nobody can complete it any more. Shown as an honest gravestone
 *                   ("this one stayed half-open") with NO answer text, because the
 *                   seal outlives the window — see below.
 *
 * A day where only I answered and nobody else ever will is NOT shown as a gravestone
 * with my words in it; it shows my own answer, because you can always read what you
 * wrote. That falls out of visibleDay() rather than being decided here.
 */
const pastDays: VisibleDay[] = Object.keys(together.days)
  .filter((d) => d !== today)
  .sort((a, b) => b.localeCompare(a))
  .map((d) => visibleDay(together.days[d], viewer, today))
  .filter((d) => d.revealed || d.canAnswer || d.mine.length > 0 || d.theyAnswered);

/** How many past days are still open to a late answer. Drives one line of copy. */
const stillOpen = pastDays.filter((d) => d.canAnswer).length;

/* ============================================================================
   THE LIST
   ========================================================================= */
const list = board(together.items);
/** Room left before OPEN_CAP refuses an add. Only mentioned when it is getting close. */
const roomLeft = OPEN_CAP - list.open.length;
/**
 * Room left before TOTAL_CAP refuses an add, which is the OTHER way the store can
 * say no and the one this page used to know nothing about.
 *
 * addRefusal() checks TOTAL_CAP *before* OPEN_CAP, so a list holding 300 items —
 * 5 open and 295 ticked off, say — refuses every add while `roomLeft` reads 35 and
 * happily draws the box. She would type a line, press add, and get "the list is
 * completely full" from a form that had just invited her. Counting both means the
 * page only offers what the store will actually take.
 */
const totalLeft = TOTAL_CAP - (list.open.length + list.done.length);
/** True only when BOTH caps have room. Gates the add form. */
const canAdd = roomLeft > 0 && totalLeft > 0;

/* THESE TWO ARE NAMED HERE TO KEEP `<=` OUT OF THE TEMPLATE, and that is a
   tooling reason rather than a style one.

   Astro's tag scanner reads the `<` of a `<=` in an expression position as the
   start of a tag and then the `= 8 &&` after it as an attribute on a tag with no
   name, which it reports as "Unable to assign attributes when using <> Fragment
   shorthand syntax!" — a message that names nothing to do with the actual code.
   astro build compiles it correctly, so the only symptom was a permanent error in
   `npm run typecheck`, which is the gate that decides whether this wing is
   type-clean. A standing error there is worse than the inconvenience: it trains
   whoever reads the output next to skip a line, and the whole value of the count
   being exactly right is that a new one stands out.

   Rejected: `!(roomLeft > 8)`, which dodges the scanner but inverts the sense of
   a threshold for the parser's benefit and reads like a puzzle. A named boolean
   costs one line and says what it means. */
const listNearlyFull = roomLeft <= 8;
const listCompletelyFull = totalLeft <= 0;

/* ============================================================================
   OUTCOMES FROM THE NO-JAVASCRIPT FORM PATHS

   Both endpoints 303 back here with `?ok=<code>` or `?e=<code>` and a fragment. The
   codes are turned into her language rather than into HTTP: she does not need to know
   what a 502 is, only that it was not her fault and it is worth another go.

   Written as two lookup tables rather than one, because a success and a failure are
   rendered in different elements with different wording — collapsing them would mean
   the markup guessing which kind it had from the string's content.
   ========================================================================= */
const okCode = Astro.url.searchParams.get('ok') ?? '';
const errCode = Astro.url.searchParams.get('e') ?? '';

const OK_TEXT: Record<string, string> = {
  sent: 'sent. That is all it says, and that is the point.',
  already: 'already sent — one is enough for now. It counts.',
  answered: 'in. Nothing of theirs shows up until they answer too.',
  revealed: 'in — and you were both there. Have a look.',
  added: 'on the list.',
  ticked: 'ticked off.',
  unticked: 'put back on the list.',
  removed: 'taken off.',
  done: 'done.',
};
const ERR_TEXT: Record<string, string> = {
  store: "that didn't save — not your fault. Try it again?",
  rate: 'okay, easy. Give it a minute and try again.',
  unauthorized: 'your session ran out. Answer the questions again and you are back in.',
  unconfigured: 'something is unplugged on my end. Not your fault.',
  'cross-site': 'that request did not come from this page, so it was refused.',
  'bad-request': "the server couldn't read that. Try again?",
  'bad-action': "the server couldn't read that. Try again?",
  'bad-date': 'that is not a real day.',
  'text-missing': 'there was nothing in the box.',
  empty: 'there was nothing in the box.',
  'too-long': 'that is longer than the box will hold. Trim it a little?',
  frozen: 'you both already answered that one — it is set now, on purpose.',
  closed: `that one closed after ${LATE_ANSWER_DAYS} days. Today's is open.`,
  'no-such-item': "I can't find that one. It may already be gone.",
  'not-removable': 'only whoever added a line can take it back off.',
  'open-full': `the list is full at ${OPEN_CAP} open things. Tick something off first.`,
  'total-full': 'the list is completely full. Nothing was lost — but nothing more fits.',
};
const okText = okCode ? (OK_TEXT[okCode] ?? 'done.') : '';
const errText = errCode ? (ERR_TEXT[errCode] ?? "that didn't go through. Try again?") : '';

/* ---- copy helpers --------------------------------------------------------- */

/* These two used to be bare pronouns computed right here, so the questions
   block below said "she has answered" about the person every other page calls
   by name. They are aliases onto `words` now — kept as names rather than
   inlined because `themWord` also crosses into the inline script through
   define:vars, and one variable there is one thing to keep in step. */
const themWord = words.them;
const themPossessive = words.themPossessive;

/** e.g. `Sat 22 Aug 2026`. '' when the date is unusable. */
function dayLabel(date: string): string {
  return date ? wingDateLabel(date, { withYear: true }) : '';
}

/**
 * Who added a line, from the reader's side — and it used to be ungrammatical.
 *
 * It returned the OBJECT pronoun, so the byline read "her added this" and "him added
 * this". Those are not sentences. The subject form would fix the grammar and still be
 * the wrong register: this list is two people writing to each other, and "she added
 * this" about the person whose name he knows reads like a system talking about a user.
 *
 * Now it is `words.of()` and nothing else, so the byline and the questions block
 * below cannot end up calling the same person two different things — which is what
 * happened when this function was the only site that had been fixed. His side used
 * to stay 'he' here on the argument that there is no US_HIS_NAME to read; 'Sam' is
 * a literal in the source, which the other two pages had already worked out.
 */
const byWord = (by: Who): string => words.of(by);

/**
 * The label above today's answer box, and the ONE place the ceiling is named.
 *
 * It used to read "Your answer — up to 400" on every day of the week, with no unit
 * on the number, and that was wrong twice over:
 *
 *   1. ANSWER_MAX is 400 CHARACTERS. A bare "up to 400" above a four-row textarea
 *      reads as four hundred WORDS, which is an invitation to write an essay into a
 *      box that will cut her off at about eighty.
 *
 *   2. On Sundays the prompt IS "your week, in five words" (see WEEK_PROMPT), so the
 *      same label put "up to 400" directly underneath a question asking for five.
 *      The page contradicted itself once a week.
 *
 * So Sunday names no ceiling at all. That is not an omission: the prompt has already
 * said how long the answer should be, the server limit is unchanged and unreachable
 * at five words, and together.ts is explicit that five words is an invitation rather
 * than a validation — if she answers in seven, seven is right. A number here would
 * argue with the question above it for no gain.
 */
const answerLabel = isWeekPrompt(dayToday.date)
  ? 'Your answer'
  : `Your answer — up to ${ANSWER_MAX} characters`;

const rooms = [
  {
    n: '01',
    title: 'one day, two songs',
    note: 'one from each of us, every day. and why.',
    href: '/samdrea/vault/today',
    ready: true,
    /* The marker is WORDS, not a colour and not a dot on its own. Two reasons, and
       both are requirements rather than taste: a state carried only by a blue border
       is invisible to anyone who cannot see the blue, and a bare count is the SaaS
       badge this feature exists to not be. The dot in the markup below is decoration
       on top of the words and is aria-hidden accordingly. */
    fresh: fresh.song,
  },
  /* LINE 02 — THE STUDIO — IS BENCHED, NOT DELETED.

     The 3D room works, but it is not finished enough to be how she first sees
     these photographs: the captions are still bracketed developer notes, the
     backdrop still carries wall text, and it asks her to learn a scroll-and-hold
     gesture before it shows her anything. A room that needs explaining is the
     wrong first impression for a gift.

     So it comes off HER hub and nothing else about it changes:

       src/components/StudioRoom.tsx        untouched, ~4700 lines
       src/pages/samdrea/vault/room.astro   untouched, still routes
       public/css/us-studio.css             untouched
       /samdrea/vault/room                  STILL REACHABLE by direct URL, so it
                                            can be worked on and looked at with no
                                            branch and no revert

     Removed rather than flagged `ready: false`: the grid renders a not-ready room
     as a visible disabled card, which would put "coming soon" on the front door
     of a present. Absent is better than pending.

     TO BRING IT BACK, it needs a `n` that is not `line 02` any more — the board
     below has that number now. Nothing else about it changed; `fresh.studio` is
     still computed in status.ts and still correct.

     WHAT TOOK ITS PLACE, and why it kept the number:

     /samdrea/vault/board is the same thirteen photographs, pinned to a corkboard
     under a string of fairy lights as Polaroids. Tap one, it gets bigger and the
     note is readable. No gesture, nothing to hold, nothing to learn — which was
     the entire complaint against the studio and is the entire brief for this.

     It inherits `line 02` rather than becoming `line 05` because the numbers are
     positions in the wing, not a changelog: the photographs have always been the
     second thing in here, and renumbering them to the end would make the order
     she reads the hub in depend on the order I happened to build the rooms in.

     No `fresh` signal, for the same reason as line 03 and line 04. status.ts
     reads the song store and the marks store, and while the marks store IS what
     this room writes to, a marker keyed on it would light up when SHE keeps
     something — i.e. it would tell her about her own tap. A signal that fires on
     your own action is decoration. */
  {
    n: '02',
    title: 'the board',
    note: 'every photograph, pinned up under the lights. tap one.',
    href: '/samdrea/vault/board',
    ready: true,
  },
  /* LETTERS IS BENCHED, exactly the way the studio is — off her hub, all of its
     code intact.

     The room works. What is in it does not: four PLACEHOLDER letters, and the first
     one she would open says so in its own body. A room whose entire content is a
     note explaining that the content is not written yet is worse than a room that
     is not there. It comes back the moment US_LETTERS holds something real.

     Nothing else changes:

       src/lib/us/letters.ts                   untouched, ~1700 lines
       src/pages/samdrea/vault/letters.astro   untouched, still routes
       public/css/us-letters.css               untouched
       /samdrea/vault/letters                  STILL REACHABLE by direct URL
       /api/us/letter                          untouched; her replies still save

     Removed rather than flagged `ready: false`, for the same reason as the studio:
     the grid renders a not-ready room as a visible disabled card, and "coming soon"
     on the front door of a present is worse than the room simply not being there.

     TO BRING IT BACK, restore this one object and put the entry back in
     NEXT_ALLOWED in samdrea/index.astro. Nothing else is required. */
  {
    /* 03, NOT 04 — the numbers are POSITIONS in the wing, not permanent ids.
       With letters benched, leaving this at 04 left her hub reading 01, 02, 04,
       and a gap in a numbered list reads as something missing. Which is exactly
       the impression benching the room was meant to avoid.
       So they resequence when a room comes or goes. Restoring letters means
       deciding where it sits and renumbering whatever follows it — cheap, and
       the alternative is a permanent hole. */
    n: '03',
    title: 'today, seen',
    note: 'one picture each. whatever we were looking at.',
    href: '/samdrea/vault/day',
    ready: true,
    /* No `fresh` signal, for the same reason as line 03 and one more. status.ts
       does not read the frames store, so wiring one would be a fourth store read
       on every hub render — and this is the room most likely to have something new
       in it on any given day, so a marker that was almost always lit would be
       decoration rather than information. The page itself is one tap away. */
  },
];

/* ---------------------------------------------------------------------------
   NOTIFICATIONS — the two things the SERVER gets to decide.

   1. WHETHER THE FEATURE EXISTS. Without VAPID keys nothing can be signed and
      without Upstash there is nowhere to keep a subscription, so the block is
      not rendered at all rather than rendered as a button that turns on and then
      never does anything. Same contract every optional backing service in this
      wing has (see kvConfig / r2Config in config.ts).

   2. THE PUBLIC KEY. `pushManager.subscribe()` needs it as
      `applicationServerKey`, and it is PUBLIC by definition — it is inside the
      subscription the push service issues. Rendering it costs nothing. The
      private key is never read on this page and never leaves the server.

   EVERYTHING ELSE IS THE BROWSER'S TO ANSWER, and it has to be: whether the app
   is installed to the home screen, whether this device supports push at all, and
   whether she has already said yes, no, or nothing yet. The server cannot know
   any of those, which is why the whole block below starts `hidden` and the script
   is what reveals the one true state. With JavaScript off it stays hidden, so she
   is shown nothing rather than a control that could not work.
   --------------------------------------------------------------------------- */
const pushReady = hasPush() && hasKV();
const vapidKey = pushReady ? pushConfig().publicKey ?? '' : '';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- viewport-fit=cover is REQUIRED for env(safe-area-inset-*) to be
         anything but 0. The pages set apple-mobile-web-app-status-bar-style
         to black-translucent, so iOS draws content UNDER the notch and the
         home indicator; without this attribute there is no opt-out AND no
         way to pad around it, so the studio's "exit" link sat behind the
         battery icon. The insets are applied in us.css and us-studio.css. -->
    <meta name="color-scheme" content="dark">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>[us]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/assets/us/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="[us]">
    <meta name="theme-color" content="#000000">
    <link rel="stylesheet" href="/css/us.css">
    <!-- After us.css, never before: us-hub.css overrides .room's resting border on a
         card that has something new in it, and the cascade order is the only thing
         making that win. -->
    <link rel="stylesheet" href="/css/us-hub.css">
    <!-- Last, and after us.css for the tokens it uses. It deliberately does NOT
         depend on us-song.css's `.dj-*` / `.notice` form primitives the way
         letters.astro does — that file is being restructured for the mutual
         song-of-the-day work, and a hub that borrowed its rules would break when it
         moved. us-together.css carries its own `tg-` copies and says so. -->
    <link rel="stylesheet" href="/css/us-together.css">
    <script is:inline src="/us-land.js"></script>

    <script src="/us-pull.js" defer></script>
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2032%2032%27%3E%3Crect%20width%3D%2732%27%20height%3D%2732%27%20fill%3D%27%23000%27%2F%3E%3Ctext%20x%3D%2716%27%20y%3D%2722.5%27%20font-family%3D%27Helvetica%2CArial%2Csans-serif%27%20font-size%3D%2716%27%20font-weight%3D%27700%27%20text-anchor%3D%27middle%27%3E%3Ctspan%20fill%3D%27%233e7bff%27%3E%5B%3C%2Ftspan%3E%3Ctspan%20fill%3D%27%23fff%27%3Eus%3C%2Ftspan%3E%3Ctspan%20fill%3D%27%233e7bff%27%3E%5D%3C%2Ftspan%3E%3C%2Ftext%3E%3C%2Fsvg%3E">
</head>
<body class="studio">
<div class="studio-wrap">

    {/* "verified" is a word from a security product, not from either of them — it
        described the gate she had just cleared rather than the place she had arrived
        in. An eyebrow's job is to say where you are. */}
    <p class="studio-kicker">us &middot; the whole thing</p>

    <h1 class="us-mark">
        <span class="us-mark-bracket" aria-hidden="true">[</span>us<span
              class="us-mark-bracket" aria-hidden="true">]</span>
    </h1>

    <p class="studio-lede">
            {/* THE NAME HAS TO FOLLOW THE READER. This said "You're in, {her}" for
                everyone, so switching to Sam left the very first line of the hub
                greeting him as Andrea — which is what "items still say Andrea"
                was. The name is HER name; the greeting is the READER's. */}
            {/* AND NOTHING AFTER IT. "Nobody else has this address." used to sit on a
                second line here, and it was the worst sentence in the wing: reassurance
                she never asked for, delivered portentously, explaining the site's own
                privacy to her as though it were a selling point.

                It is also the tell for copy that was written ABOUT this place rather
                than IN it — a short declarative that reframes the line above it, neatly
                parallel, faintly profound. Two people texting do not talk that way. The
                greeting is enough; anything appended to it is a brochure. */}
            You&rsquo;re in, {viewer === 'her' ? (her || 'you') : 'Sam'}.
        </p>

    {/* ============================================================
        THE TWO CLOCKS

        Smallest type on the page, directly under the lede: it is ambient
        context — where each of you is — and it sets up the countdown
        below rather than competing with it.

        Both are real <time datetime> elements carrying the same instant
        with each zone's own offset, so the machine-readable value is the
        actual fact and not a bare "18:42" in an unspecified zone.

        `data-tg-clock` is the ONLY hook the tick script uses. It is a
        data attribute rather than a class so that restyling can never
        silently unhook the script. See the script at the bottom for why
        a tick is warranted at all and why it is not a live region.
        ============================================================ */}
    <p class="tg-clocks">
        <span class="tg-clock">
            <span class="tg-clock-who">you</span>
            <time
                class="tg-clock-time"
                datetime={myClock.iso}
                data-tg-clock="mine"
                data-tz={myClock.tz}
            >{myClock.time}</time>
        </span>
        <span class="tg-clock">
            {/* A word, not a colour and not an icon. Which clock is whose is
                the entire information content of this strip.

                A NAME, not a pronoun. This said 'him', and the asymmetry only
                shows up when you read the two sides at once: when he opens the
                hub her clock is labelled with her NAME, and when she opens it
                his is labelled "him". The one person this wing is for got the
                impersonal half of its own clock strip. today.astro already
                titles his card "Sam"; day.astro said "him"; three pages, two
                words, one person. Labels take the name everywhere now.

                AND SO DO SENTENCES, which reverses what this comment used to
                say. It carved out "Nothing from him today" as correct prose that
                should stay a pronoun, and read on its own that is defensible —
                but he asked for the name in both, and he is right that a page
                where the clock says one thing and the sentence under it says
                another is the same split this comment was written to close.

                Reading `her` here was also its own quiet bug: that is HER_NAME(),
                which falls back to 'you', so an unset variable labelled HER
                clock "you" on HIS screen. words.them cannot, because the raw
                value is what it is handed. */}
            <span class="tg-clock-who">{words.them}</span>
            <time
                class="tg-clock-time"
                datetime={theirClock.iso}
                data-tg-clock="theirs"
                data-tz={theirClock.tz}
            >{theirClock.time}</time>
            {/* Only when the gap has crossed a date line, which is the
                genuinely useful fact in an eight-or-nine-hour split. */}
            {theirDayNote && <span class="tg-clock-day">{theirDayNote}</span>}
        </span>
        <span class="tg-apart">{apartLine(twoClocks, viewer)}</span>
    </p>

    {/* ============================================================
        WHEN, AND WHETHER RIGHT NOW

        Two lines that both answer questions the clock strip above raises
        and cannot itself settle. They sit directly under it, in the same
        small type, because they are the same thought continued.

        PRESENCE FIRST when it exists. "he is in here too, right now" is
        the only line on this page that can stop her reading the rest of
        it and that is exactly what it is for, so nothing is allowed to
        sit above it. It renders only inside the hour and only from the
        OTHER person's visit — with no Upstash it renders nothing at all.

        `aria-live="polite"` is deliberately ABSENT. This is server
        rendered once per page load; there is no client update to
        announce, and a live region that never changes is a promise to a
        screen reader that the page does not keep. */}
    {seenLine && (
        <p class="tg-seen" data-together={seen?.together ? 'yes' : 'no'}>{seenLine}</p>
    )}

    {/* THE AWAKE-WINDOW LINE IS GONE, and it should never have been a guess.
    
        It read "you are both awake — for the next five and a half hours" or "he is
        asleep. he is up again in seven hours", derived from HER_TZ, HIS_TZ and one
        hardcoded 08:00–23:30 window. The arithmetic was right and the premise was
        not: two people's sleep does not hold to a window, and a page that states a
        guess in the same voice it states a fact teaches you to discount both.
    
        I had already patched the worst symptom — presence overrode the guess when
        the two disagreed out loud — which in hindsight was the tell. A line that
        needs suppressing whenever real evidence shows up is a line the real
        evidence should have replaced.
    
        WHAT REMAINS IS ALL OBSERVED, not inferred:
          the two clocks    where each of you actually is, right now
          .tg-seen          "he is in here too, right now" — a real page render
          post timestamps   each song and photo carries the poster's own local
                            time, so when somebody is awake is visible from what
                            they did rather than asserted by a constant
    
        overlap(), overlapLine(), spanWords() and AWAKE_FROM_MIN/AWAKE_UNTIL_MIN are
        removed from together.ts with this — they had no other caller. */}

    {/* ONE HONEST BANNER, above everything it qualifies.
        getAllSafe returns an EMPTY snapshot when the store cannot be read, and an
        empty snapshot is indistinguishable from a quiet day — so this page used to
        assert "Nothing from him today", show the daily question as unanswered and
        show the list as empty when the truth was that nothing had been read at
        all. She would have had no way to tell, which is the one kind of lie this
        wing cannot afford.

        Hedging each of those six sentences separately would mean six conditionals
        and six chances to get one wrong. One banner says the true thing once and
        leaves every empty state exactly as written. */}
    {!storeReachable && (
        <p class="tg-notice" data-kind="warn" role="status">
            I can&rsquo;t reach the shelf right now, so this page may be missing
            things. Nothing either of us wrote is lost &mdash; it just is not
            answering. Worth another look in a minute.
        </p>
    )}

    {/* Nothing at all when the date is unset, mistyped, or long past. No
        placeholder, no "TBD", no empty box — see countdown() in status.ts. */}
    {until && (
        <p class="hub-until">
            <strong class="hub-until-count">{until.count}</strong>
            {/* Three separate elements spaced by CSS `gap`, not by whitespace in
                this file. Astro collapses the whitespace between an expression and
                the element on the next line, which rendered a real "untilTue 8 Sept"
                the first time this shipped. Explicit boxes with a gap cannot have
                that bug, and they wrap onto their own lines cleanly on a phone. */}
            <span class="hub-until-rest">
                {until.connector && <span class="hub-until-connector">{until.connector}</span>}
                <time class="hub-until-date" datetime={until.iso}>{until.when}</time>
                {until.label && <span class="hub-until-label">&mdash; {until.label}</span>}
            </span>
        </p>
    )}

    <hr class="studio-rule">

    {/* ============================================================
        THINKING OF YOU

        ABOVE THE ROOMS, deliberately. Everything below this needs a tap
        and then a page and then attention. This needs none — it is the
        one thing on the hub that has already happened by the time she
        reads it, and the one thing she can answer without having words.

        The outcome notices live here rather than at the top of the page
        because both endpoints 303 back with a fragment, so she lands on
        the block she acted on and the message is right where she is
        looking. `role="status"` announces them without stealing focus.
        ============================================================ */}
    <section class="tg-block" id="thinking" aria-labelledby="thinking-head">
        <p class="tg-eyebrow" id="thinking-head">no words needed</p>

        {errText && (
            <p class="tg-notice" data-kind="bad" role="status">hm &mdash; {errText}</p>
        )}
        {okText && !errText && (
            <p class="tg-notice" data-kind="ok" role="status">{okText}</p>
        )}

        <div class="tg-think">
            {incoming ? (
                /* The sentence. It is the loudest thing in this block because
                   somebody chose to send it today. */
                <p class="tg-think-line">{incoming}</p>
            ) : (
                /* THE EMPTY STATE IS A REAL SENTENCE, not a blank space and not
                   a zero — same discipline as the hub's "nothing new since you
                   were last here" line. It is also the state she will see most
                   often, so it has to read as deliberate. */
                <p class="tg-think-line tg-think-line--quiet">
                    {/* JUST THE FACT. It used to append "One tap counts as a whole message." —
                        the same failing as the greeting's second line: a neat aphorism explaining
                        the feature back to her, in a register neither of them uses. The button
                        below already says "I'm thinking of you"; a sentence justifying it turns
                        the empty state into marketing for the thing she is looking at.
                    
                        It still has to be a real sentence rather than a blank — she sees this
                        state more than any other. It just does not need to editorialise. */}
                    Nothing from {words.them} today.
                </p>
            )}

            {/* A real form that 303s back. The script upgrades it to a fetch so a
                one-tap gesture does not cost a page navigation and her scroll
                position, but everything works with the script absent. `?a=` is
                not needed here: /api/us/thinking has exactly one action and
                hard-codes its own fragment. */}
            <form class="tg-think-form" id="think-form" method="post" action="/api/us/thinking">
                <button class="tg-btn tg-send" id="think-send" type="submit">
                    I&rsquo;m thinking of you
                </button>
            </form>

            {/* Her own receipt, so a tap visibly landed even though the coalesce
                means a second one changes nothing. Repainted by the script after
                a successful fetch. */}
            <p class="tg-think-sent" id="think-sent">{outgoing}</p>

            {/* The script's announcement channel. aria-live so the outcome is
                spoken without moving focus; visually hidden because the button
                and the line above already show it, and a duplicated sentence on
                screen would be noise. */}
            <p class="tg-sr" id="think-status" role="status" aria-live="polite"></p>
        </div>
    </section>

    <hr class="studio-rule">

    <p class="studio-kicker">what&rsquo;s in here</p>

    {/* Directly above the cards it describes, because it is a summary of them and
        not an announcement about the site. `data-any` only changes emphasis — the
        two states have entirely different words, so nothing depends on noticing a
        shade of grey. */}
    {fresh.line && <p class="hub-status" data-any={fresh.any ? 'yes' : 'no'}>{fresh.line}</p>}

    <div class="room-grid">
        {rooms.map((room) => (
            room.ready ? (
                <a class:list={['room', { 'is-fresh': !!room.fresh }]} href={room.href}>
                    <span class="room-n">{room.n}</span>
                    <h2 class="room-title">{room.title}</h2>
                    <p class="room-note">{room.note}</p>
                    {/* Inside the <a>, so the words join the link's accessible name:
                        "01, one day two songs, ..., something new in here" is
                        exactly what a screen reader should hear before following it. */}
                    {room.fresh && (
                        <p class="room-fresh">
                            <span class="room-fresh-dot" aria-hidden="true"></span>{room.fresh}
                        </p>
                    )}
                </a>
            ) : (
                /* A <div> rather than an <a aria-disabled>: a disabled link is
                   still a link to a keyboard and to most screen readers, and
                   aria-disabled does not stop activation. No href, no problem. */
                <div class="room" aria-disabled="true">
                    <span class="room-soon">soon</span>
                    <span class="room-n">{room.n}</span>
                    <h2 class="room-title">{room.title}</h2>
                    <p class="room-note">{room.note}</p>
                </div>
            )
        ))}
    </div>

    <hr class="studio-rule">

    {/* ============================================================
        THE DAILY QUESTION

        EVERY `VisibleDay` ON THIS PAGE CAME OUT OF visibleDay(). Nothing
        below reads a raw DayRecord, so `theirs` is only ever a non-empty
        string when the server decided both of them had answered. The
        sealed branch does not hide their answer — it never received one.
        Read the block comment in the frontmatter.
        ============================================================ */}
    <section class="tg-block" id="question" aria-labelledby="question-head">
        {/* Sunday's slot IS the week prompt — see WEEK_PROMPT in together.ts
            for why that is a seventh of this feature and not a second one. The
            eyebrow has to change with it, or the page calls a look back at
            seven days "today's question" and the ritual reads as an accident. */}
        <p class="tg-eyebrow" id="question-head">
            {isWeekPrompt(dayToday.date)
                ? <Fragment>sunday &middot; look back at the week, then you both see</Fragment>
                : <Fragment>today&rsquo;s question &middot; you both answer, then you both see</Fragment>}
        </p>

        <div class="tg-q">
            <h2 class="tg-q-prompt">{dayToday.prompt}</h2>
            <p class="tg-q-day">{dayLabel(dayToday.date)}</p>

            {dayToday.revealed ? (
                /* BOTH ANSWERED. The only branch in which a `theirs` string
                   exists at all. Mirrored accents, and each half is titled
                   with a word so the two are never told apart by colour. */
                <div class="tg-pair">
                    <article class="tg-a tg-a--mine">
                        <p class="tg-a-who">you said</p>
                        {answerParagraphs(dayToday.mine).map((p) => (
                            <p class="tg-a-text">{p}</p>
                        ))}
                    </article>
                    <article class="tg-a tg-a--theirs">
                        <p class="tg-a-who">{themWord} said</p>
                        {answerParagraphs(dayToday.theirs).map((p) => (
                            <p class="tg-a-text">{p}</p>
                        ))}
                    </article>
                </div>
            ) : dayToday.mine ? (
                /* MINE IS IN, THEIRS IS NOT. My own words come back to me —
                   you can always read what you wrote — and the other card
                   says what is missing rather than sitting empty. */
                <>
                    <div class="tg-pair">
                        <article class="tg-a tg-a--mine">
                            <p class="tg-a-who">you said</p>
                            {answerParagraphs(dayToday.mine).map((p) => (
                                <p class="tg-a-text">{p}</p>
                            ))}
                        </article>
                        <article class="tg-a tg-a--sealed">
                            <p class="tg-a-who">{themWord} hasn&rsquo;t answered yet</p>
                            <p class="tg-a-sealed-note">
                                When {themWord} does, both answers appear here at the
                                same time. Yours is not shown to {themWord} until then
                                either.
                            </p>
                        </article>
                    </div>
                    {/* Editing is allowed only until the reveal — see
                        VisibleDay.editable. Offered as a <details> so an answered
                        day looks answered rather than like a big open form. */}
                    {dayToday.editable && (
                        <details class="tg-more">
                            <summary>change what you said</summary>
                            <form
                                class="tg-form"
                                id="answer-form"
                                method="post"
                                action="/api/us/together?a=answer"
                            >
                                <input type="hidden" name="action" value="answer">
                                <input type="hidden" name="date" value={dayToday.date}>
                                <div class="tg-field">
                                    <label class="tg-label" for="answer-text">
                                        {answerLabel}
                                    </label>
                                    <textarea
                                        class="tg-textarea"
                                        id="answer-text"
                                        name="text"
                                        rows="4"
                                        maxlength={ANSWER_MAX}
                                    >{dayToday.mine}</textarea>
                                </div>
                                <button class="tg-btn" id="answer-send" type="submit">
                                    replace it
                                </button>
                                <p class="tg-notice" id="answer-status" role="status" aria-live="polite" hidden></p>
                            </form>
                        </details>
                    )}
                </>
            ) : (
                /* I HAVE NOT ANSWERED. A box, and nothing else — not even
                   whether they have, until after I commit. */
                <>
                    {dayToday.theyAnswered && (
                        /* A FACT, NOT THEIR WORDS. This is the one thing allowed
                           out while a day is sealed, and it is the entire call to
                           action. It leaks nothing about what they said. */
                        <p class="tg-notice" data-kind="ok">
                            {sentenceCase(themWord)} has answered. Yours is the missing half.
                        </p>
                    )}
                    <form
                        class="tg-form"
                        id="answer-form"
                        method="post"
                        action="/api/us/together?a=answer"
                    >
                        <input type="hidden" name="action" value="answer">
                        <input type="hidden" name="date" value={dayToday.date}>
                        <div class="tg-field">
                            <label class="tg-label" for="answer-text">
                                {answerLabel}
                            </label>
                            {/* maxlength matches ANSWER_MAX, which the endpoint also
                                checks. The browser stopping her at the limit is
                                friendlier than the server refusing a sentence she has
                                already written. */}
                            <textarea
                                class="tg-textarea"
                                id="answer-text"
                                name="text"
                                rows="4"
                                maxlength={ANSWER_MAX}
                                placeholder="a sentence is plenty"
                            ></textarea>
                        </div>
                        <button class="tg-btn" id="answer-send" type="submit">answer it</button>
                        <p class="tg-notice" id="answer-status" role="status" aria-live="polite" hidden></p>
                    </form>
                </>
            )}

            {!dayToday.revealed && (
                /* Without this line, "your answer is in, nothing here yet" reads
                   like a bug rather than like the mechanic. */
                <p class="tg-q-rule">
                    neither answer shows up until both are in
                </p>
            )}

            {/* ---- the days before ----------------------------------------
                A native <details>, so it collapses with no JavaScript at all.
                Bounded at HUB_DAY_WINDOW days, which is a LAYOUT limit and not
                a retention policy — nothing is ever deleted from the store. */}
            {pastDays.length > 0 && (
                <details class="tg-more">
                    <summary>
                        the ones before
                        {stillOpen > 0 && <> &mdash; {stillOpen} still open to you</>}
                    </summary>
                    <ul class="tg-past">
                        {pastDays.map((d) => (
                            <li class="tg-past-item">
                                <p class="tg-past-day">{dayLabel(d.date)}</p>
                                <p class="tg-past-prompt">{d.prompt}</p>

                                {d.revealed ? (
                                    <div class="tg-pair">
                                        <article class="tg-a tg-a--mine">
                                            <p class="tg-a-who">you</p>
                                            {answerParagraphs(d.mine).map((p) => (
                                                <p class="tg-a-text">{p}</p>
                                            ))}
                                        </article>
                                        <article class="tg-a tg-a--theirs">
                                            <p class="tg-a-who">{themWord}</p>
                                            {answerParagraphs(d.theirs).map((p) => (
                                                <p class="tg-a-text">{p}</p>
                                            ))}
                                        </article>
                                    </div>
                                ) : d.canAnswer ? (
                                    /* STILL ANSWERABLE. The invitation, and the
                                       reveal works exactly as it would have on the
                                       day — which is what stops a missed day from
                                       being a dead end with her words locked in it. */
                                    <form
                                        class="tg-form"
                                        method="post"
                                        action="/api/us/together?a=answer"
                                    >
                                        <input type="hidden" name="action" value="answer">
                                        <input type="hidden" name="date" value={d.date}>
                                        <div class="tg-field">
                                            <label class="tg-label" for={`late-${d.date}`}>
                                                {d.theyAnswered
                                                    ? `${themWord} answered this one — yours would open it`
                                                    : 'you can still answer this one'}
                                            </label>
                                            <textarea
                                                class="tg-textarea"
                                                id={`late-${d.date}`}
                                                name="text"
                                                rows="3"
                                                maxlength={ANSWER_MAX}
                                            ></textarea>
                                        </div>

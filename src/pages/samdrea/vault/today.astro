---
/**
 * /samdrea/vault/today — line 01. One day, two songs.
 *
 * ---------------------------------------------------------------------------
 * WHAT THIS PAGE IS NOW, AND WHAT IT USED TO BE
 *
 * It used to be "song of the day, plus what she sent back". Structurally that was
 * a broadcast with an answer stapled underneath: my card first, at full size, with
 * her half rendered below a horizontal rule under the heading "what you sent
 * back". Both of us were posting a song a day even then — the framing just made
 * one of them secondary.
 *
 * A DAY IS NOW A PAIR. Two slots, side by side, same card template rendered twice
 * (see `slots` below — it is literally one loop, which is the only way to
 * guarantee neither side drifts into being the important one). Neither half waits
 * for the other, neither is an answer to the other, and the empty slot is the
 * ORDINARY case rather than an error: for most of a year exactly one of us will
 * have posted by the time the other opens this page.
 *
 * The empty slot is also where the action is. Hers holds the form; mine says, in
 * her language, that I have not picked one yet. No red, no "waiting", no word that
 * implies either of us is late.
 *
 * ---------------------------------------------------------------------------
 * THE SESSION IS RE-VERIFIED HERE, AND THAT IS NOT THEATRE
 *
 * src/middleware.ts has already checked a signed, unexpired token for anything
 * under /samdrea/vault, or this render never happened. The check below is what
 * makes a routing mistake up there degrade to "she gets sent to the gate" instead
 * of "the internet gets her songs". If NEEDS_SESSION ever stops matching this
 * path, this page still refuses to render. Copied verbatim from the vault hub so
 * there is one pattern to audit rather than two.
 *
 * `session` specifically, NOT `session ?? admin`. My admin token cannot open this
 * page, which is a deliberate and slightly inconvenient choice: the vault is hers,
 * that is one rule, and one rule is worth more than the convenience of previewing
 * her page without answering the questions. /samdrea/dj renders its own preview
 * of the same pair for exactly this reason.
 *
 * ---------------------------------------------------------------------------
 * IT READS THE STORE DIRECTLY, NOT ITS OWN API
 *
 * This page is server-rendered, so calling /api/us/song from here would mean the
 * server making an HTTP request to itself, forwarding her cookie, and paying a
 * round trip to reach a module it can just import. /api/us/song exists for the
 * client (see the rollover probe at the bottom); the page uses the store.
 *
 * ---------------------------------------------------------------------------
 * IT WORKS WITH JAVASCRIPT OFF
 *
 * Every reaction and the posting form are real <form method="post"> elements that
 * 303 back here and re-render from the store. The script at the bottom upgrades
 * them to fetches so the page does not jump, and that is ALL it does. A
 * press-and-hold or a click-handler-on-a-div would have made the only path to
 * posting a scripted one; this way the enhancement is genuinely optional.
 *
 * ---------------------------------------------------------------------------
 * THE ONE RULE
 *
 * The album art is the only warm, saturated thing on this page — on BOTH cards.
 * No filter, no tint, no blend mode, no overlay, and not on Spotify's embeds
 * either. The blue is light in the room around them. See the header of
 * public/css/us-song.css.
 * ---------------------------------------------------------------------------
 */
import { HER_NAME, SESSION_SECRET } from '../../../lib/us/config';
import { readCookie, verify } from '../../../lib/us/session';
import { touch } from '../../../lib/us/presence';
import { identify } from '../../../lib/us/together';
import {
  REACTIONS,
  WING_TZ,
  agoLabel,
  durationLabel,
  emptyPair,
  getExchange,
  isWingDate,
  resurface,
  storeTier,
  summarize,
  wingDate,
  wingDateLabel,
  type DayPair,
  type Rhythm,
  type Side,
  type TrackRecord,
} from '../../../lib/us/kv';

export const prerender = false;

const secret = SESSION_SECRET();
const session = secret ? verify(secret, 'session', readCookie(Astro.cookies, 'session', Astro.url)) : null;

if (!session) return Astro.redirect('/samdrea', 302);

/* PRESENCE, WRITE ONLY. This page shows no presence line — a note about
   somebody else arriving would pull her out of the thing she came here to
   read. But time spent here is still time spent in the wing, so it stamps
   without reading. Without this, twenty minutes on this page would look
   like twenty minutes away, and the hub would tell him she had left.

   Never awaited for its value and never able to throw: presence.ts
   resolves to undefined on every failure path, including no Upstash. */
const _seenBy = identify(Astro.cookies, Astro.url) ?? 'her';
await touch(_seenBy);

const her = HER_NAME();
const today = wingDate();

/** How many DAYS the archive renders. Matches ARCHIVE_LIMIT in /api/us/song. */
const ARCHIVE_LIMIT = 60;

/**
 * How far back the COUNTING goes. 365, which is also the ceiling getSongs()
 * enforces, so this is "everything there is" rather than an arbitrary window.
 *
 * Deliberately larger than ARCHIVE_LIMIT, and the reason is honesty: a total
 * computed over the sixty rows we happened to render would silently mean "sixty"
 * forever once the archive passed sixty days, and a number two people read as a
 * fact about themselves must not quietly be a fact about a page-size constant.
 *
 * The cost is real but small, and it is smallest on the tier that is actually
 * live: R2 stores the entire history in ONE JSON object, so reading 365 days costs
 * exactly what reading 60 does. On the Upstash tier it widens two MGETs and one
 * pipeline of HKEYS — still two round trips, more bytes. That is the price of a
 * true total and it is worth it.
 */
const HISTORY_WINDOW = 365;

/**
 * Everything, in one composite read, already folded into days.
 *
 * `todayPair` is whatever is filed under today's date — never "the most recent
 * day". Promoting yesterday would be a small lie that makes the whole feature
 * untrustworthy: she would have no way to tell a day I posted from a day I forgot,
 * and the honest empty slot is a better artifact than a quietly stale card.
 */
let pairs: DayPair[] = [];
let storeUnreachable = false;
try {
  ({ pairs } = await getExchange(HISTORY_WINDOW));
} catch (err) {
  console.error('[us] today page could not read the store:', err);
  storeUnreachable = true;
}

const todayPair = pairs.find((p) => p.date === today) ?? emptyPair(today);
/* Sliced here, not in the store call: getExchange's limit caps each SIDE's
   history, so the number of days it returns can exceed it when the two histories
   do not overlap. The counting below wants every day; only the rendering is
   capped. */
const archive = pairs.filter((p) => p.date !== today).slice(0, ARCHIVE_LIMIT);

const currentReactions = new Set(todayPair.reactions);

/**
 * The numbers, derived in kv.ts rather than here.
 *
 * Same reason the calendar lives there: /samdrea/dj states the streak too, and
 * two implementations of "how many days in a row" would eventually disagree by one
 * with no way to tell which page was lying.
 */
const rhythm: Rhythm = summarize({ today, pairs });

/**
 * One old day, brought back — the whole day, both halves. Null when the archive is
 * too young for it to mean anything; see RESURFACE_MIN_AGE_DAYS in kv.ts.
 */
const again = resurface({ today, pairs });

/* Outcomes from the no-JavaScript reaction and posting paths, which arrive back
   here as a 303 with ?e=<code>. Written in her language, not in HTTP: she does not
   need to know what a 502 is, only that it was not her fault and it is worth
   another try. Both endpoints land here, so every message has to make sense for a
   tapped emoji AND for a pasted link. */
const errorCode = Astro.url.searchParams.get('e') ?? '';
const ERRORS: Record<string, string> = {
  store: "that didn't save — not your fault. try it again?",
  rate: 'okay, easy on the buttons. give it a minute.',
  unauthorized: 'your session ran out. answer the questions again and you are back in.',
  unconfigured: 'something is unplugged on my end. not your fault.',
  'bad-url': "that isn't a spotify TRACK link — use Share, then Copy link, from the song itself.",
  'bad-request': "the server couldn't read that. try again?",
  'bad-date': 'that day is not a real day.',
  'future-date': "that day hasn't happened yet.",
  /* Both of these were falling through to the generic sentence. Only a
     hand-made request reaches them, but a wrong-but-specific answer is
     cheaper to write than to diagnose later. */
  'bad-reaction': "that isn't one of the five. tap one of the buttons instead?",
  'cross-site': 'that came from somewhere I do not recognise.',
};
const errorText = errorCode ? (ERRORS[errorCode] ?? "that didn't go through. try again?") : '';

/* The posting form's success path: /api/us/reply 303s back with ?sent=<date>.
   The query parameter keeps its old name because the endpoint does — see that
   file's header on why the wire vocabulary and the product vocabulary diverge.

   VALIDATED BEFORE IT IS PRINTED, not merely escaped. Astro escapes it either way
   so there was never an injection here, but wingDateLabel() returns anything that
   is not a wing date verbatim — so an unvalidated value put whatever text was in
   the URL inside a green "posted" confirmation. A confirmation is the one place a
   page should not be repeating a stranger's words back. An invalid value now
   produces no banner at all, which is the honest answer: we cannot confirm a day
   that is not a day. */
const sentParam = Astro.url.searchParams.get('sent') ?? '';
const sentDate = isWingDate(sentParam) ? sentParam : '';

/** e.g. `7:42 am`. Only shown when we actually recorded a time. */
function postedAtLabel(ms: number): string {
  if (!ms) return '';
  return new Intl.DateTimeFormat('en-US', {
    timeZone: WING_TZ,
    hour: 'numeric',
    minute: '2-digit',
  })
    .format(new Date(ms))
    .toLowerCase();
}

/**
 * Album, year, length — whichever of them we actually know.
 *
 * Returns an ARRAY rather than a joined string so the template can decide the
 * separator, and returns an EMPTY array rather than placeholders when nothing is
 * known. That is the whole contract of these fields: they exist only when the
 * Spotify Web API credentials do, so the entire pre-credential archive has none of
 * them and the correct rendering of "unknown" is no line at all — never "Unknown
 * album · —".
 */
function metaBits(track: TrackRecord): string[] {
  return [track.album ?? '', track.year ?? '', durationLabel(track.durationMs)].filter(Boolean);
}

/** Reaction glyphs for a day, plus the same thing in words for a screen reader. */
function reactionGlyphs(keys: readonly string[]): { glyphs: string; words: string } {
  const chosen = REACTIONS.filter((r) => keys.includes(r.key));
  return {
    glyphs: chosen.map((r) => r.emoji).join(' '),
    words: chosen.map((r) => r.label).join(', '),
  };
}

/* ============================================================================
   THE TWO SLOTS

   ONE ARRAY, ONE LOOP, ONE CARD TEMPLATE. This is the actual mechanism behind
   "both songs, equal weight" — not a pair of visually-matched blocks that a future
   edit could pull apart, but a single template that literally cannot render one
   side differently from the other except where this data says so.

   Everything that legitimately differs between the two halves is a STRING in
   here: whose it is, and what the slot says when it is empty. Everything else —
   the grid, the art treatment, the type, the player, the meta line — is shared by
   construction.

   The words are second person because this page is written to her: `me` is mine,
   `you` is hers. kv.ts's Side type stays 'his'/'hers' precisely so that the fixed
   identity and the page's voice are two different things, and /samdrea/dj can say
   "me" and "her" from the same records.
   ========================================================================= */

interface Slot {
  /** Fixed identity. Drives the CSS modifier and the reaction placement. */
  side: Side;
  /** The word on the card, in this page's voice. */
  who: string;
  track: TrackRecord | null;
  /** What the slot says when nobody has posted in it. Never "late", never red. */
  open: string;
  /** The quieter second line under that. */
  openSub: string;
  /** Shown in place of a title Spotify would not give us. */
  unnamed: string;
}

const slots: Slot[] = [
  {
    side: 'his',
    who: 'me',
    track: todayPair.his,
    open: storeUnreachable ? "I can’t see today from here." : "I haven’t picked one yet.",
    openSub: storeUnreachable
      ? "There may well be one. The shelf just isn’t answering."
      : "Not yet, anyway.",
    unnamed: "a song I couldn’t name",
  },
  {
    side: 'hers',
    who: 'you',
    track: todayPair.hers,
    /* BOTH SIDES HEDGE ON AN OUTAGE, and hers is the one that has to.
       When getExchange() throws, todayPair is emptyPair() — so an unhedged empty
       slot would tell her "your side of today is open", open the form and offer
       "pick one" about a day she may have already posted on. That is the page
       stating a fact about her own history that it cannot currently see, which is
       exactly the failure the store's read policy exists to avoid. It is also
       worse than the mirror-image case on my side: mine is a claim about me, hers
       is a claim about her, made to her. */
    open: storeUnreachable ? "I can’t see your side from here." : 'Your side of today is open.',
    openSub: storeUnreachable
      ? "If you already posted one, it’s still there. The shelf just isn’t answering."
      : "Whenever you feel like it.",
    unnamed: "a song Spotify wouldn’t name",
  },
];

/* The disclosure and the button, which for the same reason must not claim she has
   not posted when we simply cannot tell. Computed here rather than inline so both
   of them come from ONE decision. */
const herSummary = storeUnreachable
  ? 'post one anyway'
  : todayPair.hers
    ? 'post a different one'
    : 'pick one';
const herSubmit = !storeUnreachable && todayPair.hers ? 'replace it' : 'post it';

/**
 * The stat strip.
 *
 * EVERY CELL IS CONDITIONAL, AND THAT IS THE REQUIREMENT RATHER THAN A FLOURISH.
 * A first-day page must not read "0 days · 0 in a row · I sent 0 · you sent 0".
 * Four zeroes is a page telling her this is empty and probably broken. So a cell
 * that would print a zero is not rendered at all, and when nothing qualifies the
 * whole strip disappears and the honest empty slots carry the page.
 *
 * ONE STREAK, AND IT IS THE SHARED ONE. There is deliberately no cell for "days I
 * posted in a row" alongside "days we both did": two streak numbers on one page
 * invites a comparison between two people who are not competing, and the smaller
 * mutual number is the one that measures the thing this feature is for. See
 * Rhythm.both in kv.ts.
 */
const stats: Array<{ label: string; value: string; hint?: string }> = [];
const since = rhythm.first ? `since ${wingDateLabel(rhythm.first, { withYear: true })}` : undefined;
if (rhythm.both > 0) {
  stats.push({
    label: 'both of us',
    value: String(rhythm.both),
    hint: since,
  });
} else if (rhythm.days > 0) {
  // Nothing mutual yet. Still say how long this has been going, because "day one"
  // and "day nine, and we keep missing each other" are different facts.
  stats.push({ label: rhythm.days === 1 ? 'day' : 'days', value: String(rhythm.days), hint: since });
}
if (rhythm.streak > 1) {
  // `> 1` and not `> 0`: "1 in a row" is not a streak, it is a Tuesday.
  stats.push({
    label: 'in a row',
    value: String(rhythm.streak),
    hint: rhythm.streakLive ? 'both of us' : 'through yesterday',
  });
}
/** Both sides get a cell, built by the same expression, or neither would. */
const sideCell = (label: string, count: number) =>
  count > 0
    ? {
        label,
        value: String(count),
        hint:
          rhythm.days > 1
            ? count === rhythm.days
              ? `all ${rhythm.days} days`
              : `of ${rhythm.days}`
            : undefined,
      }
    : null;
for (const cell of [sideCell('I sent', rhythm.his), sideCell('you sent', rhythm.hers)]) {
  if (cell) stats.push(cell);
}

/* ============================================================================
   ONE DAY, AS UP TO TWO SMALL LINKS

   Used by the archive AND by the resurfaced day, because they are the same thing
   at different sizes and two builders would eventually disagree about what a day
   looks like.

   Each side is its own <a>, and that is a capability the pair layout handed back:
   the old archive row was one big <a> wrapping everything, so her half could only
   ever be plain text inside it — an <a> inside an <a> is invalid HTML and browsers
   resolve it by dropping one, unpredictably. Two sibling links means both songs
   are reachable.
   ========================================================================= */

interface Mini {
  side: Side;
  who: string;
  track: TrackRecord;
  /** The whole row's meaning, for one link. Escaped by Astro on render. */
  label: string;
  /** Her reactions, on the track they were given to. '' elsewhere. */
  glyphs: string;
}

function minisFor(pair: DayPair): Mini[] {
  const day = wingDateLabel(pair.date, { withYear: true });
  const out: Mini[] = [];

  if (pair.his) {
    const { glyphs, words } = reactionGlyphs(pair.reactions);
    out.push({
      side: 'his',
      who: 'me',
      track: pair.his,
      glyphs,
      label: [
        day,
        `mine: ${pair.his.title || "a song I couldn’t name"}`,
        words ? `you said: ${words}` : '',
        'opens in Spotify',
      ]
        .filter(Boolean)
        .join('. '),
    });
  }

  if (pair.hers) {
    out.push({
      side: 'hers',
      who: 'you',
      track: pair.hers,
      // Reactions are one-directional by design — /api/us/react takes her session
      // and refuses my admin token, so a reaction on her own song does not exist.
      // The cell is simply absent rather than rendered empty.
      glyphs: '',
      label: [
        day,
        `yours: ${pair.hers.title || "a song Spotify wouldn’t name"}`,
        'opens in Spotify',
      ].join('. '),
    });
  }

  return out;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- viewport-fit=cover is REQUIRED for env(safe-area-inset-*) to be
         anything but 0. The pages set apple-mobile-web-app-status-bar-style
         to black-translucent, so iOS draws content UNDER the notch and the
         home indicator; without this attribute there is no opt-out AND no
         way to pad around it, so the studio's "exit" link sat behind the
         battery icon. The insets are applied in us.css and us-studio.css. -->
    <meta name="color-scheme" content="dark">
    <!-- Belt and braces: the middleware also sends X-Robots-Tag, which covers
         the redirects and JSON responses that cannot carry a meta tag. -->
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>[us]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Absolute paths: this page is at /samdrea/vault/today, so a relative
         href would resolve to /samdrea/vault/css/... and 404. us.css first —
         it owns every token us-song.css uses. -->
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/assets/us/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="[us]">
    <meta name="theme-color" content="#000000">
    <link rel="stylesheet" href="/css/us.css">
    <link rel="stylesheet" href="/css/us-song.css">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23000'/%3E%3Ctext x='16' y='23' font-family='monospace' font-size='20' font-weight='700' text-anchor='middle' fill='%233e7bff'%3E%5B%5D%3C/text%3E%3C/svg%3E">
</head>
<body class="studio">
<div class="studio-wrap">

    <p class="studio-kicker">line 01 &middot; one day, two songs</p>

    <h1 class="us-mark">
        <span class="us-mark-bracket" aria-hidden="true">[</span>today<span
              class="us-mark-bracket" aria-hidden="true">]</span>
    </h1>

    {errorText && (
        <p class="notice" data-kind="bad" role="status">hm &mdash; {errorText}</p>
    )}

    {sentDate && !errorText && (
        <p class="notice" data-kind="ok" role="status">
            posted &mdash; that's yours for {wingDateLabel(sentDate, { withYear: true })}. I'll see it.
        </p>
    )}

    {storeUnreachable && (
        <p class="notice" data-kind="bad" role="status">
            hm &mdash; I cannot reach the shelf where these live. Nothing is lost,
            it just is not answering right now. Try again in a minute.
        </p>
    )}

    {/* Dev only. She should never be shown a sentence about serverless
        instances; on my own page (/samdrea/dj) the same warning is permanent,
        because there it is actionable. */}
    {import.meta.env.DEV && storeTier() === 'memory' && (
        <p class="notice" data-kind="warn">
            dev &mdash; in-process store. Non-durable, per-instance.
        </p>
    )}

    {/* ------------------------------------------------------------------
        THE STAT STRIP

        A <dl>, because these are label/value pairs and that is what a
        description list is for — a row of <div>s would read to a screen
        reader as four unlabelled numbers. The <div> wrappers inside are
        valid HTML5 dl grouping and are what make each pair one grid cell.

        Every number here is COUNTED from stored records by summarize() in
        kv.ts. Nothing is estimated, nothing is rounded, and a cell that
        would say zero is absent instead. See the `stats` builder above.
        ------------------------------------------------------------------ */}
    {stats.length > 0 && (
        <dl class="rhythm">
            {stats.map((cell) => (
                <div class="rhythm-cell">
                    <dt class="rhythm-label">{cell.label}</dt>
                    <dd class="rhythm-value">
                        {cell.value}
                        {cell.hint && <span class="rhythm-hint">{cell.hint}</span>}
                    </dd>
                </div>
            ))}
        </dl>
    )}

    {/* ==================================================================
        THE DAY

        Two slots from one template. The <section> is labelled rather than
        headed, because the <h1> above already says which day this is and a
        second heading saying it again is noise in the outline.

        Source order is his slot then hers, and on a phone that is also
        reading order — the one place any sequence exists between the two.
        It is why every card names its side IN WORDS: nothing here depends
        on position or on colour.
        ================================================================== */}
    <section class="pair" aria-label={`both sides of ${wingDateLabel(today, { withYear: true })}`}>
        {slots.map((slot) => (
            <article
                class={`song song--${slot.side}`}
                aria-labelledby={`who-${slot.side}`}
                data-open={slot.track ? undefined : 'true'}
            >
                {/* The <h2> is the side. Both halves are therefore peers in
                    the document outline as well as on screen, which is the
                    same claim the layout makes, made where a screen reader
                    can hear it. The track title is the <h3> under it. */}
                <h2 class="song-side" id={`who-${slot.side}`}>{slot.who}</h2>

                {slot.track ? (
                    <>
                        <div class="song-head">
                            <span class="song-frame">
                                {slot.track.art ? (
                                    /* alt="" on purpose: the title and artist are
                                       right there as real text, so alt text would
                                       make a screen reader say the same thing
                                       twice. This is a decorative duplicate of
                                       adjacent content, which is exactly the case
                                       empty alt exists for.

                                       referrerpolicy="no-referrer" matches the
                                       wing's Referrer-Policy header — Spotify's
                                       CDN has no business learning the URL she is
                                       reading this on. */
                                    <img
                                        class="song-art"
                                        src={slot.track.art}
                                        alt=""
                                        width="320"
                                        height="320"
                                        loading="lazy"
                                        decoding="async"
                                        referrerpolicy="no-referrer"
                                    >
                                ) : (
                                    <span class="song-art--empty" aria-hidden="true">[ ]</span>
                                )}
                            </span>

                            <div class="song-body">
                                {/* The day is on BOTH cards, and yes that repeats
                                    it. Deliberate: each card is self-contained,
                                    the same template renders it on /samdrea/dj
                                    where there is no [today] heading above it,
                                    and someone arriving at the second <article>
                                    by keyboard or screen reader should not have to
                                    remember which day this was. The time after it
                                    is the part that actually differs. */}
                                <p class="song-day">
                                    {wingDateLabel(slot.track.date)}
                                    {postedAtLabel(slot.track.postedAt) && (
                                        <> &middot; {postedAtLabel(slot.track.postedAt)}</>
                                    )}
                                </p>

                                {slot.track.title ? (
                                    <h3 class="song-title">{slot.track.title}</h3>
                                ) : (
                                    /* Spotify's metadata call failed. The embed
                                       below still knows what the track is, so this
                                       says so plainly rather than rendering an
                                       empty heading. */
                                    <h3 class="song-title song-title--unknown">{slot.unnamed}</h3>
                                )}

                                {slot.track.artist && <p class="song-artist">{slot.track.artist}</p>}

                                {/* Album, year, length. Rendered ONLY for what we
                                    actually know: these three come from the
                                    Spotify Web API, which needs credentials that
                                    may not exist, so on the whole pre-credential
                                    archive metaBits() returns [] and this line is
                                    simply not there. A "—" placeholder would be a
                                    worse answer than silence, and an "Unknown
                                    album" label would be a lie with a straight
                                    face.

                                    <ul> rather than one string because a screen
                                    reader should read three facts as three facts.
                                    The separator is a CSS ::before on the second
                                    and later items, so it is never announced. */}
                                {metaBits(slot.track).length > 0 && (
                                    <ul class="song-meta">
                                        {metaBits(slot.track).map((bit) => <li>{bit}</li>)}
                                    </ul>
                                )}
                            </div>
                        </div>

                        {/* Both sides get the same placeholder, from the same
                            branch. A per-side wording here would be a difference
                            with no reason behind it, and every reasonless
                            difference between the two cards is a step back
                            towards one of them being the main one. */}
                        {slot.track.note ? (
                            <p class="song-note">{slot.track.note}</p>
                        ) : (
                            <p class="song-note song-note--empty">No note. Just the song.</p>
                        )}

                        {/* The official embed, on BOTH cards. `id` has been
                            through /^[A-Za-z0-9]{22}$/ twice — once when it was
                            pasted, once when it was read back out of the store —
                            before it gets near this src, which is the only reason
                            interpolating it here is safe.

                            `allow` deliberately omits autoplay: two embeds on one
                            page that could both start on their own is a page that
                            ambushes you, and the play buttons are right there. */}
                        <div class="song-player">
                            <iframe
                                src={`https://open.spotify.com/embed/track/${slot.track.id}`}
                                title={slot.track.title
                                    ? `Spotify player: ${slot.track.title}`
                                    : 'Spotify player'}
                                width="100%"
                                height="152"
                                loading="lazy"
                                allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture"
                                referrerpolicy="no-referrer"
                            ></iframe>
                        </div>

                        <p class="song-links">
                            <a
                                href={`https://open.spotify.com/track/${slot.track.id}`}
                                target="_blank"
                                rel="noreferrer noopener"
                            >open in spotify &nearr;</a>
                        </p>
                    </>
                ) : (
                    /* AN OPEN SLOT. Not an error, not a warning, not a
                       countdown — see the CSS for `.song[data-open]`. The
                       second sentence carries the honest detail so the first
                       one does not have to hedge. */
                    <p class="song-open">
                        {slot.open}
                        <span class="song-open-sub">{slot.openSub}</span>
                    </p>
                )}

                {/* --------------------------------------------------------
                    REACTIONS — inside HIS card, on the song they belong to.

                    They used to sit under the one card on the page, where
                    "did you hear it?" was unambiguous. With two songs it is
                    not, so they live on the track they answer.

                    STILL ONE-DIRECTIONAL, and honestly so: /api/us/react
                    takes her session and refuses my admin token, because a
                    tap I could write as her would mean nothing. Her card has
                    no reaction bar because no such thing exists, not because
                    it is hidden. See that file's header for what making it
                    mutual would actually take.

                    Five sibling forms, one button each. Not one form with
                    five buttons: which button submitted a multi-button form
                    depends on name/value pairs that a keyboard Enter
                    resolves differently across engines, and that is not a
                    thing worth being clever about.

                    The hidden `on` field carries the OPPOSITE of the current
                    state, so a submit is always a toggle and the server is
                    told the desired end state rather than an action. That is
                    what makes the endpoint idempotent: a double-tap, a retry
                    and a resubmitted form all land on the same value.
                    -------------------------------------------------------- */}
                {slot.side === 'his' && slot.track && (
                    <>
                        <fieldset class="react-bar">
                            <legend class="react-legend">did you hear it?</legend>
                            <div class="react-row">
                                {REACTIONS.map((r) => {
                                    const chosen = currentReactions.has(r.key);
                                    return (
                                        <form class="react-form" method="post" action="/api/us/react">
                                            <input type="hidden" name="date" value={todayPair.date}>
                                            <input type="hidden" name="reaction" value={r.key}>
                                            <input type="hidden" name="on" value={chosen ? '0' : '1'}>
                                            <button class="react" type="submit" aria-pressed={chosen ? 'true' : 'false'}>
                                                <span class="react-emoji" aria-hidden="true">{r.emoji}</span>
                                                <span class="react-label">{r.label}</span>
                                            </button>
                                        </form>
                                    );
                                })}
                            </div>
                        </fieldset>

                        {/* Where the script announces the result of a tap.
                            Visually hidden because the button's own pressed
                            state is the visible feedback; this exists so that
                            state change is also SPOKEN. */}
                        <p class="sr-only" id="react-status" role="status" aria-live="polite"></p>
                    </>
                )}

                {/* --------------------------------------------------------
                    HER FORM — inside HER slot, which is the point.

                    On a day she has not posted, the empty half of the page is
                    the thing she can act on rather than a gap with a form
                    somewhere underneath it. On a day she has, it collapses to
                    one line under her own card.

                    A real <form method="post" action="/api/us/reply"> that
                    303s back here, exactly like the reaction forms. It works
                    with JavaScript switched off; the script at the bottom
                    upgrades it to a fetch for ONE reason that actually
                    matters — a native submit that fails has already navigated
                    away and taken the note she just typed with it, and
                    retyping a paragraph on a phone is the difference between
                    doing this and not.

                    <details> rather than two markup paths: `open` when she
                    has not posted yet, closed once she has. It collapses
                    natively with no JavaScript at all.

                    THERE IS EXACTLY ONE OF THESE ON THE PAGE, which is why it
                    lives here rather than in both branches of the ternary
                    above: two copies would mean two ids and a script that has
                    to guess which one it is wired to.

                    The hidden `date` is this day, and the server validates it
                    anyway — it is a primary key and this page is not trusted
                    to have got it right.
                    -------------------------------------------------------- */}
                {slot.side === 'hers' && (
                    <details class="reply-details" open={!slot.track && !storeUnreachable}>
                        <summary class="reply-summary">{herSummary}</summary>

                        <form class="dj-form" id="reply-form" method="post" action="/api/us/reply">
                            <input type="hidden" name="date" value={todayPair.date}>

                            <div class="dj-field">
                                <label class="dj-label" for="reply-url">Spotify link</label>
                                {/* type="text" with inputmode="url", NOT
                                    type="url": the native URL validator rejects
                                    `spotify:track:...`, which the endpoint
                                    accepts, so type="url" would block a valid
                                    paste before it ever reached the server. */}
                                <input
                                    class="dj-input"
                                    id="reply-url"
                                    name="url"
                                    type="text"
                                    inputmode="url"
                                    autocomplete="off"
                                    autocapitalize="none"
                                    autocorrect="off"
                                    spellcheck="false"
                                    placeholder="open.spotify.com/track/..."
                                    aria-describedby="reply-url-hint"
                                    required
                                >
                                <p class="dj-hint" id="reply-url-hint">
                                    Share &rarr; Copy link, from the song itself. Albums and playlists
                                    won&rsquo;t work.
                                </p>
                            </div>

                            <div class="dj-field">
                                <label class="dj-label" for="reply-note">
                                    Your note <span class="dj-opt">&mdash; why this one</span>
                                </label>
                                {/* maxlength matches MAX_NOTE in the endpoint,
                                    which is the SAME cap as mine. The browser
                                    stopping her at 600 is friendlier than the
                                    server silently truncating what she wrote. */}
                                <textarea
                                    class="dj-textarea"
                                    id="reply-note"
                                    name="note"
                                    rows="4"
                                    maxlength="600"
                                ></textarea>
                            </div>

                            {/* Optional, and new: her card used to have no way to
                                carry an artist at all, so on the credential-free
                                metadata path her songs rendered one line poorer
                                than mine every single day. Same field, same cap,
                                same optional treatment as the one on my form. */}
                            <div class="dj-field">
                                <label class="dj-label" for="reply-artist">
                                    Artist <span class="dj-opt">&mdash; optional</span>
                                </label>
                                <input
                                    class="dj-input"
                                    id="reply-artist"
                                    name="artist"
                                    type="text"
                                    maxlength="120"
                                    autocapitalize="words"
                                    aria-describedby="reply-artist-hint"
                                >
                                <p class="dj-hint" id="reply-artist-hint">
                                    Spotify only gives us the title and the art. Leave it blank and
                                    we&rsquo;ll skip that line.
                                </p>
                            </div>

                            <button class="dj-submit" id="reply-submit" type="submit">{herSubmit}</button>

                            {/* The enhancement script's channel. aria-live so the
                                outcome is announced without moving focus; hidden
                                until there is something to say. */}
                            <p class="notice" id="reply-status" role="status" aria-live="polite" hidden></p>
                        </form>
                    </details>
                )}
            </article>
        ))}
    </section>

    {/* ==================================================================
        ONE OLD DAY, BROUGHT BACK

        The whole day, both halves — the old version resurfaced one of my
        songs and structurally could not bring back hers, which for a
        memory feature is the wrong thing to be incapable of.

        Absent entirely until the archive is old enough for it to mean
        something (see RESURFACE_MIN_AGE_DAYS in kv.ts), which is also why
        there is no empty state for it: a "nothing to resurface yet" box
        would be a box explaining its own absence.

        Links, not embeds. Sixty players on a page is a page that never
        finishes loading, and this is the same reasoning that keeps iframes
        out of the archive below.
        ================================================================== */}
    {again && (
        <>
            <hr class="studio-rule">

            <p class="song-eyebrow">worth playing again</p>

            <div class="again">
                <p class="archive-date">
                    {wingDateLabel(again.date, { withYear: true })} &middot; {agoLabel(again.date, today)}
                </p>
                <div class="archive-tracks">
                    {minisFor(again).map((m) => (
                        <a
                            class="mini"
                            href={`https://open.spotify.com/track/${m.track.id}`}
                            target="_blank"
                            rel="noreferrer noopener"
                            aria-label={m.label}
                        >
                            {m.track.art ? (
                                <img
                                    class="mini-thumb"
                                    src={m.track.art}
                                    alt=""
                                    width="56"
                                    height="56"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                >
                            ) : (
                                <span class="mini-thumb--empty" aria-hidden="true">[ ]</span>
                            )}
                            {/* aria-hidden throughout: every word below is
                                already in this link's aria-label, and hearing
                                it twice is worse than not hearing it once. */}
                            <span class="mini-body" aria-hidden="true">
                                <span class="mini-side">{m.who}</span>
                                <span class="mini-title">{m.track.title || 'a song with no name'}</span>
                                {m.track.note && <span class="mini-note">{m.track.note}</span>}
                                {m.glyphs && <span class="mini-reacts">{m.glyphs}</span>}
                            </span>
                        </a>
                    ))}
                </div>
            </div>
        </>
    )}

    <hr class="studio-rule">

    <p class="song-eyebrow">every day before this one</p>

    {archive.length > 0 ? (
        <ul class="archive">
            {archive.map((pair) => (
                <li class="archive-row">
                    {/* The day, once, for the whole row. Not repeated on each
                        track — it is the same day, and saying it twice is how
                        a ledger stops being readable. */}
                    <p class="archive-date">{wingDateLabel(pair.date, { withYear: true })}</p>
                    <div class="archive-tracks">
                        {minisFor(pair).map((m) => (
                            <a
                                class="mini"
                                href={`https://open.spotify.com/track/${m.track.id}`}
                                target="_blank"
                                rel="noreferrer noopener"
                                aria-label={m.label}
                            >
                                {m.track.art ? (
                                    <img
                                        class="mini-thumb"
                                        src={m.track.art}
                                        alt=""
                                        width="56"
                                        height="56"
                                        loading="lazy"
                                        decoding="async"
                                        referrerpolicy="no-referrer"
                                    >
                                ) : (
                                    <span class="mini-thumb--empty" aria-hidden="true">[ ]</span>
                                )}
                                <span class="mini-body" aria-hidden="true">
                                    <span class="mini-side">{m.who}</span>
                                    <span class="mini-title">{m.track.title || 'a song with no name'}</span>
                                    {m.track.note && <span class="mini-note">{m.track.note}</span>}
                                    {m.glyphs && <span class="mini-reacts">{m.glyphs}</span>}
                                </span>
                            </a>
                        ))}
                    </div>
                </li>
            ))}
        </ul>
    ) : (
        <p class="archive-empty">
            {storeUnreachable
                ? "The shelf isn’t answering. Nothing is lost."
                : `Nothing here yet. Day one, ${her}.`}
        </p>
    )}

    <hr class="studio-rule">

    <div class="studio-foot">
        <span class="studio-tag">Stronger for it.</span>
        <a href="/samdrea/vault">&larr; back to the room</a>
    </div>
</div>

<script is:inline define:vars={{ renderedDate: today, wingTz: WING_TZ }}>
/* --------------------------------------------------------------------------
   Three jobs, and deliberately no more.

   Rendered unconditionally rather than wrapped in a template expression: a
   <script> inside `{...}` asks the Astro compiler to read JavaScript braces as
   template braces, and the failure mode is a build error in a file that reads
   as correct. Each block below bails out on its own if its markup is absent —
   which now happens routinely, because the reaction bar only exists on a day I
   have posted and the form only exists in her slot.

   1. REACTIONS WITHOUT A PAGE JUMP. The forms already work without this — 303,
      re-render, done. This only removes the navigation.

   2. HER POST, WITHOUT LOSING WHAT SHE TYPED. This one is not cosmetic. A
      native form submit that fails has already navigated away, and the note is
      gone with it. Everything this block buys is: on failure, the paragraph is
      still in the textarea.

   3. THE DAY ROLLOVER. Her phone will keep this tab alive for a week. Without
      this, coming back to it on Tuesday shows Monday's pair with no hint that
      it is stale.
   -------------------------------------------------------------------------- */
(function () {
    var status = document.getElementById('react-status');

    /* ---- 1. reactions ------------------------------------------------- */
    var forms = Array.prototype.slice.call(document.querySelectorAll('.react-form'));

    /**
     * One request at a time, globally.
     *
     * Not politeness — correctness. On the R2 storage tier every reaction is a
     * read-modify-write of one JSON object, so two overlapping taps can have the
     * second read land before the first write and silently discard it.
     * Serializing here does not fix that race (only the store could) but it
     * removes the one way this UI could reliably cause it: an impatient thumb.
     */
    var busy = false;

    /** Repaint ALL five buttons from the server's answer, not from what we
     *  assumed would happen. One source of truth, even for optimism. */
    function paint(list) {
        var on = {};
        for (var i = 0; i < list.length; i++) on[list[i]] = true;
        forms.forEach(function (form) {
            var key = form.elements.reaction.value;
            var button = form.querySelector('.react');
            var isOn = !!on[key];
            button.setAttribute('aria-pressed', isOn ? 'true' : 'false');
            // The hidden field always carries the OPPOSITE, so the no-JS path
            // stays correct if she reloads after tapping.
            form.elements.on.value = isOn ? '0' : '1';
        });
    }

    function say(text) {
        if (status) status.textContent = text;
    }

    forms.forEach(function (form) {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            if (busy) return;

            var button = form.querySelector('.react');
            var key = form.elements.reaction.value;
            var label = (form.querySelector('.react-label') || {}).textContent || key;
            var want = form.elements.on.value === '1';

            busy = true;
            button.dataset.busy = '';

            var res, data;
            try {
                res = await fetch('/api/us/react', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        date: form.elements.date.value,
                        reaction: key,
                        on: want
                    })
                });
                data = await res.json();
            } catch (err) {
                say('that did not save. try again?');
                return;
            } finally {
                busy = false;
                delete button.dataset.busy;
            }

            if (!res.ok || !data || data.ok !== true) {
                say('that did not save. not your fault.');
                return;
            }

            paint(data.reactions || []);
            say(label + (want ? ': yes' : ': taken back'));
        });
    });

    /* ---- 2. her post --------------------------------------------------- */

    (function () {
        var form = document.getElementById('reply-form');
        var submit = document.getElementById('reply-submit');
        var out = document.getElementById('reply-status');
        // Bails out rather than throwing if the markup is ever absent. Everything
        // below is an enhancement over a form that already works.
        if (!form || !submit || !out) return;

        var MESSAGES = {
            'bad-url': "that isn't a spotify TRACK link — copy the link from the song itself.",
            'bad-date': 'that day is not a real day.',
            'future-date': "that day hasn't happened yet.",
            'bad-request': "the server couldn't read that.",
            unauthorized: 'your session ran out. answer the questions again and you are back in.',
            unconfigured: 'something is unplugged on my end. not your fault.',
            store: "that didn't save. nothing was posted. try again?",
            rate: 'give it a minute.'
        };

        function say(kind, text) {
            /* UNHIDDEN FIRST, THEN WRITTEN, and the order is the whole point. A
               `hidden` element is not in the accessibility tree, so several
               screen-reader/browser pairs never announce text that was already
               present at the moment the live region appeared — they only announce
               MUTATIONS to a region that is already there. Setting the text first
               and revealing second is the way to have an aria-live region that
               silently does nothing. */
            out.hidden = false;
            // The word is part of the message, so this never depends on colour.
            out.dataset.kind = kind;
            out.textContent = (kind === 'bad' ? 'hm — ' : 'posted — ') + text;
        }

        var label = submit.textContent;

        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            var body = {
                url: form.elements.url.value.trim(),
                note: form.elements.note.value,
                artist: form.elements.artist.value.trim(),
                date: form.elements.date.value
            };
            if (!body.url) {
                say('bad', 'paste a link first.');
                form.elements.url.focus();
                return;
            }

            submit.disabled = true;
            submit.textContent = 'posting';

            var res, data;
            try {
                res = await fetch('/api/us/reply', {
                    // JSON in, JSON out. The endpoint keys its response shape off
                    // this header, so the no-JS form POST still gets its redirect.
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(body)
                });
                data = await res.json();
            } catch (err) {
                say('bad', 'the server did not answer. nothing was posted. try again.');
                return;
            } finally {
                submit.disabled = false;
                submit.textContent = label;
            }

            if (!res.ok || !data || data.ok !== true) {
                var code = (data && data.error) || 'no';
                say('bad', MESSAGES[code] || 'that did not go through. nothing was posted.');
                return;
            }

            say('ok', data.degraded
                ? "it's up, though Spotify would not name it. The player still will."
                : "it's up. I'll see it.");

            /* Hand control back to the SERVER rather than painting her card from
               this response. Patching it here would mean a second renderer in
               JavaScript — art vs placeholder, title vs the unnamed fallback, the
               embed, the meta line — that can disagree with the Astro one, and a
               card that disagrees with the store is worse than a reload. The short
               pause is so the line above is readable first. */
            setTimeout(function () {
                window.location.assign('/samdrea/vault/today?sent=' + encodeURIComponent(data.date));
            }, 700);
        });
    })();

    /* ---- 3. the day rollover ------------------------------------------ */

    /** The same calendar rule the server used, so the two cannot disagree. */
    function clientWingDate() {
        try {
            return new Intl.DateTimeFormat('en-CA', {
                timeZone: wingTz,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
            }).format(new Date());
        } catch (err) {
            // An engine without that timezone would report a wrong date, and a
            // wrong date here means a spurious reload loop. Better to do nothing.
            return renderedDate;
        }
    }

    var checking = false;

    async function checkForNewDay() {
        if (document.hidden || checking) return;
        if (clientWingDate() === renderedDate) return;

        /* The day has changed. Ask the server what is on the shelf now — and
           note that we RELOAD rather than patch the cards in place. Patching
           would mean a second renderer in JavaScript (art vs placeholder,
           title vs the unnamed fallback, two embeds, the reaction states) that
           can disagree with the Astro one, and a page that disagrees with the
           server is worse than a flash of white. The probe is only here so a
           day with nothing posted yet does not reload her page for nothing. */
        checking = true;
        try {
            var res = await fetch('/api/us/song', {
                headers: { Accept: 'application/json' },
                credentials: 'same-origin'
            });
            if (!res.ok) return;
            var data = await res.json();
            // Reload only when the SERVER also agrees the day rolled over AND
            // there is something new to show. EITHER half counts: a new day whose
            // only content is her own song is still a page showing the wrong day.
            var pair = data && data.pair;
            if (data && data.ok && data.date !== renderedDate && pair && (pair.his || pair.hers)) {
                window.location.reload();
            }
        } catch (err) {
            /* Offline, or the store is down. Leave her page exactly as it is. */
        } finally {
            checking = false;
        }
    }

    document.addEventListener('visibilitychange', checkForNewDay);
    window.addEventListener('focus', checkForNewDay);
})();
</script>
</body>
</html>

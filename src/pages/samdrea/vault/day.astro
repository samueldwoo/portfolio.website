---
/**
 * /samdrea/vault/day — `line 04`. One photograph each, every day.
 *
 * ---------------------------------------------------------------------------
 * THE SHAPE OF THE PAGE, AND WHY IT IS TWO COLUMNS AND NOT A FEED
 *
 * Today is one row of two frames, hers and his, side by side and the same size.
 * That is the entire layout, and every alternative was worse:
 *
 *   A FEED, newest first, would put whoever posted later on top, which invents a
 *   ranking between two people who are not competing and makes "he posted first
 *   today" a visible fact with no meaning.
 *
 *   ONE BIG FRAME with the other tucked under it makes one of them the subject
 *   and the other a reply.
 *
 *   A CAROUSEL hides half the content behind a gesture to save space that a
 *   two-column grid does not need.
 *
 * Equal size, side by side, in a fixed order that never changes. Same reasoning
 * as the mutual song page, which arrived at the same answer for the same reason.
 *
 * ---------------------------------------------------------------------------
 * THE EMPTY HALF IS A REAL THING AND NOT A GAP
 *
 * Most of the time exactly one of the two frames will be missing, because they
 * are nine hours apart and one of them is asleep. So the empty half is the state
 * this page is in more often than any other, and it gets a real box with a real
 * sentence in it rather than a collapse — a grid that reflows depending on who has
 * posted makes the page feel broken by the ordinary case.
 *
 * ---------------------------------------------------------------------------
 * WHAT IS DELIBERATELY ABSENT
 *
 * No reactions, no likes, no counts, no "seen at". The studio is where a
 * photograph gets a note written about it; this is where one gets looked at. A
 * reaction affordance here would turn a glance into an obligation, and the entire
 * pitch of this feature is that it costs nothing to use.
 */

import { HER_NAME, SESSION_SECRET, hasKV } from '../../../lib/us/config';
import { readCookie, verify } from '../../../lib/us/session';
import { wingDate, wingDateLabel } from '../../../lib/us/kv';
import { touch } from '../../../lib/us/presence';
import { HER_TZ, HIS_TZ, identify, type Who } from '../../../lib/us/together';
import { stillFresh } from '../../../lib/us/fresh';
import {
  MAX_BYTES,
  NOTE_MAX,
  framesAvailable,
  getDaysSafe,
  withUrls,
  type VisibleDayFrames,
  setPlace,
} from '../../../lib/us/frames';
import { lookupPlace } from '../../../lib/us/place';
import { CARRY_DAYS, pickSlots } from '../../../lib/us/slots';

export const prerender = false;

const secret = SESSION_SECRET();
const session = secret ? verify(secret, 'session', readCookie(Astro.cookies, 'session', Astro.url)) : null;
if (!session) return Astro.redirect('/samdrea', 302);

const viewer: Who = identify(Astro.cookies, Astro.url) ?? 'her';
const them: Who = viewer === 'her' ? 'him' : 'her';
await touch(viewer);

const her = HER_NAME();
const today = wingDate();

/* ONE clock reading for the whole render, so two frames cannot be judged against
   two different "now"s and disagree about whether 07:00 has passed. */
const nowMs = Date.now();
const myTz = viewer === 'her' ? HER_TZ : HIS_TZ;
const theirTz = viewer === 'her' ? HIS_TZ : HER_TZ;

/* ---- the window -----------------------------------------------------------
   CARRY_DAYS, not FRAME_DAYS: this reads exactly as many days as the slot can
   draw. It used to read seven to render two, which was the tell that the page and
   the strip below it disagreed about what this feature was — the strip could show
   a photograph the slot had already refused to promote, so the same picture was
   both too old to headline and recent enough to display.

   One pipelined read for the metadata, then the presigns in parallel. `reachable`
   is carried through rather than swallowed: "nothing here yet" and "I could not
   ask" are different sentences and she should never be shown the first one when
   the second is true. */
const { days: stored, reachable } = await getDaysSafe(today, CARRY_DAYS);
const available = framesAvailable();
const week: VisibleDayFrames[] = available ? await withUrls(stored) : [];

/* The window is newest-first and the slot takes each person's most recent frame
   rather than strictly today's — see pickSlots in slots.ts for the timezone
   arithmetic that forces it, and for why the carry is two days and not seven. */
const picked = pickSlots(week, today, viewer);

/* ---- AND THEN 07:00 IN WHOEVER POSTED IT --------------------------------------

   pickSlots decides WHICH frame each side would show; this decides whether it is
   still worth showing. Two rules rather than one because they answer different
   questions: the first is "the most recent, within reach", the second is "has its
   morning come".

   THE EMPTY SLOT IS THE SIGNAL, and that is the whole reason for this. Under the day
   window she had to reason about midnight in New York — which falls at 06:00 for her,
   just as she wakes — to know whether posting counted as today. Now she looks: empty
   means post, full means today is done.

   PER POSTER, so each side expires on its own author's morning. Hers goes at 07:00
   Paris, which is 22:00 for him, so he keeps it through his evening. His goes at 07:00
   Los Angeles, which is 16:00 for her, so she keeps it through her whole morning
   rather than losing it at 06:00 to a boundary neither of them chose.

   HIDDEN, NOT DELETED. Both stores keep every frame exactly as posted; export:frames
   still retrieves all of them. See fresh.ts. */
const mine = picked.mine && stillFresh(picked.mine.atMs, myTz, nowMs) ? picked.mine : null;
const theirs = picked.theirs && stillFresh(picked.theirs.atMs, theirTz, nowMs) ? picked.theirs : null;
const mineFrom = mine ? picked.mineFrom : null;
const theirsFrom = theirs ? picked.theirsFrom : null;

/* ---- THE PLACE LABEL, RESOLVED LAZILY AND EXACTLY ONCE ----------------------

   This used to run inside /api/us/frame, right after the bytes were saved. Safe,
   but it put a third-party network call between her and the end of her upload — and
   she had already said uploads felt slow. Nominatim measures 0.68s cold, so that
   was most of a second added to the "sending…" state, for a caption nobody is
   waiting to read.

   Here instead: a frame that has coordinates but no label yet gets one, once, and
   it is stored. Every later render reads the stored string and asks nobody
   anything, so this is still ONE disclosure per photograph — the same count as
   before, just paid by a page view rather than by her.

   900ms, not the 2500ms an upload could afford. A page is a worse place to wait
   than a form submit, and a miss is cheap: the pin shows coordinates this time and
   the next render tries again. That retry is why a failure here needs no handling.

   Both sides in one pass, because they are independent lookups and the slower one
   should not be the sum of the two. */
if (available && reachable) {
  /* THE FRAME'S OWN DAY, NOT TODAY. The slot carries a photograph forward, so
     `mine` may live on yesterday's hash — `mineFrom` is exactly that date when it
     does and null when the frame is current. Writing the label to `today` would
     file it against a day the photograph is not on: silently lost, and on a day
     that may later hold a different photograph entirely. */
  const wanted: Array<{ who: Who; date: string; frame: NonNullable<typeof mine> }> = [];
  if (mine && mine.lat !== null && mine.lon !== null && !mine.place) {
    wanted.push({ who: viewer, date: mineFrom ?? today, frame: mine });
  }
  if (theirs && theirs.lat !== null && theirs.lon !== null && !theirs.place) {
    wanted.push({ who: them, date: theirsFrom ?? today, frame: theirs });
  }
  if (wanted.length) {
    await Promise.all(
      wanted.map(async ({ who: w, date, frame }) => {
        const label = await lookupPlace({ lat: frame.lat!, lon: frame.lon! }, 900);
        if (!label) return;
        /* Mutating the object the markup below reads, so the label appears on THIS
           render rather than only the next one. setPlace never throws. */
        frame.place = label;
        await setPlace(date, w, label);
      }),
    );
  }
}

/* ---- outcomes from the no-JavaScript path ---------------------------------
   Both paths land back here as a 303 with ?ok= or ?e=, written in her language
   rather than in HTTP. */
const okCode = Astro.url.searchParams.get('ok') ?? '';
const errCode = Astro.url.searchParams.get('e') ?? '';

const ERRORS: Record<string, string> = {
  'no-photo': 'no photograph came through. Pick one and try again?',
  'too-big': `that one is bigger than ${Math.round(MAX_BYTES / (1024 * 1024))}MB. A screenshot of it would work, or try again with JavaScript on and it will shrink it for you.`,
  'not-an-image': "I could not read that as a photograph. If it came straight off an iPhone it may be a HEIC — opening it and re-saving, or screenshotting it, both work.",
  'bad-upload': 'that upload cut out partway. Usually just signal — try it again?',
  store: "that didn't save, and it is not your fault. Try again?",
  rate: 'okay, easy. Give it a minute.',
  unauthorized: 'your session ran out. Answer the questions again and you are back in.',
  unconfigured: 'something is unplugged on my end. Not your fault.',
  'cross-site': 'that request came from somewhere I do not recognise.',
};
const errText = errCode ? (ERRORS[errCode] ?? "that didn't go through. Try again?") : '';
const posted = okCode === 'posted' && !errText;

/**
 * `?ok=maybe` — THE HONEST THIRD OUTCOME, and it only ever comes from the script.
 *
 * An upload can end in a state that is genuinely neither "posted" nor "failed": the
 * request passed the 45s deadline, or the answer came back unreadable. In both cases the
 * photograph MAY be saved, because the server writes bytes before it replies, and there
 * is no way from the page to find out which happened.
 *
 * It used to reload with no query at all, which is a lie by omission. She had just
 * waited a minute and the page came back with nothing to say — the same silence that
 * made her count to sixty and refresh by hand in the first place. "I cannot tell, look
 * below" is a worse-sounding message and a much better one: it names the uncertainty and
 * points at the thing that settles it.
 *
 * `warn` rather than `bad`, because claiming failure would be as wrong as claiming
 * success, and it is the register the carried-frame notices already use.
 */
const maybe = okCode === 'maybe' && !errText && !posted;

/* ---- copy ----------------------------------------------------------------- */

/** `18:42`, in the poster's own timezone. Absent when the store could not say. */
function clockOf(atMs: number, tz: string): string {
  if (!atMs) return '';
  try {
    return new Intl.DateTimeFormat('en-GB', {
      timeZone: tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).format(new Date(atMs));
  } catch {
    return '';
  }
}

/**
 * The weekday of an instant, in the POSTER'S own zone.
 *
 * A weekday rather than a date: "Thu" is what a person reads at a glance, and the
 * carry window is two days, so there is no ambiguity a full date would resolve.
 * See the caption for why this is anchored to the taker and not to the wing.
 */
function dayOf(atMs: number, tz: string): string {
  if (!atMs) return '';
  try {
    return new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'short' }).format(new Date(atMs));
  } catch {
    return '';
  }
}

/**
 * Whose half of the day this is: 'you', her name, or his.
 *
 * 'Sam' rather than 'him', matching the hub's clock strip and today.astro's card
 * title. It was the only page left calling him by a pronoun in a position where
 * her side got a name.
 */
const whoWord = (w: Who): string => (w === viewer ? 'you' : w === 'her' ? (her || 'her') : 'Sam');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- viewport-fit=cover is REQUIRED for env(safe-area-inset-*) to be
         anything but 0. The pages set apple-mobile-web-app-status-bar-style
         to black-translucent, so iOS draws content UNDER the notch and the
         home indicator; without this attribute there is no opt-out AND no
         way to pad around it, so the studio's "exit" link sat behind the
         battery icon. The insets are applied in us.css and us-studio.css. -->
    <meta name="color-scheme" content="dark">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>[us] — today, seen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/assets/us/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="[us]">
    <meta name="theme-color" content="#000000">
    <!-- us.css first: it owns every token the others use. -->
    <link rel="stylesheet" href="/css/us.css">
    <link rel="stylesheet" href="/css/us-song.css">
    <link rel="stylesheet" href="/css/us-frames.css">
    <script src="/us-pull.js" defer></script>
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2032%2032%27%3E%3Crect%20width%3D%2732%27%20height%3D%2732%27%20fill%3D%27%23000%27%2F%3E%3Ctext%20x%3D%2716%27%20y%3D%2722.5%27%20font-family%3D%27Helvetica%2CArial%2Csans-serif%27%20font-size%3D%2716%27%20font-weight%3D%27700%27%20text-anchor%3D%27middle%27%3E%3Ctspan%20fill%3D%27%233e7bff%27%3E%5B%3C%2Ftspan%3E%3Ctspan%20fill%3D%27%23fff%27%3Eus%3C%2Ftspan%3E%3Ctspan%20fill%3D%27%233e7bff%27%3E%5D%3C%2Ftspan%3E%3C%2Ftext%3E%3C%2Fsvg%3E">
</head>
<body class="studio">
<div class="studio-wrap">

    {/* 03 while letters is benched — the numbers are positions, not ids. See the
        comment on the rooms array in vault/index.astro. */}
    <p class="studio-kicker">03 &middot; today, seen</p>

    <h1 class="us-mark">
        <span class="us-mark-bracket" aria-hidden="true">[</span>day<span
              class="us-mark-bracket" aria-hidden="true">]</span>
    </h1>

    <p class="studio-lede">
        One picture each. Whatever you were looking at.
    </p>

    {errText && <p class="notice" data-kind="bad" role="status">hm &mdash; {errText}</p>}
    {posted && <p class="notice" data-kind="ok" role="status">that's up.</p>}
    {maybe && (
        <p class="notice" data-kind="warn" role="status">
            that took too long to confirm. Have a look below: if it's there, it worked.
        </p>
    )}

    {!available && (
        /* R2 absent. Said plainly, because photographs are bytes and there is no
           degraded version of storing bytes — a spinner or an empty grid here
           would be a lie about a configuration problem. */
        <p class="notice" data-kind="warn" role="status">
            This one needs the photo bucket wired up before it does anything.
            Nothing is broken and nothing is lost.
        </p>
    )}

    {available && !reachable && (
        <p class="notice" data-kind="warn" role="status">
            I can't reach the shelf, so this may be missing things. Anything either
            of us posted is still there.
        </p>
    )}

    {/* GATED ON import.meta.env.DEV, not on the config.
        This was `available && !hasKV() && reachable`, which is a CONFIGURATION
        test — so if the Upstash vars were ever missing in production she would
        read the word "dev" and the name of a service. Every other `dev —` string
        in the wing is gated on the environment; this one was the sole leak. */}
    {import.meta.env.DEV && available && !hasKV() && reachable && (
        <p class="notice" data-kind="warn" role="status">
            dev &mdash; no Upstash, so captions and times are not being kept. The
            pictures themselves are safe in the bucket.
        </p>
    )}

    <hr class="studio-rule">

    {/* ============================================================
        TODAY — two frames, equal, in a fixed order.

        `viewer` first is the one asymmetry, and it is the right one:
        she is the person holding the phone, so her own half is where
        the action is (posting, replacing). His is the half she came
        to look at. Reversing that would put the thing she can do
        second on every visit.
        ============================================================ */}
    <section class="fr-today" aria-labelledby="today-head">
        <p class="fr-eyebrow" id="today-head">
            {wingDateLabel(today)} &middot; one each
        </p>

        <div class="fr-pair">
            {[viewer, them].map((w) => {
                const f = w === viewer ? mine : theirs;
                /* The shared constants, not string literals — this line and the freshness
                   check above must never disagree about where somebody lives. */
                const tz = w === 'her' ? HER_TZ : HIS_TZ;
                return (
                    <figure class="fr-frame" data-whose={w === viewer ? 'mine' : 'theirs'}>
                        <p class="fr-who">{whoWord(w)}</p>

                        {f && f.url ? (
                            <>
                                {/* width/height are the aspect the client resizer
                                    targets, so the box is reserved before the image
                                    arrives and the page does not jump. `loading`
                                    is eager for today: this is the content, not
                                    something below the fold. */}
                                <img
                                    class="fr-img"
                                    src={f.url}
                                    alt={f.note
                                        ? `${whoWord(w)}: ${f.note}`
                                        : `a photograph ${w === viewer ? 'you' : whoWord(w)} put up${
                                              (w === viewer ? mineFrom : theirsFrom) ? '' : ' today'}`}
                                    loading="eager"
                                    decoding="async"
                                >
                                <figcaption class="fr-cap">
                                    {f.note && <span class="fr-note">{f.note}</span>}
                                    {clockOf(f.atMs, tz) && (
                                        /* "their time" ONLY on the other person's frame. On her own it
                                           read "04:11 their time" about herself, which is both wrong and
                                           confusing — she does not need her own timezone named, so it is
                                           simply the time.
                                    
                                           THE DAY IS NAMED, NEVER "YESTERDAY", and it is the poster's own
                                           day rather than the wing's. Relative words cannot survive nine
                                           hours: the wing day rolls at 21:00 his time, so between 21:00 and
                                           midnight his local date and the wing's disagree, and a frame
                                           labelled "yesterday" would be describing something he would call
                                           today. That window is his whole evening — the one he posts in.
                                           Hers only misaligns between midnight and 06:00 Paris, while she
                                           is asleep.
                                    
                                           Anchoring to the taker's own clock takes the reader out of the
                                           question entirely: it says when the photograph was taken from the
                                           point of view of whoever took it, which is the same sentence no
                                           matter which of them is looking. */
                                        <span class="fr-time">
                                            {(w === viewer ? mineFrom : theirsFrom)
                                                ? `${dayOf(f.atMs, tz)}, ${clockOf(f.atMs, tz)}`
                                                : clockOf(f.atMs, tz)}{w === viewer ? '' : ' their time'}
                                        </span>
                                    )}
                                    {f.lat !== null && f.lon !== null && (
                                        /* THE PIN IS SHOWN ON PURPOSE, AND THAT IS AN ETHICAL CHOICE RATHER THAN
                                           A FEATURE.
                                    
                                           The coordinates are kept so a map of everywhere she photographed across
                                           France can exist at the end of the long-distance stretch. That is a
                                           lovely thing to be given and a grim thing to have done TO you without
                                           knowing, and the whole difference between those two is whether she can
                                           see it happening. So it is on the page, under the photograph, from the
                                           very first one rather than revealed later.
                                    
                                           COORDINATES RATHER THAN A PLACE NAME. Turning 48.8582, 2.2945 into
                                           'Paris 11e' needs a reverse-geocoding service, which means sending her
                                           location to a third party on every render — strictly worse for privacy
                                           than the thing this line exists to be honest about. Four decimals is
                                           about eleven metres: enough to recognise where you stood, short enough
                                           to read under a photograph.
                                    
                                           aria-hidden on the glyph, with the digits as real text beside it. A pin
                                           emoji read aloud is either silence or 'round pushpin', and neither is
                                           the information. */
                                        <span class="fr-where">
                                            <span class="fr-where-pin" aria-hidden="true">📍</span>
                                            <span class="fr-where-num">{f.place ?? `${f.lat.toFixed(4)}, ${f.lon.toFixed(4)}`}</span>
                                        </span>
                                    )}
                                </figcaption>
                            </>
                        ) : f && !f.url ? (
                            /* Metadata says there is one but signing failed. One
                               picture lost, not the page — and it says which. */
                            <p class="fr-empty">
                                There is one here that I could not load. Refreshing
                                usually fixes it.
                            </p>
                        ) : (
                            /* THE COMMON CASE. Nine hours apart means one of these
                               is usually empty, so it is a real box with a real
                               sentence rather than a collapse. */
                            <p class="fr-empty">
                                {w === viewer
                                    ? 'Nothing from you yet today.'
                                    : `Nothing from ${whoWord(w)} yet today.`}
                            </p>
                        )}
                    </figure>
                );
            })}
        </div>
    </section>

    {available && (
        <>
            <hr class="studio-rule">

            {/* ============================================================
                POSTING

                A REAL FORM with a real enctype, so it works with the
                script absent — which for the one feature most likely to
                be used from a phone is not a nicety. The script below
                upgrades it: it shrinks the picture in a canvas first, so
                what leaves her phone is a few hundred KB instead of
                twelve megapixels.
                ============================================================ */}
            <section class="fr-post" id="post" aria-labelledby="post-head">
                <p class="fr-eyebrow" id="post-head">
                    {mine ? 'swap it for another one' : 'put one up'}
                </p>

                <form
                    class="fr-form"
                    method="post"
                    action="/api/us/frame"
                    enctype="multipart/form-data"
                    data-fr-form
                >
                    <div class="fr-field">
                        <label class="fr-label" for="fr-photo">A photograph</label>
                        {/* `capture` is absent on purpose: it forces the camera on
                            some phones and skips the camera roll, and most of these
                            will be something taken earlier in the day. */}
                        <input
                            class="fr-file"
                            type="file"
                            id="fr-photo"
                            name="photo"
                            accept="image/jpeg,image/png,image/webp"
                            required
                            aria-describedby="fr-photo-hint"
                        >
                        <p class="fr-hint" id="fr-photo-hint">
                            JPEG, PNG or WebP. It gets shrunk before it&rsquo;s sent,
                            so the size doesn&rsquo;t matter much.
                        </p>
                    </div>

                    <div class="fr-field">
                        <label class="fr-label" for="fr-note">
                            A line about it <span class="fr-optional">&mdash; optional</span>
                        </label>
                        <input
                            class="fr-input"
                            type="text"
                            id="fr-note"
                            name="note"
                            maxlength={NOTE_MAX}
                            autocomplete="off"
                            placeholder=""
                            aria-describedby="fr-note-hint"
                        >
                        <p class="fr-hint" id="fr-note-hint">
                            Up to {NOTE_MAX} characters. Leave it blank and the
                            picture stands on its own.
                        </p>
                    </div>

                    {mine && (
                        <p class="fr-hint fr-hint--warn">
                            You already put one up today. A new one replaces it.
                        </p>
                    )}

                    <button class="fr-go" type="submit" data-fr-go>put it up</button>
                    <p class="fr-status" data-fr-status role="status"></p>
                </form>
            </section>
        </>
    )}

    {/* THE WEEK STRIP IS GONE, AND SO IS THE "nothing before today" LINE.
    
        This page is now only ever the two big frames. The strip below them showed up
        to seven days of thumbnails, which made this an archive with a headline on top
        rather than a photograph of the day — and an archive is a different feature
        with different questions attached (how far back, what happens at the end of it,
        who can delete). None of those questions were being answered; the strip just
        grew.
    
        THE WINDOW NOW MATCHES THE SLOT. Reading seven days to render two was the
        tell that the two halves disagreed about what the page was for: the strip could
        show a photograph the slot had already refused to promote, so the same picture
        was simultaneously too old to headline and recent enough to display. One number
        governs both now, and it is CARRY_DAYS.
    
        NOTHING IS DELETED. The R2 objects and the Redis day hashes are untouched and
        still carry every frame either of them has ever posted — this is a change to
        what the page draws, not to what is kept. There is deliberately no expiry on
        either, which means storage grows forever; that is a known open item and a
        separate decision from this one. If a way back to old frames is ever wanted,
        the missing piece is an index: the keys are generated by walking back from
        today, so a frame older than the window is not merely hidden, it is
        unaddressable. */}

    <hr class="studio-rule">

    <div class="studio-foot">
        <span class="studio-tag">Love you.</span>
        <a href="/samdrea/vault">&larr; back to the room</a>
    </div>
</div>

<script is:inline define:vars={{ maxBytes: MAX_BYTES }}>
/**
 * SHRINK IT BEFORE IT LEAVES THE PHONE.
 *
 * The whole reason this is client side rather than a resize in the function:
 * server-side image processing means `sharp`, which is a native binary an order of
 * magnitude larger than the rest of this project put together, and it would be
 * pulled in to do a job the browser already has hardware for. Doing it here also
 * means the twelve megabytes never crosses the network at all, which on her phone
 * on a train is the part that actually matters.
 *
 * IT IS AN UPGRADE, NOT A REQUIREMENT. The form is a real multipart form with a
 * real action, so with this script absent, blocked, or thrown, the original file
 * is posted and the endpoint accepts it up to MAX_BYTES. Every branch below that
 * fails falls back to submitting the form untouched — there is no path where a
 * resize error costs her the upload.
 */
(function () {
    'use strict';

    var LONG_EDGE = 1600;   // Plenty for a phone screen at 3x, and small.
    var QUALITY = 0.82;     // JPEG q82 is the knee of the curve for photographs.

    var form = document.querySelector('[data-fr-form]');
    if (!form) return;
    var file = form.querySelector('input[type=file]');
    var go = form.querySelector('[data-fr-go]');
    var status = form.querySelector('[data-fr-status]');

    function say(text) { if (status) status.textContent = text || ''; }

    /* Feature-detect everything used below rather than assuming. An older browser
       that lacks any one of these submits the plain form, which works. */
    var canResize = !!(
        window.HTMLCanvasElement &&
        HTMLCanvasElement.prototype.toBlob &&
        window.FileReader &&
        window.FormData &&
        window.fetch
    );
    if (!canResize) return;

    function shrink(f) {
        return new Promise(function (resolve, reject) {
            var url = URL.createObjectURL(f);
            var img = new Image();
            img.onload = function () {
                URL.revokeObjectURL(url);
                var w = img.naturalWidth, h = img.naturalHeight;
                if (!w || !h) return reject(new Error('no dimensions'));

                var scale = Math.min(1, LONG_EDGE / Math.max(w, h));
                /* Already small enough AND already an accepted type: send it
                   untouched rather than re-encoding, which would only lose
                   quality for nothing. */
                if (scale === 1 && f.size < maxBytes * 0.5) return resolve(f);

                var cw = Math.max(1, Math.round(w * scale));
                var ch = Math.max(1, Math.round(h * scale));
                var canvas = document.createElement('canvas');
                canvas.width = cw; canvas.height = ch;
                var ctx = canvas.getContext('2d');
                if (!ctx) return reject(new Error('no 2d context'));
                ctx.drawImage(img, 0, 0, cw, ch);

                canvas.toBlob(function (blob) {
                    if (!blob) return reject(new Error('toBlob gave nothing'));
                    /* JPEG, always. The endpoint sniffs the bytes, so the name is
                       cosmetic — but a canvas re-encode of a photograph is smaller
                       as JPEG than as PNG by a wide margin, and PNG is what
                       toBlob defaults to. */
                    resolve(new File([blob], 'frame.jpg', { type: 'image/jpeg' }));
                }, 'image/jpeg', QUALITY);
            };
            img.onerror = function () {
                URL.revokeObjectURL(url);
                /* HEIC lands here on browsers that cannot decode it. The plain
                   form is the fallback and the endpoint's message names HEIC. */
                reject(new Error('could not decode'));
            };
            img.src = url;
        });
    }

    form.addEventListener('submit', function (ev) {
        if (!file || !file.files || !file.files[0]) return;   // let the form complain
        var original = file.files[0];

        ev.preventDefault();
        if (go) go.disabled = true;
        /* ---- ALL FOUR LIVE OUT HERE, AND THREE OF THEM USED TO NOT ------------

           `ctl` and `killer` were declared with `var` inside the raced.then(small)
           callback below, and then cleared from the TWO SIBLING callbacks after it.
           `var` is function-scoped, so those callbacks never had them: the first
           `clearTimeout(killer)` threw ReferenceError, the .catch threw the same on
           its own first line, and the rejection went unhandled.

           The result was the exact bug this whole block was written to fix, wearing a
           different hat. A real upload SUCCEEDED, the server saved the photograph, the
           response came back — and then the page threw before it could react, so it
           never navigated, never said a word, and left the clock ticking past the 45s
           deadline forever. The only way to learn the truth was still to leave and
           refresh. Reported after counting to 60.

           A ticking counter is a promise that something is still happening. Nothing
           below may be able to break that promise by throwing, which is what stop()
           is for. */
        var sent = false;
        var ticker = 0;
        var killer = 0;
        var ctl = null;

        /* Cleanup that CANNOT throw and does not care what already ran. Every exit
           path calls it first, so a later error can leave her looking at a stale
           message but never at a clock that is still counting. */
        function stop() {
            try { clearInterval(ticker); } catch (err) { /* nothing to undo */ }
            try { clearTimeout(killer); } catch (err) { /* same */ }
            ticker = 0;
            killer = 0;
        }

        /* ---- GO SOMEWHERE AND ACTUALLY GET A SERVER RENDER --------------------

           `location.assign()` DOES NOT RELOAD IF THE TARGET DIFFERS ONLY IN THE
           FRAGMENT, or not at all. It is a same-document navigation: the browser
           scrolls to the anchor and nothing is re-fetched. Verified in Chrome — a
           marker set on `window` survived the call and the server never saw a second
           request, while `location.reload()` cleared it.

           Which makes it the wrong primitive here, because the second upload of a day
           is a real and now-encouraged thing to do. Unique R2 keys made swapping a
           photograph safe, so she can post again — and the success path wanted
           `?ok=posted#post` while she was ALREADY sitting on `?ok=posted#post` from
           the first one. Same URL, no reload, and the page would keep showing the
           previous photograph under a "that's up." that was already there. The upload
           would have worked perfectly and looked like it had done nothing.

           So: if the target names the same document, set the fragment and force a
           reload. Only a genuinely different path or query gets assign(). The current
           page is always a GET, so reload() cannot re-post anything. */
        function land(path, search, hash) {
            var sameDocument = location.pathname === path && location.search === search;
            if (sameDocument) {
                if (location.hash !== hash) location.hash = hash;
                location.reload();
                return;
            }
            location.assign(path + search + hash);
        }

        say('shrinking it…');

        /* The same guarantee for the ENCODE. canvas.toBlob() takes a callback and
           nothing promises it ever runs; a race means a stuck encoder falls into
           the .catch below rather than stalling behind a disabled button. */
        var raced = Promise.race([
            shrink(original),
            new Promise(function (_, reject) {
                setTimeout(function () { reject(new Error('resize timed out')); }, 15000);
            }),
        ]);

        raced.then(function (small) {
            var body = new FormData();
            body.append('photo', small, 'frame.jpg');
            var note = form.querySelector('input[name=note]');
            if (note) body.append('note', note.value);

            /* ---- WHERE IT WAS TAKEN, SENT AS THE HEAD OF THE ORIGINAL --------

               There is meant to be a map at the end of all this, of everywhere she
               photographed across France. The coordinates for it live in EXIF, and
               EXIF is exactly what shrink() above has just destroyed — a canvas
               holds pixels, so the re-encode drops every byte of metadata. By the
               time `small` exists the location is gone, and the server has no way
               to recover it.

               SO THE FIRST 64KB OF THE ORIGINAL GOES TOO, and the server parses it
               with the same reader it already uses on a no-JavaScript upload. The
               alternative was parsing EXIF here and posting a latitude and
               longitude, which means a SECOND parser over hostile byte formats
               living in an inline script — untested, and in the one place where a
               thrown error costs her the photograph. One parser on the server is
               strictly better, and this is the thing that makes it possible.

               64KB because APP1 sits at the very start of a JPEG, ahead of any
               pixel data, and carries its own thumbnail inside itself. `slice` is a
               view: nothing is copied, nothing is decoded, and nothing is read into
               memory here.

               ENTIRELY OPTIONAL AND SILENT WHEN IT FAILS. All of it is inside a
               try — a browser without File.slice, a revoked handle, anything —
               and the upload then proceeds without the pin. A missing point on a
               map is not worth a failed photograph. */
            try {
                /* AND ONLY WHEN THE RESIZER ACTUALLY RE-ENCODED. shrink() has an
                   early return: a photograph already within the long edge and under
                   half the byte cap is resolved UNCHANGED, and then it still carries
                   its own EXIF — so the head would be 64KB of duplicate metadata on
                   an upload that already contains it.

                   That is not a rare branch. Her first upload was 615KB and passed
                   straight through, so the head was pure waste on a connection she
                   had already told us felt slow. `small === original` is the exact
                   test for it, because the early return resolves the same object. */
                if (small !== original && original && original.slice) {
                    body.append('exifhead', original.slice(0, 65536), 'head.bin');
                }
            } catch (err) { /* no pin, and nothing else changes */ }

            /* A TICKING COUNT, because "sending…" alone is indistinguishable from a
               hang — which is exactly what happened. A real upload succeeded, the page
               said "sending…" until it was abandoned, and the only way to learn the
               truth was to leave and come back.
            
               Elapsed seconds rather than a percentage: `fetch` cannot report upload
               progress at all, and a faked bar is worse than an honest count. A real
               determinate bar needs XMLHttpRequest's upload.onprogress, which is a
               rewrite of this whole block and is left as the proper follow-up. */
            var began = Date.now();
            say('sending…');
            ticker = setInterval(function () {
                var secs = Math.round((Date.now() - began) / 1000);
                say(secs < 3 ? 'sending…' : 'sending… ' + secs + 's');
            }, 1000);
            /* A DEADLINE. Every FAILURE branch here falls back to submitting the
               plain form, but a request that never settles is not a failure — it
               is a hang, and preventDefault() has already suppressed the native
               submit and disabled the button. On a phone with one bar, which is
               the exact case the resizer exists for, she was left on "sending…"
               forever with no way to retry but a reload that loses her file.
               45s is generous for a few hundred KB and still finite. */
            /* Assigned, NOT declared — the `var` that used to be on these two lines is
               what stranded the clock. See the declarations in the handler scope. */
            ctl = new AbortController();
            killer = setTimeout(function () { ctl.abort(); }, 45000);
            /* FROM HERE THE SERVER MAY ALREADY HAVE THE PHOTOGRAPH, which changes what
               a failure means. See the catch below. */
            sent = true;
            return fetch(form.action, {
                method: 'POST',
                body: body,
                signal: ctl.signal,
                /* Accept decides the response shape — see wantsJson() in the
                   endpoint. The Content-Type is set by FormData, boundary and all,
                   and must NOT be set by hand. */
                headers: { Accept: 'application/json' },
                credentials: 'same-origin',
            });
        }).then(function (res) {
            /* Everything stops the moment the response is in hand. The request has
               landed, so the deadline has no more work to do and the count has nothing
               left to reassure her about — parsing is instant and a navigation follows.

               `res.ok` is the fallback rather than the primary, and deliberately: this
               endpoint answers 303 for BOTH success and refusal with the outcome in the
               body, so the status code is not the answer. It is only consulted when the
               body would not parse at all. */
            stop();
            return res.json().catch(function () { return { ok: res.ok }; });
        }).then(function (data) {
            stop();
            if (data && data.ok) {
                /* A server render rather than a DOM patch: the new frame needs a
                   freshly signed URL and the server is the only thing that can mint
                   one. land() rather than assign() because posting a second time in
                   a day targets the URL she is already on — see land(). */
                land('/samdrea/vault/day', '?ok=posted', '#post');
                return;
            }
            /* ---- A REFUSAL IS NOT AUTOMATICALLY A REASON TO UPLOAD AGAIN --------

               This used to call form.submit() for EVERY non-success, which re-posts the
               untouched original. Measured against all nine refusal codes the endpoint
               can send, that meant two uploads of the photograph every single time, and
               for most codes the second one cannot possibly do better than the first:

                 too-big       the RESIZED file was refused, so posting the LARGER
                               original is guaranteed to fail, after spending her
                               connection on more bytes to find out.
                 rate          retries straight back into the limiter, so it fails again
                               and burns another slot doing it.
                 cross-site    the origin has not changed.
                 unconfigured  the bucket is still not configured.
                 store         the resize was never the problem, so the original is the
                               same request again with a bigger body.

               The endpoint tells us WHICH of these it was, so the decision can be made
               per code instead of uniformly. Re-posting is kept only where the original
               file is a materially DIFFERENT attempt and might genuinely succeed. */
            var code = (data && data.code) || '';
            var retryWithOriginal = {
                /* The canvas re-encode is the suspect: it can produce something the
                   sniffer rejects, or nothing at all, where the original is a perfectly
                   good JPEG. Posting it untouched is a real second chance. */
                'not-an-image': 1,
                'no-photo': 1,
                /* A body that arrived truncated is the most likely real-world failure
                   here and is usually just signal. Worth one honest retry. */
                'bad-upload': 1
            };

            if (retryWithOriginal[code]) {
                say('');
                if (go) go.disabled = false;
                /* Hand the real form the job, with the file she actually picked. The
                   endpoint's own 303 carries the outcome back to the page. */
                form.submit();
                return;
            }

            /* Everything else: no second upload. Go and read her the reason. An empty
               code means the answer was unreadable, and that is genuinely unknown rather
               than failed — the write may already have happened — so it gets the same
               honest wording as the deadline below instead of a confident "it failed". */
            if (code) {
                land('/samdrea/vault/day', '?e=' + encodeURIComponent(code), '#post');
            } else {
                land('/samdrea/vault/day', '?ok=maybe', '#post');
            }
        }).catch(function () {
            /* ---- AN UNKNOWN OUTCOME IS NOT THE SAME AS A FAILURE ----------------
            
               Reached by an abort at the deadline, a network drop, or a resize that
               threw. This used to call form.submit() for all three, re-posting the
               ORIGINAL file — and that is wrong for two of them, because the request
               may already have SUCCEEDED. It did: a real upload landed, the response
               never came back, and the page would then have quietly uploaded the
               whole thing a second time.
            
               So the cases are split by whether the request ever left:
            
                 NEVER SENT — the resize threw before any request. Nothing is on the
                 server, so the original is the right thing to post and the real form
                 does it with no script involved.
            
                 ALREADY SENT — the photograph may be saved. RELOAD rather than
                 re-post, and let the page state be the answer: if it landed she sees
                 it, and if it did not she sees the empty slot and can try again. That
                 is the manual "exit the page and refresh" that was the only way to
                 find out, done automatically. */
            stop();
            if (sent) {
                say('checking…');
                /* ?ok=maybe RATHER THAN NOTHING, which is the other half of this fix.
                   Reloading with a bare URL was measurably silent: she had just waited
                   out the 45s deadline and the page came back with no message at all,
                   which is the same nothing that made her count to sixty and refresh by
                   hand. The photograph may well be saved — the server writes bytes
                   before it answers — so the page says it cannot tell and points at the
                   frame, instead of guessing in either direction.

                   land() rather than assign() for the same reason as above: a second
                   timeout targets the URL she is already on, and an assign() that
                   quietly does nothing would leave her on 'checking…' forever. */
                land('/samdrea/vault/day', '?ok=maybe', '#post');
                return;
            }
            say('');
            if (go) go.disabled = false;
            form.submit();
        });
    });
})();
</script>
</body>
</html>

---
/**
 * /samdrea/vault/room — Act II, the studio. PHASE 3.
 *
 * ---------------------------------------------------------------------------
 * WHAT THIS PAGE IS
 *
 * A black reformer studio under blue light, with a carriage that carries her
 * down a rail past every photograph of us. The room itself is
 * src/components/StudioRoom.tsx; this file's whole job is to prove she is
 * allowed to see it, hand the island a manifest, and ship a version of the room
 * that works when the island cannot.
 *
 * WHAT SHIPS IN THE HTML, AND WHAT DOES NOT
 *
 * Captions and the hidden notes ship in the initial HTML. That is
 * deliberate: this response is only ever produced after a signed session cookie
 * has been verified twice (middleware, then again below), and the notes have to
 * be here for the reveal to be instant and for the static grid to be readable
 * with zero script. What does NOT ship is a single photographic byte, or the R2
 * object keys, or anything that would work for a caller without the cookie —
 * every <img> points at /api/us/photo/[id], which re-authorises from scratch.
 *
 * THE STATIC GRID IS THE PAGE. THE 3D ROOM IS THE UPGRADE.
 *
 * `.room-fallback` below is rendered on the server and is VISIBLE BY DEFAULT.
 * StudioRoom.tsx hides it only after the WebGL context, the scene and the HUD
 * all exist. So no JavaScript, no WebGL, a thrown exception during hydration,
 * or `prefers-reduced-motion` all leave a complete, keyboard-operable,
 * screen-reader-legible gallery in place — with the notes reachable through a
 * plain <details>, in one activation, with no timed hold anywhere.
 *
 * That ordering is the reason this page has no loading state and cannot show a
 * black screen: the pessimistic version is what the server sends.
 * ---------------------------------------------------------------------------
 */
import { HER_NAME, SESSION_SECRET, hasR2 } from '../../../lib/us/config';
import { readCookie, verify } from '../../../lib/us/session';
import { touch } from '../../../lib/us/presence';
import { identify } from '../../../lib/us/together';
import { CHAPTERS, clientManifest } from '../../../lib/us/photos';
import {
    MARK_NOTE_MAX,
    countVisitSafe,
    getMarksSafe,
    visitLine,
} from '../../../lib/us/marks';
import StudioRoom from '../../../components/StudioRoom.tsx';

export const prerender = false;

/**
 * Defence in depth, exactly as in vault/index.astro.
 *
 * src/middleware.ts has already verified this cookie or the render never
 * happened. Re-checking is what makes a future routing mistake there degrade to
 * "this page refuses" rather than to "the album is public" — and this is the
 * page with the most to lose from that mistake.
 */
const secret = SESSION_SECRET();
const session = secret ? verify(secret, 'session', readCookie(Astro.cookies, 'session', Astro.url)) : null;

if (!session) return Astro.redirect('/samdrea', 302);

/* PRESENCE, WRITE ONLY. This page shows no presence line — a note about
   somebody else arriving would pull her out of the thing she came here to
   read. But time spent here is still time spent in the wing, so it stamps
   without reading. Without this, twenty minutes on this page would look
   like twenty minutes away, and the hub would tell him she had left.

   Never awaited for its value and never able to throw: presence.ts
   resolves to undefined on every failure path, including no Upstash. */
const _seenBy = identify(Astro.cookies, Astro.url) ?? 'her';
await touch(_seenBy);

const her = HER_NAME();
const memories = clientManifest();
const lines = CHAPTERS.map((c) => ({ line: c.line, label: c.label, blurb: c.blurb }));

/* ---------------------------------------------------------------------------
   HER MARKS, AND THIS VISIT

   Both read on the SERVER, and both through the *Safe wrappers, which log and
   degrade to empty rather than throwing. That split is deliberate (marks.ts's
   header explains it): a mark WRITE fails loud, because a note she typed that
   silently vanished is unforgivable, but a mark READ is decoration on a room that
   must render regardless. An unreachable bucket costs her the keep-badges and the
   visit line. It must never cost her the gallery.

   Reading here rather than fetching from the island buys three things at once:
   the first paint already carries her keeps and her notes with no
   fetch-and-flicker, the STATIC FALLBACK GRID carries them too (and that grid is
   the page whenever WebGL or hydration fails), and the visit line needs no
   JavaScript at all.

   Run concurrently: they hit the same store but are independent, and this is on
   the critical path of rendering the room.

   countVisit, not getVisits — THIS PAGE LOAD IS THE VISIT. It is debounced inside
   the store (VISIT_DEBOUNCE_MS, 20 minutes), which is what makes a refresh, a
   back-forward and iOS restoring the tab in the morning all the same visit. That
   debounce lives in the store rather than here precisely so no future caller can
   double-count by forgetting it.
   --------------------------------------------------------------------------- */
const [marks, visits] = await Promise.all([getMarksSafe(), countVisitSafe()]);

/**
 * "the 7th time you've been in here.", or '' when there is nothing worth saying.
 *
 * Composed on the server so the ordinal edge cases (1, 2, 11th) are decided once,
 * next to the counter, rather than in a component.
 */
const visitText = visitLine(visits.count);

/**
 * What the island actually needs, and nothing else.
 *
 * `Mark` also carries `id` (redundant — it is the key) and `at` (an epoch
 * timestamp of when she last touched it). Neither is rendered, and `at` is the
 * kind of field that gets shipped once and then quietly relied on. Narrowing here
 * keeps the client's view of a mark to the three things it draws.
 */
const clientMarks: Record<string, { kept: boolean; note: string; seen: number }> =
    // Annotated rather than inferred: Object.fromEntries returns `any`, so without
    // this the island's `marks` prop is unchecked and a renamed field would only
    // surface as a blank badge in the browser.
    Object.fromEntries(
        Object.entries(marks).map(([id, m]) => [id, { kept: m.kept, note: m.note, seen: m.seen }]),
    );

/**
 * A failed no-JS mark submission comes back as `?e=<code>` — see /api/us/mark's
 * `answer()`. Translated into a sentence here rather than shown as a code,
 * because the person reading it is not debugging an API.
 *
 * Anything unrecognised falls through to the generic line: the codes are ours, but
 * the query string is not, and echoing an unknown value back into the page is how
 * a reflected-content bug starts. Astro escapes by default, so this is
 * belt-and-braces rather than the only defence.
 */
const MARK_ERRORS: Record<string, string> = {
    store: 'That did not save — the store did not answer. Try it again.',
    rate: 'That was a lot of taps very quickly. Give it a minute.',
    'note-too-long': `That note was longer than ${MARK_NOTE_MAX} characters, so it was not saved.`,
    'note-missing': 'That came through with no note at all, so nothing was changed.',
    'no-such-memory': 'That memory is not on the rail any more.',
    'cross-site': 'That did not come from this page, so it was refused.',
    unconfigured: 'Something is misconfigured on my end. Not your fault.',
    /* `unauthorized` is deliberately absent. /api/us/mark does answer it, but on the
       no-JS path the 303 lands on THIS page and src/middleware.ts then bounces an
       unauthenticated caller straight to the gate — so she would never read the
       sentence. Listing a string that cannot be shown is worse than the fallback
       below, which is honest about not knowing. */
};
const errCode = Astro.url.searchParams.get('e');
const markError = errCode ? (MARK_ERRORS[errCode] ?? 'That did not save. Try it again.') : null;

/** Chapters, with their memories, for the static grid. Empty chapters are dropped. */
const chapters = CHAPTERS.map((c) => ({
    chapter: c,
    items: memories.filter((m) => m.chapter === c.id),
})).filter((g) => g.items.length > 0);

/**
 * Only ever surfaced in development. In production an unconfigured bucket shows
 * her labelled placeholder cards and says nothing about why — a private page is
 * not the place to explain my infrastructure.
 */
const showPlaceholderNotice = import.meta.env.DEV && !hasR2();
---

<!DOCTYPE html>
<html lang="en" class="studio-room-html">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- viewport-fit=cover is REQUIRED for env(safe-area-inset-*) to be
         anything but 0. The pages set apple-mobile-web-app-status-bar-style
         to black-translucent, so iOS draws content UNDER the notch and the
         home indicator; without this attribute there is no opt-out AND no
         way to pad around it, so the studio's "exit" link sat behind the
         battery icon. The insets are applied in us.css and us-studio.css. -->
    <meta name="color-scheme" content="dark">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>[us] — the studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- ABSOLUTE paths. This page is at /samdrea/vault/room, so "css/us.css"
         would resolve to /samdrea/vault/css/us.css and 404. -->
    <!-- Installable-app metadata. `scope` is "/" and that is a CORRECTION, not
         laziness. It was "/samdrea/", which looks tighter and quietly broke the
         installed app in three places: an installed PWA opens any out-of-scope
         URL in the BROWSER instead of the app, and "/samdrea" (the gate, where
         every expired session lands), "/api/us/out" (sign out) and all eleven
         "/api/us/*" form actions are every one of them outside "/samdrea/".
         So her session expiring would eject her to Safari to log back in, and
         with JavaScript off every form post would leave the app too. Nothing in
         the wing links to the public site, so a wide scope traps nothing.

         `start_url: /samdrea/vault` opens at the hub rather than the gate —
         she already holds a session cookie, so she skips the quiz on launch.
         `id` is pinned so the identity survives future manifest edits.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/assets/us/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="[us]">
    <meta name="theme-color" content="#000000">
    <link rel="stylesheet" href="/css/us.css">
    <link rel="stylesheet" href="/css/us-studio.css">
    <!--
      The photographic room, preloaded.

      StudioRoom.tsx's ART DIRECTION block chooses this file (BACKDROP_IMAGE), and
      it is the ROOM — without it the first frame is a black rectangle with
      thirteen lit panels floating in it, which reads as broken rather than as
      loading. Preloading it means it is usually decoded before the island has
      finished evaluating three.js.

      Hardcoded here rather than derived, because <head> is emitted before any
      island runs and Astro cannot see into the component's constants. If Sam
      changes BACKDROP_IMAGE, change this href too — the page still works either
      way, it just loses the head start.
    -->
    <link rel="preload" as="image" href="/assets/us/studio-backdrop.webp" type="image/webp" fetchpriority="high">
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2032%2032%27%3E%3Crect%20width%3D%2732%27%20height%3D%2732%27%20fill%3D%27%23000%27%2F%3E%3Ctext%20x%3D%2716%27%20y%3D%2722.5%27%20font-family%3D%27Helvetica%2CArial%2Csans-serif%27%20font-size%3D%2716%27%20font-weight%3D%27700%27%20text-anchor%3D%27middle%27%3E%3Ctspan%20fill%3D%27%233e7bff%27%3E%5B%3C%2Ftspan%3E%3Ctspan%20fill%3D%27%23fff%27%3Eus%3C%2Ftspan%3E%3Ctspan%20fill%3D%27%233e7bff%27%3E%5D%3C%2Ftspan%3E%3C%2Ftext%3E%3C%2Fsvg%3E">
</head>
<body class="studio-room">

<!--
  THE ROOM.

  client:load, not client:visible: the stage IS the top of the page on every
  viewport, so client:visible's IntersectionObserver would fire immediately
  anyway and we would have paid for the observer to learn nothing. Same call as
  index.astro makes for the hero.

  The island renders on the server too, so the canvas and the whole HUD are in
  this HTML — which is why us-studio.css keeps `.room-stage` display:none until
  the component has proven WebGL works.
-->
<StudioRoom
    client:load
    memories={memories}
    lines={lines}
    marks={clientMarks}
    visitLine={visitText}
/>

{/*
  A failed no-JS mark. Above the fallback grid rather than inside it, because the
  submission that failed could have come from any card and she should not have to
  find the one she was on to learn that it did not work. /api/us/mark's 303 puts a
  `#m-<id>` fragment on the URL, so the browser has already scrolled her back to
  the right card — this banner is what tells her why she is looking at it.
*/}
{markError && (
    <div class="room-noscript" role="alert">
        <b>Not saved.</b> {markError}
    </div>
)}

<noscript>
    <div class="room-noscript">
        <b>The 3D room needs JavaScript.</b> Every photograph and every note is below as
        well, in full.
    </div>
</noscript>

{showPlaceholderNotice && (
    <div class="room-noscript">
        <b>Dev only:</b> R2 is not configured, so every panel is a generated placeholder card.
        Set <code>R2_ACCOUNT_ID</code>, <code>R2_ACCESS_KEY_ID</code>,
        <code>R2_SECRET_ACCESS_KEY</code> and <code>R2_BUCKET</code> to serve real photographs.
        The room is fully interactive either way.
    </div>
)}

<!--
  THE STATIC GRID.

  Visible until the island says otherwise. `data-room-fallback` is the hook the
  component looks for — deliberately a data attribute rather than an id, so it
  reads as a contract between the two files rather than as a coincidence.
-->
<main class="room-fallback" data-room-fallback>

    <p class="room-fallback-head">[us] &middot; the studio &middot; every memory, all at once</p>
    <p class="room-fallback-note">
        The same room, without the room, {her} — every photograph, every caption and
        every note, all open. Nothing to hold, nothing to scroll. You can keep them and
        write back from here too.
    </p>
    {/*
      The visit line, in full here rather than truncated as it is in the HUD's top
      bar. Server-rendered from the same persisted counter, so this page says the
      same thing the 3D room does — and says it even when the 3D room never runs.
    */}
    {visitText && <p class="room-fallback-visits">{visitText}</p>}

    {chapters.map((group) => (
        <section>
            <h2 class="room-fallback-chapter">
                line 0{group.chapter.line} &middot; {group.chapter.label} &middot; {group.chapter.blurb}
            </h2>
            <ol class="room-grid">
                {group.items.map((m) => (
                    <li class="room-card" id={`m-${m.id}`}>
                        {/*
                          `id` above so /api/us/mark's 303 can put her back on the
                          card she submitted from. A `#m-<id>` fragment is the
                          entire reason the no-JS path does not dump her at the top
                          of a thirteen-card page every time she keeps something.
                        */}
                        {/*
                          src is the API route, never an R2 URL: the endpoint
                          re-verifies the cookie and only then hands over a
                          short-lived presigned redirect (or, unconfigured, a
                          generated placeholder card).

                          `loading="lazy"` because thirteen photographs below the
                          fold is not a first-paint cost worth paying, and
                          aspect-ratio from the manifest hint reserves the box so
                          the grid does not reflow as they land.

                          alt is the caption. It is not decorative — it is the
                          only description of the photograph that exists.
                        */}
                        <img
                            src={m.src}
                            alt={m.caption}
                            loading="lazy"
                            decoding="async"
                            style={`aspect-ratio: ${m.aspect}`}
                        />
                        <div class="room-card-body">
                            {/* `when` is optional free text now, not a derived
                                date, so the line is omitted entirely rather than
                                rendering an empty strip. */}
                            {(m.hidden || m.when) && (
                              <p class="room-card-when">{m.hidden ? 'still one more' : m.when}</p>
                            )}
                            <p class="room-card-caption">{m.caption}</p>
                            <details class="room-card-note">
                                <summary>the note</summary>
                                <p>{m.note}</p>
                            </details>

                            {/*
                              ===================================================
                              WHAT SHE CAN DO, WITH ZERO JAVASCRIPT.

                              Two real forms per card, posting to /api/us/mark,
                              which answers a form submission with a 303 back to
                              this page. This is not a courtesy path: this grid IS
                              the room whenever WebGL, JS or hydration fails, and a
                              keep button that only worked with the island running
                              would mean the accessible version of the room is
                              read-only while the pretty one is not.

                              303 rather than 302, so the redirect forces a GET and
                              a refresh cannot resubmit the tap.
                              ===================================================
                            */}
                            <form class="room-card-keep" action={`/api/us/mark?m=${m.id}`} method="post">
                                <input type="hidden" name="action" value="keep" />
                                <input type="hidden" name="id" value={m.id} />
                                {/*
                                  The DESIRED END STATE, not an action — so a
                                  double-submit on a laggy phone converges instead
                                  of toggling twice. `on` is only sent when
                                  un-keeping, because /api/us/mark's readOn() treats
                                  an ABSENT field as true; that default is what lets
                                  the keep form carry nothing but the id.
                                */}
                                {marks[m.id]?.kept && <input type="hidden" name="on" value="0" />}
                                <button type="submit" aria-pressed={marks[m.id]?.kept ? 'true' : 'false'}>
                                    {marks[m.id]?.kept ? 'kept' : 'keep this'}
                                </button>
                            </form>

                            {/*
                              Her note. Shown OUTSIDE the <details> that holds his,
                              and labelled, because the room now carries two voices
                              and they must not read as one.
                            */}
                            {marks[m.id]?.note && (
                                <div class="room-card-hers">
                                    <p class="room-card-hers-label">yours</p>
                                    <p class="room-card-hers-text">{marks[m.id]?.note}</p>
                                </div>
                            )}

                            <details class="room-card-reply">
                                <summary>{marks[m.id]?.note ? 'edit your note' : 'write back'}</summary>
                                <form action={`/api/us/mark?m=${m.id}`} method="post">
                                    <input type="hidden" name="action" value="note" />
                                    <input type="hidden" name="id" value={m.id} />
                                    {/*
                                      A real <label>, tied by id. Thirteen cards on
                                      one page means thirteen textareas, so the id
                                      has to carry the memory id or they collide and
                                      every label points at the first one.
                                    */}
                                    <label class="room-sr-only" for={`reply-${m.id}`}>
                                        your note back on: {m.caption}
                                    </label>
                                    <textarea
                                        id={`reply-${m.id}`}
                                        name="note"
                                        rows="3"
                                        maxlength={MARK_NOTE_MAX}
                                        placeholder="anything."
                                    >{marks[m.id]?.note ?? ''}</textarea>
                                    <button type="submit">save</button>
                                </form>
                            </details>
                        </div>
                    </li>
                ))}
            </ol>
        </section>
    ))}

    <div class="room-fallback-foot">
        <span>Stronger for it.</span>
        <span>
            <a href="/samdrea/vault">back to the vault</a>
            &nbsp;&middot;&nbsp;
            <form class="studio-out" method="post" action="/api/us/out"><button class="studio-out-btn" type="submit">sign out</button></form>
        </span>
    </div>
</main>

<!--
  GSAP, vendored, at the END of the body.

  PLAN.md §4.3 names `scrub: 1` specifically, and the one-second lag between the
  scrollbar and the carriage IS the machine's spring resistance. StudioRoom.tsx
  detects `window.gsap` and `window.ScrollTrigger` and falls back to a complete
  hand-rolled damped scrub if either is absent, so these two tags are an
  upgrade and not a dependency.

  They are at the end of the body so they do not block first paint, and the
  component does NOT assume they have run by the time it hydrates. It cannot:
  an <astro-island> with client:load hydrates from its own connectedCallback
  while the parser is still working, and the component module is modulepreloaded,
  so on a warm cache it can evaluate before the parser reaches these two tags.
  A one-shot `if (window.gsap)` would lose that race silently — the room would
  take the damped path, look almost right, and nobody would ever discover that
  the `scrub: 1` the plan specifies was never running. So StudioRoom.tsx starts
  on the damped scrub and upgrades in place when these fire (see waitForGsap).

  Absolute paths: Base.astro can say src="gsap.min.js" because it renders at the
  root. This page is three segments deep and a relative src would 404.
-->
<script is:inline src="/gsap.min.js"></script>
<script is:inline src="/ScrollTrigger.min.js"></script>

</body>
</html>

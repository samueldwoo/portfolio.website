---
/**
 * /stronger/vault/today — line 01. Her page.
 *
 * ---------------------------------------------------------------------------
 * THE SESSION IS RE-VERIFIED HERE, AND THAT IS NOT THEATRE
 *
 * src/middleware.ts has already checked a signed, unexpired token for anything
 * under /stronger/vault, or this render never happened. The check below is what
 * makes a routing mistake up there degrade to "she gets sent to the gate" instead
 * of "the internet gets her songs". If NEEDS_SESSION ever stops matching this
 * path, this page still refuses to render. Copied verbatim from the vault hub so
 * there is one pattern to audit rather than two.
 *
 * `session` specifically, NOT `session ?? admin`. My admin token cannot open this
 * page, which is a deliberate and slightly inconvenient choice: the vault is hers,
 * that is one rule, and one rule is worth more than the convenience of previewing
 * her page without answering the questions. /stronger/dj renders its own preview
 * of the card for exactly this reason.
 *
 * ---------------------------------------------------------------------------
 * IT READS THE STORE DIRECTLY, NOT ITS OWN API
 *
 * This page is server-rendered, so calling /api/us/song from here would mean the
 * server making an HTTP request to itself, forwarding her cookie, and paying a
 * round trip to reach a module it can just import. /api/us/song exists for the
 * client (see the rollover probe at the bottom); the page uses the store.
 *
 * ---------------------------------------------------------------------------
 * IT WORKS WITH JAVASCRIPT OFF
 *
 * Every reaction is a real <form method="post"> that 303s back here and
 * re-renders from the store. The script at the bottom upgrades those to fetches
 * so the page does not jump, and that is ALL it does. A press-and-hold or a
 * click-handler-on-a-div would have made the only path to reacting a scripted
 * one; this way the enhancement is genuinely optional.
 *
 * ---------------------------------------------------------------------------
 * THE ONE RULE
 *
 * The album art is the only warm, saturated thing on this page. No filter, no
 * tint, no blend mode, no overlay — not on the art, and not on Spotify's embed
 * either. The blue is light in the room around them. See the header of
 * public/css/us-song.css.
 * ---------------------------------------------------------------------------
 */
import { HER_NAME, SESSION_SECRET } from '../../../lib/us/config';
import { readCookie, verify } from '../../../lib/us/session';
import {
  REACTIONS,
  WING_TZ,
  agoLabel,
  durationLabel,
  getExchange,
  resurface,
  storeTier,
  summarize,
  wingDate,
  wingDateLabel,
  type ReplyRecord,
  type Rhythm,
  type SongRecord,
  type TrackRecord,
} from '../../../lib/us/kv';

export const prerender = false;

const secret = SESSION_SECRET();
const session = secret ? verify(secret, 'session', readCookie(Astro.cookies, 'session', Astro.url)) : null;
if (!session) return Astro.redirect('/stronger', 302);

const her = HER_NAME();
const today = wingDate();

/** How many rows the archive RENDERS. Matches ARCHIVE_LIMIT in /api/us/song. */
const ARCHIVE_LIMIT = 60;

/**
 * How far back the COUNTING goes. 365, which is also the ceiling getSongs()
 * enforces, so this is "everything there is" rather than an arbitrary window.
 *
 * Deliberately larger than ARCHIVE_LIMIT, and the reason is honesty: a "mornings"
 * total computed over the sixty rows we happened to render would silently mean
 * "sixty" forever once the archive passed sixty days, and a number she reads as a
 * fact about us must not quietly be a fact about a page-size constant.
 *
 * The cost is real but small, and it is smallest on the tier that is actually
 * live: R2 stores the entire history in ONE JSON object, so reading 365 days costs
 * exactly what reading 60 does. On the Upstash tier it widens one MGET and one
 * pipeline of HKEYS — still two round trips, more bytes. That is the price of a
 * true total and it is worth it.
 */
const HISTORY_WINDOW = 365;

/**
 * Everything, in one composite read, then split.
 *
 * `today` is whatever is filed under today's date — never "the most recent
 * song". Promoting yesterday's card to today would be a small lie that makes the
 * whole feature untrustworthy: she would have no way to tell a morning I posted
 * from a morning I forgot, and the honest empty state is a better artifact than a
 * quietly stale one.
 */
let songs: SongRecord[] = [];
let replies: ReplyRecord[] = [];
let reactions: Record<string, string[]> = {};
let replyByDate: Record<string, ReplyRecord> = {};
let storeUnreachable = false;
try {
  ({ songs, replies, reactions, replyByDate } = await getExchange(HISTORY_WINDOW));
} catch (err) {
  console.error('[us] today page could not read the store:', err);
  storeUnreachable = true;
}

const current = songs.find((s) => s.date === today) ?? null;
const archive = songs.filter((s) => s.date !== today).slice(0, ARCHIVE_LIMIT);
const currentReactions = new Set(reactions[today] ?? []);

/** What she sent back today, if she has. Rendered next to my card, not after it. */
const herReply = replyByDate[today] ?? null;

/**
 * The numbers, derived in kv.ts rather than here.
 *
 * Same reason the calendar lives there: /stronger/dj shows a streak too, and two
 * implementations of "how many days in a row" would eventually disagree by one and
 * there would be no way to tell which page was lying.
 */
const rhythm: Rhythm = summarize({ today, songs, replies, reactions });

/**
 * One old morning, brought back. Null when the archive is too young for it to
 * mean anything — see RESURFACE_MIN_AGE_DAYS in kv.ts.
 */
const again = resurface({ today, songs, reactions, replyByDate });

/* Outcomes from the no-JavaScript reaction and reply paths, which arrive back
   here as a 303 with ?e=<code>. Written in her language, not in HTTP: she does not
   need to know what a 502 is, only that it was not her fault and it is worth
   another try. Both endpoints land here, so every message has to make sense for a
   tapped emoji AND for a pasted link. */
const errorCode = Astro.url.searchParams.get('e') ?? '';
const ERRORS: Record<string, string> = {
  store: "that didn't save — not your fault. try it again?",
  rate: 'okay, easy on the buttons. give it a minute.',
  unauthorized: 'your session ran out. answer the questions again and you are back in.',
  unconfigured: 'something is unplugged on my end. not your fault.',
  'bad-url': "that isn't a spotify TRACK link — use Share, then Copy link, from the song itself.",
  'bad-request': "the server couldn't read that. try again?",
  'bad-date': 'that day is not a real day.',
  'future-date': "that day hasn't happened yet.",
};
const errorText = errorCode ? (ERRORS[errorCode] ?? "that didn't go through. try again?") : '';

/* The reply's own success path: /api/us/reply 303s back with ?sent=<date>. */
const sentDate = Astro.url.searchParams.get('sent') ?? '';

/** e.g. `7:42 am`. Only shown when we actually recorded a time. */
function postedAtLabel(ms: number): string {
  if (!ms) return '';
  return new Intl.DateTimeFormat('en-US', {
    timeZone: WING_TZ,
    hour: 'numeric',
    minute: '2-digit',
  })
    .format(new Date(ms))
    .toLowerCase();
}

/**
 * Album, year, length — whichever of them we actually know.
 *
 * Returns an ARRAY rather than a joined string so the template can decide the
 * separator, and returns an EMPTY array rather than placeholders when nothing is
 * known. That is the whole contract of these fields: they exist only when the
 * Spotify Web API credentials do, so the entire pre-credential archive has none of
 * them and the correct rendering of "unknown" is no line at all — never "Unknown
 * album · —".
 */
function metaBits(track: TrackRecord): string[] {
  return [track.album ?? '', track.year ?? '', durationLabel(track.durationMs)].filter(Boolean);
}

/** Reaction glyphs for an archive row, plus the words for a screen reader. */
function reactionGlyphs(date: string): { glyphs: string; words: string } {
  const chosen = REACTIONS.filter((r) => (reactions[date] ?? []).includes(r.key));
  return {
    glyphs: chosen.map((r) => r.emoji).join(' '),
    words: chosen.map((r) => r.label).join(', '),
  };
}

/**
 * The stat strip, assembled here so the markup stays a loop.
 *
 * EVERY CELL IS CONDITIONAL, AND THAT IS THE REQUIREMENT RATHER THAN A FLOURISH.
 * A first-day page must not read "0 mornings · 0 in a row · you answered 0 of 0".
 * Four zeroes is a page telling her this is empty and probably broken. So a cell
 * that would print a zero is not rendered at all, and when nothing qualifies the
 * whole strip disappears and the honest empty states below carry the page.
 */
const stats: Array<{ label: string; value: string; hint?: string }> = [];
if (rhythm.mornings > 0) {
  stats.push({
    label: rhythm.mornings === 1 ? 'morning' : 'mornings',
    value: String(rhythm.mornings),
    hint: rhythm.first ? `since ${wingDateLabel(rhythm.first, { withYear: true })}` : undefined,
  });
}
if (rhythm.streak > 1) {
  // `> 1` and not `> 0`: "1 in a row" is not a streak, it is a Tuesday.
  stats.push({
    label: 'in a row',
    value: String(rhythm.streak),
    hint: rhythm.streakLive ? undefined : 'through yesterday',
  });
}
if (rhythm.answered > 0) {
  stats.push({
    label: 'you were here',
    value: String(rhythm.answered),
    hint: rhythm.mornings > rhythm.answered ? `of ${rhythm.mornings}` : 'every one',
  });
}
if (rhythm.replies > 0) {
  stats.push({
    label: 'you sent back',
    value: String(rhythm.replies),
    hint: rhythm.replies === 1 ? 'the first one' : undefined,
  });
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <!-- Belt and braces: the middleware also sends X-Robots-Tag, which covers
         the redirects and JSON responses that cannot carry a meta tag. -->
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>[us]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Absolute paths: this page is at /stronger/vault/today, so a relative
         href would resolve to /stronger/vault/css/... and 404. us.css first —
         it owns every token us-song.css uses. -->
    <!-- Installable-app metadata. `scope: /stronger/` in the manifest keeps the
         installed app inside the wing, so tapping the icon can never land her on
         the public portfolio, and `start_url: /stronger/vault` opens at the hub
         rather than the gate — she already holds a session cookie, so she skips
         the quiz on every launch.

         DELIBERATELY NO SERVICE WORKER. Every page here is behind a session and
         several are per-day; a worker that cached the wrong response would serve
         her a stale room, or worse, hand a cached authorised page to whoever
         opened the app next. Standalone display, the icon and the black status
         bar all work without one. The only thing given up is offline, which for
         a room whose whole content is fetched per visit is not a real loss. -->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/assets/us/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="[us]">
    <meta name="theme-color" content="#000000">
    <link rel="stylesheet" href="/css/us.css">
    <link rel="stylesheet" href="/css/us-song.css">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23000'/%3E%3Ctext x='16' y='23' font-family='monospace' font-size='20' font-weight='700' text-anchor='middle' fill='%233e7bff'%3E%5B%5D%3C/text%3E%3C/svg%3E">
</head>
<body class="studio">
<div class="studio-wrap">

    <p class="studio-kicker">line 01 &middot; song of the day</p>

    <h1 class="us-mark">
        <span class="us-mark-bracket" aria-hidden="true">[</span>today<span
              class="us-mark-bracket" aria-hidden="true">]</span>
    </h1>

    {errorText && (
        <p class="notice" data-kind="bad" role="status">hm &mdash; {errorText}</p>
    )}

    {sentDate && !errorText && (
        <p class="notice" data-kind="ok" role="status">
            sent &mdash; that's on the shelf for {wingDateLabel(sentDate, { withYear: true })}. I'll see it.
        </p>
    )}

    {storeUnreachable && (
        <p class="notice" data-kind="bad" role="status">
            hm &mdash; I cannot reach the shelf where these live. Nothing is lost,
            it just is not answering right now. Try again in a minute.
        </p>
    )}

    {/* Dev only. She should never be shown a sentence about serverless
        instances; on my own page (/stronger/dj) the same warning is permanent,
        because there it is actionable. */}
    {import.meta.env.DEV && storeTier() === 'memory' && (
        <p class="notice" data-kind="warn">
            dev &mdash; in-process store. Non-durable, per-instance.
        </p>
    )}

    {/* ------------------------------------------------------------------
        THE STAT STRIP

        A <dl>, because these are label/value pairs and that is what a
        description list is for — a row of <div>s would read to a screen
        reader as four unlabelled numbers. The <div> wrappers inside are
        valid HTML5 dl grouping and are what make each pair one grid cell.

        Every number here is COUNTED from stored records by summarize() in
        kv.ts. Nothing is estimated, nothing is rounded, and a cell that
        would say zero is absent instead. See the `stats` builder above.
        ------------------------------------------------------------------ */}
    {stats.length > 0 && (
        <dl class="rhythm">
            {stats.map((cell) => (
                <div class="rhythm-cell">
                    <dt class="rhythm-label">{cell.label}</dt>
                    <dd class="rhythm-value">
                        {cell.value}
                        {cell.hint && <span class="rhythm-hint">{cell.hint}</span>}
                    </dd>
                </div>
            ))}
        </dl>
    )}

    {current ? (
        <>
            <div class="song">
                <span class="song-frame">
                    {current.art ? (
                        /* alt="" on purpose: the title and artist are right
                           there as real text, so alt text would make a screen
                           reader say the same thing twice. This is a decorative
                           duplicate of adjacent content, which is exactly the
                           case empty alt exists for.

                           referrerpolicy="no-referrer" matches the wing's
                           Referrer-Policy header — Spotify's CDN has no business
                           learning the URL she is reading this on. */
                        <img
                            class="song-art"
                            src={current.art}
                            alt=""
                            width="320"
                            height="320"
                            decoding="async"
                            referrerpolicy="no-referrer"
                        >
                    ) : (
                        <span class="song-art--empty" aria-hidden="true">[ ]</span>
                    )}
                </span>

                <div class="song-body">
                    <p class="song-day">
                        {wingDateLabel(current.date)}
                        {postedAtLabel(current.postedAt) && (
                            <> &middot; posted {postedAtLabel(current.postedAt)}</>
                        )}
                    </p>

                    {current.title ? (
                        <h2 class="song-title">{current.title}</h2>
                    ) : (
                        /* Spotify's metadata call failed. The embed below still
                           knows what the track is, so this says so plainly
                           rather than rendering an empty heading. */
                        <h2 class="song-title song-title--unknown">a song I could not name</h2>
                    )}

                    {current.artist && <p class="song-artist">{current.artist}</p>}

                    {/* Album, year, length. Rendered ONLY for what we actually
                        know: these three come from the Spotify Web API, which
                        needs credentials that may not exist, so on the whole
                        pre-credential archive metaBits() returns [] and this
                        line is simply not there. A "—" placeholder would be a
                        worse answer than silence, and an "Unknown album" label
                        would be a lie with a straight face.

                        <ul> rather than one string because a screen reader
                        should read three facts as three facts. The separator is
                        a CSS ::before on the second and later items, so it is
                        never announced. */}
                    {metaBits(current).length > 0 && (
                        <ul class="song-meta">
                            {metaBits(current).map((bit) => <li>{bit}</li>)}
                        </ul>
                    )}

                    {current.note ? (
                        <p class="song-note">{current.note}</p>
                    ) : (
                        <p class="song-note song-note--empty">No note today. Just the song.</p>
                    )}

                    {/* The official embed. `current.id` has been through
                        /^[A-Za-z0-9]{22}$/ twice — once when it was pasted, once
                        when it was read back out of the store — before it gets
                        near this src, which is the only reason interpolating it
                        here is safe.

                        `allow` deliberately omits autoplay: music starting by
                        itself on a page she opened in bed is hostile, and the
                        play button is right there.

                        No `frameborder` attribute: it is deprecated HTML and
                        `astro check` flags it. The border is removed in
                        us-song.css instead (`.song-player iframe { border: 0 }`),
                        which is where presentation belongs anyway. */}
                    <div class="song-player">
                        <iframe
                            src={`https://open.spotify.com/embed/track/${current.id}`}
                            title={current.title ? `Spotify player: ${current.title}` : 'Spotify player'}
                            width="100%"
                            height="152"
                            loading="lazy"
                            allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture"
                            referrerpolicy="no-referrer"
                        ></iframe>
                    </div>

                    <p class="song-links">
                        <a
                            href={`https://open.spotify.com/track/${current.id}`}
                            target="_blank"
                            rel="noreferrer noopener"
                        >open in spotify &nearr;</a>
                    </p>
                </div>
            </div>

            {/* --------------------------------------------------------------
                REACTIONS

                Five sibling forms, one button each. Not one form with five
                buttons: which button submitted a multi-button form depends on
                name/value pairs that a keyboard Enter resolves differently
                across engines, and that is not a thing worth being clever about.

                The hidden `on` field carries the OPPOSITE of the current state,
                so a submit is always a toggle and the server is told the desired
                end state rather than an action. That is what makes the endpoint
                idempotent: a double-tap, a retry and a resubmitted form all land
                on the same value.
                -------------------------------------------------------------- */}
            <fieldset class="react-bar">
                <legend class="react-legend">did you hear it?</legend>
                <div class="react-row">
                    {REACTIONS.map((r) => {
                        const chosen = currentReactions.has(r.key);
                        return (
                            <form class="react-form" method="post" action="/api/us/react">
                                <input type="hidden" name="date" value={current.date}>
                                <input type="hidden" name="reaction" value={r.key}>
                                <input type="hidden" name="on" value={chosen ? '0' : '1'}>
                                <button class="react" type="submit" aria-pressed={chosen ? 'true' : 'false'}>
                                    <span class="react-emoji" aria-hidden="true">{r.emoji}</span>
                                    <span class="react-label">{r.label}</span>
                                </button>
                            </form>
                        );
                    })}
                </div>
            </fieldset>

            {/* Where the script announces the result of a tap. Visually hidden
                because the button's own pressed state is the visible feedback;
                this exists so that state change is also SPOKEN. */}
            <p class="sr-only" id="react-status" role="status" aria-live="polite"></p>
        </>
    ) : (
        <div class="song-blank">
            <p>
                <strong>Nothing yet today.</strong>
                {storeUnreachable
                    ? 'Or there is, and I cannot see it from here. Either way, check back.'
                    : `Which means I have not picked one yet, ${her}. Not that there isn't one. Check back later.`}
            </p>
        </div>
    )}

    <hr class="studio-rule">

    {/* ==================================================================
        THE EXCHANGE — her side of today

        RENDERED OUTSIDE THE `current ?` TERNARY ABOVE, on purpose and for
        two reasons.

        One: there is then exactly ONE reply form on the page. Putting it
        inside both branches would have meant two copies of a form, two
        ids, and a script that has to guess which one it is wired to.

        Two, and more important: SHE CAN GO FIRST. A morning I have not
        posted yet is exactly the morning she might want to start, and the
        endpoint deliberately does not require a song to exist that day.
        Hiding her half of the page whenever mine is empty would have made
        this a reply feature instead of a two-way one.
        ================================================================== */}

    <p class="song-eyebrow">
        {herReply ? 'what you sent back' : current ? 'your turn' : 'your side of today'}
    </p>

    {herReply ? (
        /* Her card, rendered by the SAME markup and the same classes as
           mine, with one modifier for the mirrored accent. That symmetry is
           the feature: a day is an exchange, so her half must not look like
           a receipt stapled to the bottom of my half. */
        <div class="song song--reply">
            <span class="song-frame">
                {herReply.art ? (
                    <img
                        class="song-art"
                        src={herReply.art}
                        alt=""
                        width="320"
                        height="320"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                    >
                ) : (
                    <span class="song-art--empty" aria-hidden="true">[ ]</span>
                )}
            </span>

            <div class="song-body">
                <p class="song-day song-day--reply">
                    you sent this
                    {postedAtLabel(herReply.postedAt) && (
                        <> &middot; {postedAtLabel(herReply.postedAt)}</>
                    )}
                </p>

                {herReply.title ? (
                    <h2 class="song-title">{herReply.title}</h2>
                ) : (
                    <h2 class="song-title song-title--unknown">a song Spotify would not name</h2>
                )}

                {herReply.artist && <p class="song-artist">{herReply.artist}</p>}

                {metaBits(herReply).length > 0 && (
                    <ul class="song-meta">
                        {metaBits(herReply).map((bit) => <li>{bit}</li>)}
                    </ul>
                )}

                {herReply.note && <p class="song-note">{herReply.note}</p>}

                {/* Her reply gets a real player too. The id has been through
                    /^[A-Za-z0-9]{22}$/ twice — once in extractTrackId when
                    she pasted it, once in parseTrack when it was read back
                    out of the store — before it reaches this src, which is
                    the only reason interpolating it here is safe.

                    `allow` omits autoplay for the same reason as mine: two
                    embeds on one page that could both start on their own is
                    a page that ambushes you. */}
                <div class="song-player">
                    <iframe
                        src={`https://open.spotify.com/embed/track/${herReply.id}`}
                        title={herReply.title ? `Spotify player: ${herReply.title}` : 'Spotify player'}
                        width="100%"
                        height="152"
                        loading="lazy"
                        allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture"
                        referrerpolicy="no-referrer"
                    ></iframe>
                </div>
            </div>
        </div>
    ) : (
        <p class="reply-lede">
            {current
                ? `Send one back, ${her}. Same shelf, same day — that is the whole idea.`
                : `Nothing from me yet today. You can still go first.`}
        </p>
    )}

    {/* ------------------------------------------------------------------
        THE FORM

        A real <form method="post" action="/api/us/reply"> that 303s back
        here, exactly like the reaction forms. It works with JavaScript
        switched off; the script at the bottom upgrades it to a fetch for
        ONE reason that actually matters — a native submit that fails has
        already navigated away and taken the note she just typed with it,
        and retyping a paragraph on a phone is the difference between doing
        this and not.

        <details> rather than two markup paths: `open` when she has not
        answered yet, closed once she has, so a day she has already
        answered is a card and not a big empty form. It collapses natively
        with no JavaScript at all.

        The hidden `date` is the day of the card above, not always today, so
        answering last night's song after midnight files it against the
        right morning. The server validates it anyway — it is a primary key
        and this page is not trusted to have got it right.
        ------------------------------------------------------------------ */}
    <details class="reply-details" open={!herReply}>
        <summary class="reply-summary">
            {herReply ? 'send a different one' : 'pick one'}
        </summary>

        <form class="dj-form reply-form" id="reply-form" method="post" action="/api/us/reply">
            <input type="hidden" name="date" value={current?.date ?? today}>

            <div class="dj-field">
                <label class="dj-label" for="reply-url">Spotify link</label>
                {/* type="text" with inputmode="url", NOT type="url": the
                    native URL validator rejects `spotify:track:...`, which
                    the endpoint accepts, so type="url" would block a valid
                    paste before it ever reached the server. */}
                <input
                    class="dj-input"
                    id="reply-url"
                    name="url"
                    type="text"
                    inputmode="url"
                    autocomplete="off"
                    autocapitalize="none"
                    autocorrect="off"
                    spellcheck="false"
                    placeholder="open.spotify.com/track/..."
                    aria-describedby="reply-url-hint"
                    required
                >
                <p class="dj-hint" id="reply-url-hint">
                    Share &rarr; Copy link, from the SONG. Album and playlist links
                    are rejected.
                </p>
            </div>

            <div class="dj-field">
                <label class="dj-label" for="reply-note">
                    Your note <span class="dj-opt">&mdash; why this one</span>
                </label>
                {/* maxlength matches MAX_NOTE in the endpoint. The browser
                    stopping her at 600 is friendlier than the server
                    silently truncating what she wrote. */}
                <textarea
                    class="dj-textarea"
                    id="reply-note"
                    name="note"
                    rows="4"
                    maxlength="600"
                ></textarea>
            </div>

            <button class="dj-submit" id="reply-submit" type="submit">
                {herReply ? 'replace it' : 'send it'}
            </button>

            {/* The enhancement script's channel. aria-live so the outcome is
                announced without moving focus; hidden until there is
                something to say. */}
            <p class="notice" id="reply-status" role="status" aria-live="polite" hidden></p>
        </form>
    </details>

    {/* ==================================================================
        ONE OLD MORNING, BROUGHT BACK

        Absent entirely until the archive is old enough for it to mean
        something (see RESURFACE_MIN_AGE_DAYS in kv.ts), which is also why
        there is no empty state for it: a "nothing to resurface yet" box
        would be a box explaining its own absence.

        A link, not an embed. Sixty players on a page is a page that never
        finishes loading, and this is the same reasoning that keeps iframes
        out of the archive below.
        ================================================================== */}
    {again && (
        <>
            <hr class="studio-rule">

            <p class="song-eyebrow">worth playing again</p>

            <a
                class="again"
                href={`https://open.spotify.com/track/${again.id}`}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={[
                    'From ' + wingDateLabel(again.date, { withYear: true }),
                    agoLabel(again.date, today),
                    again.title || 'a song I could not name',
                    'opens in Spotify',
                ].filter(Boolean).join('. ')}
            >
                {again.art ? (
                    <img
                        class="again-thumb"
                        src={again.art}
                        alt=""
                        width="72"
                        height="72"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                    >
                ) : (
                    <span class="again-thumb again-thumb--empty" aria-hidden="true">[ ]</span>
                )}
                <span class="again-body">
                    {/* aria-hidden on the visible day line: the same words are
                        already in the row's aria-label, and hearing them twice
                        is worse than not hearing them once. */}
                    <span class="again-day" aria-hidden="true">
                        {wingDateLabel(again.date, { withYear: true })} &middot; {agoLabel(again.date, today)}
                    </span>
                    <span class="again-title" aria-hidden="true">{again.title || 'a song I could not name'}</span>
                    {again.note && <span class="again-note" aria-hidden="true">{again.note}</span>}
                </span>
            </a>
        </>
    )}

    <hr class="studio-rule">

    <p class="song-eyebrow">every morning before this one</p>

    {archive.length > 0 ? (
        <ul class="archive">
            {archive.map((s) => {
                const { glyphs, words } = reactionGlyphs(s.date);
                /* Her reply for that day, if there was one. Named in the
                   aria-label as words and shown as a line in the row, NOT as a
                   nested link: an <a> inside an <a> is invalid HTML and browsers
                   resolve it by dropping one of them, unpredictably. The day is
                   still one row, and her half of it is still stated. */
                const reply = replyByDate[s.date] ?? null;
                const label = [
                    wingDateLabel(s.date, { withYear: true }),
                    s.title || 'a song I could not name',
                    words ? `you said: ${words}` : '',
                    reply ? `you sent back: ${reply.title || 'a song'}` : '',
                    'opens in Spotify',
                ]
                    .filter(Boolean)
                    .join('. ');
                return (
                    <li>
                        <a
                            class="archive-item"
                            href={`https://open.spotify.com/track/${s.id}`}
                            target="_blank"
                            rel="noreferrer noopener"
                            aria-label={label}
                        >
                            {s.art ? (
                                <img
                                    class="archive-thumb"
                                    src={s.art}
                                    alt=""
                                    width="56"
                                    height="56"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                >
                            ) : (
                                <span class="archive-thumb--empty" aria-hidden="true">[ ]</span>
                            )}
                            <span class="archive-body">
                                <span class="archive-day">{wingDateLabel(s.date, { withYear: true })}</span>
                                <span class="archive-title">{s.title || 'a song I could not name'}</span>
                                {s.note && <span class="archive-note">{s.note}</span>}
                                {/* aria-hidden: the same information is already
                                    in the row's aria-label, as words. */}
                                {reply && (
                                    <span class="archive-reply" aria-hidden="true">
                                        &#8617; you sent back {reply.title || 'a song'}
                                    </span>
                                )}
                                {glyphs && <span class="archive-reacts" aria-hidden="true">{glyphs}</span>}
                            </span>
                        </a>
                    </li>
                );
            })}
        </ul>
    ) : (
        <p class="archive-empty">
            {storeUnreachable
                ? 'The shelf is not answering. Nothing is lost.'
                : 'Nothing here yet. This is day one.'}
        </p>
    )}

    <hr class="studio-rule">

    <div class="studio-foot">
        <span class="studio-tag">Stronger for it.</span>
        <a href="/stronger/vault">&larr; back to the room</a>
    </div>
</div>

<script is:inline define:vars={{ renderedDate: today, wingTz: WING_TZ }}>
/* --------------------------------------------------------------------------
   Three jobs, and deliberately no more.

   Rendered unconditionally rather than wrapped in a template expression: a
   <script> inside `{...}` asks the Astro compiler to read JavaScript braces as
   template braces, and the failure mode is a build error in a file that reads
   as correct. Each block below bails out on its own if its markup is absent.

   1. REACTIONS WITHOUT A PAGE JUMP. The forms already work without this — 303,
      re-render, done. This only removes the navigation.

   2. HER REPLY, WITHOUT LOSING WHAT SHE TYPED. This one is not cosmetic. A
      native form submit that fails has already navigated away, and the note is
      gone with it. Everything this block buys is: on failure, the paragraph is
      still in the textarea.

   3. THE DAY ROLLOVER. Her phone will keep this tab alive for a week. Without
      this, coming back to it on Tuesday shows Monday's song with no hint that it
      is stale.
   -------------------------------------------------------------------------- */
(function () {
    var status = document.getElementById('react-status');

    /* ---- 1. reactions ------------------------------------------------- */
    var forms = Array.prototype.slice.call(document.querySelectorAll('.react-form'));

    /**
     * One request at a time, globally.
     *
     * Not politeness — correctness. On the R2 storage tier every reaction is a
     * read-modify-write of one JSON object, so two overlapping taps can have the
     * second read land before the first write and silently discard it.
     * Serializing here does not fix that race (only the store could) but it
     * removes the one way this UI could reliably cause it: an impatient thumb.
     */
    var busy = false;

    /** Repaint ALL five buttons from the server's answer, not from what we
     *  assumed would happen. One source of truth, even for optimism. */
    function paint(list) {
        var on = {};
        for (var i = 0; i < list.length; i++) on[list[i]] = true;
        forms.forEach(function (form) {
            var key = form.elements.reaction.value;
            var button = form.querySelector('.react');
            var isOn = !!on[key];
            button.setAttribute('aria-pressed', isOn ? 'true' : 'false');
            // The hidden field always carries the OPPOSITE, so the no-JS path
            // stays correct if she reloads after tapping.
            form.elements.on.value = isOn ? '0' : '1';
        });
    }

    function say(text) {
        if (status) status.textContent = text;
    }

    forms.forEach(function (form) {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            if (busy) return;

            var button = form.querySelector('.react');
            var key = form.elements.reaction.value;
            var label = (form.querySelector('.react-label') || {}).textContent || key;
            var want = form.elements.on.value === '1';

            busy = true;
            button.dataset.busy = '';

            var res, data;
            try {
                res = await fetch('/api/us/react', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        date: form.elements.date.value,
                        reaction: key,
                        on: want
                    })
                });
                data = await res.json();
            } catch (err) {
                say('that did not save. try again?');
                return;
            } finally {
                busy = false;
                delete button.dataset.busy;
            }

            if (!res.ok || !data || data.ok !== true) {
                say('that did not save. not your fault.');
                return;
            }

            paint(data.reactions || []);
            say(label + (want ? ': yes' : ': taken back'));
        });
    });

    /* ---- 2. her reply -------------------------------------------------- */

    (function () {
        var form = document.getElementById('reply-form');
        var submit = document.getElementById('reply-submit');
        var out = document.getElementById('reply-status');
        // Bails out rather than throwing if the markup is ever absent. Everything
        // below is an enhancement over a form that already works.
        if (!form || !submit || !out) return;

        var MESSAGES = {
            'bad-url': "that isn't a spotify TRACK link — copy the link from the song itself.",
            'bad-date': 'that day is not a real day.',
            'future-date': "that day hasn't happened yet.",
            'bad-request': "the server couldn't read that.",
            unauthorized: 'your session ran out. answer the questions again and you are back in.',
            unconfigured: 'something is unplugged on my end. not your fault.',
            store: "that didn't save. nothing was sent. try again?",
            rate: 'give it a minute.'
        };

        function say(kind, text) {
            // The word is part of the message, so this never depends on colour.
            out.dataset.kind = kind;
            out.textContent = (kind === 'bad' ? 'hm — ' : 'sent — ') + text;
            out.hidden = false;
        }

        var label = submit.textContent;

        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            var body = {
                url: form.elements.url.value.trim(),
                note: form.elements.note.value,
                date: form.elements.date.value
            };
            if (!body.url) {
                say('bad', 'paste a link first.');
                form.elements.url.focus();
                return;
            }

            submit.disabled = true;
            submit.textContent = 'sending';

            var res, data;
            try {
                res = await fetch('/api/us/reply', {
                    // JSON in, JSON out. The endpoint keys its response shape off
                    // this header, so the no-JS form POST still gets its redirect.
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(body)
                });
                data = await res.json();
            } catch (err) {
                say('bad', 'the server did not answer. nothing was sent. try again.');
                return;
            } finally {
                submit.disabled = false;
                submit.textContent = label;
            }

            if (!res.ok || !data || data.ok !== true) {
                var code = (data && data.error) || 'no';
                say('bad', MESSAGES[code] || 'that did not go through. nothing was sent.');
                return;
            }

            say('ok', data.degraded
                ? "it's on the shelf, though Spotify would not name it. The player still will."
                : "it's on the shelf. I'll see it.");

            /* Hand control back to the SERVER rather than painting her card from
               this response. Patching it here would mean a second renderer in
               JavaScript — art vs placeholder, title vs the unnamed fallback, the
               embed, the meta line — that can disagree with the Astro one, and a
               card that disagrees with the store is worse than a reload. The short
               pause is so the line above is readable first. */
            setTimeout(function () {
                window.location.assign('/stronger/vault/today?sent=' + encodeURIComponent(data.date));
            }, 700);
        });
    })();

    /* ---- 3. the day rollover ------------------------------------------ */

    /** The same calendar rule the server used, so the two cannot disagree. */
    function clientWingDate() {
        try {
            return new Intl.DateTimeFormat('en-CA', {
                timeZone: wingTz,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
            }).format(new Date());
        } catch (err) {
            // An engine without that timezone would report a wrong date, and a
            // wrong date here means a spurious reload loop. Better to do nothing.
            return renderedDate;
        }
    }

    var checking = false;

    async function checkForNewDay() {
        if (document.hidden || checking) return;
        if (clientWingDate() === renderedDate) return;

        /* The day has changed. Ask the server what is on the shelf now — and
           note that we RELOAD rather than patch the card in place. Patching
           would mean a second renderer in JavaScript (art vs placeholder,
           title vs the unnamed fallback, the embed, the reaction states) that
           can disagree with the Astro one, and a card that disagrees with the
           server is worse than a flash of white. The probe is only here so a
           day with nothing posted yet does not reload her page for nothing. */
        checking = true;
        try {
            var res = await fetch('/api/us/song', {
                headers: { Accept: 'application/json' },
                credentials: 'same-origin'
            });
            if (!res.ok) return;
            var data = await res.json();
            // Reload only when the SERVER also agrees the day rolled over AND
            // there is something new to show. `data.reply` is in that test
            // because she may have gone first: a new day whose only content is
            // her own reply is still a page that is showing the wrong day.
            if (data && data.ok && data.date !== renderedDate && (data.today || data.reply)) {
                window.location.reload();
            }
        } catch (err) {
            /* Offline, or the store is down. Leave her page exactly as it is. */
        } finally {
            checking = false;
        }
    }

    document.addEventListener('visibilitychange', checkForNewDay);
    window.addEventListener('focus', checkForNewDay);
})();
</script>
</body>
</html>

                    <!-- 06 Vancouver -->
                    <article class="pass pass--aircanada reveal gsap-reveal">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="assets/airlines/aircanada-t-c.png" alt="Air Canada"></span>

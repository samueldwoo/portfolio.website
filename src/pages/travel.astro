                    <article class="pass pass--frontier reveal gsap-reveal">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="assets/airlines/frontier-c.png" alt="Frontier Airlines"></span>

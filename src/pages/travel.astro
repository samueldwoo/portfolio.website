---
import Base from '../layouts/Base.astro';
import SiteFoot from '../components/SiteFoot.astro';

/**
 * Trip index — the same 11 trips as the boarding passes below, in the same
 * order, kept here only so the summary strip can be DERIVED rather than
 * hand-tallied. If you add or remove a pass, add or remove its row here too.
 *
 * Deliberately NOT a chart library and NOT a React island: this is eleven
 * integers. Plain CSS columns render at build time, cost zero JS, survive
 * JS being off, and inherit the site's existing `.reveal` motion (which
 * already has a prefers-reduced-motion override), so there is no second
 * motion system to keep honest.
 */
const trips = [
    { month: '2025-09', dest: 'Japan' },
    { month: '2025-09', dest: 'Korea' },
    { month: '2026-04', dest: 'Mexico' },
    { month: '2026-05', dest: 'Hawaii' },
    { month: '2025-10', dest: 'New York' },
    { month: '2026-07', dest: 'Canada' },
    { month: '2026-06', dest: 'Seattle' },
    { month: '2026-07', dest: 'Detroit' },
    { month: '2026-05', dest: 'San Diego' },
    { month: '2025-12', dest: 'San Diego' },
    { month: '2026-07', dest: 'Lake Tahoe' },
];

// Continuous month axis from first trip to last, so empty months stay visible
// as gaps — the whole point is the RHYTHM, and skipping quiet months would
// flatter the record by hiding them.
const MONTH_ABBR = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const keys = trips.map((t) => t.month).sort();
const [firstY, firstM] = keys[0].split('-').map(Number);
const [lastY, lastM] = keys[keys.length - 1].split('-').map(Number);

type Mo = { key: string; year: number; m: number; count: number };
const months: Mo[] = [];
for (let y = firstY, m = firstM; y < lastY || (y === lastY && m <= lastM); ) {
    const key = `${y}-${String(m).padStart(2, '0')}`;
    months.push({ key, year: y, m, count: trips.filter((t) => t.month === key).length });
    m += 1;
    if (m > 12) { m = 1; y += 1; }
}

const peak = Math.max(...months.map((mo) => mo.count));
const destinations = new Set(trips.map((t) => t.dest)).size;
// A one-month span would otherwise read "Mar 2026 – Mar 2026".
const spanLabel = firstY === lastY && firstM === lastM
    ? `${MONTH_ABBR[firstM - 1]} ${firstY}`
    : `${MONTH_ABBR[firstM - 1]} ${firstY} – ${MONTH_ABBR[lastM - 1]} ${lastY}`;

// "Jul ’26" is the plot's own column-label form, reused so the strip and the
// axis below it agree; "Jul 2026" is the form for prose and speech.
const shortLabel = (mo: Mo) => `${MONTH_ABBR[mo.m - 1]} ’${String(mo.year).slice(2)}`;
const longLabel = (mo: Mo) => `${MONTH_ABBR[mo.m - 1]} ${mo.year}`;
// Everything below is generated prose, so it has to survive n === 1 without
// saying "1 trips across 1 months", and a 3-way tie without "A and B and C".
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const listAnd = (items: string[]) => items.length < 3
    ? items.join(' and ')
    : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;

/* BUSIEST MONTH. This term used to render `<dt>Busiest month</dt><dd>3
   trips</dd>` — the label asked for a MONTH and the value answered with a
   COUNT, so the pairing a <dl> exists to assert was simply false. The month
   is derived now, never typed, and two cases the old line could not have
   survived are handled:
     - a TIE. Add one May 2026 trip and May ties Jul at 3; the term
       pluralises and every peak month is named.
     - a record where NO month repeats, which has no "busiest" month to
       point at. The term then falls back to the count it can honestly
       report, so the pairing stays true instead of naming an arbitrary
       first-of-eleven.
   The count still travels with the value for screen readers; sighted readers
   read it off the tallest column directly below, which is what the plot is
   for. */
const peakMonths = months.filter((mo) => mo.count === peak);
const peakNamed = peak > 1;
const peakTerm = !peakNamed
    ? 'Most in a month'
    : peakMonths.length === 1 ? 'Busiest month' : 'Busiest months';
const peakValue = peakNamed ? peakMonths.map(shortLabel).join(', ') : String(peak);
/* The count, VISIBLE rather than screen-reader-only. Naming the month fixed the
   term/value mismatch but took the count off the page, and the count is the
   more interesting half of "busiest month". Shown as a mono subscript
   (`.trip-stat-sub`, styles.css) so it annotates the month instead of competing
   with it — and because it is now real text, one string serves sighted and
   screen-reader users alike, with no risk of the two drifting apart.
   Empty when the term is already "Most in a month", where the value IS the
   count and repeating it would read as "1 1 trip". */
const peakSub = peakNamed
    ? `${plural(peak, 'trip')}${peakMonths.length > 1 ? ' each' : ''}`
    : '';

/* TEXT ALTERNATIVE for the plot (WCAG 1.1.1). Every column states its own
   month and count, but arrowing through eleven list items does not hand a
   non-sighted reader the SHAPE — and where the quiet stretches fall is the
   entire reason this strip exists, since the wall above is ordered by feel
   and not by date. One derived sentence does, and it stays true if the array
   changes. */
const quiet = months.filter((mo) => mo.count === 0).length;
let longestGap: Mo[] = [];
let run: Mo[] = [];
for (const mo of months) {
    // Rebuilt, never mutated, so `longestGap` keeps a stable snapshot.
    run = mo.count === 0 ? [...run, mo] : [];
    if (run.length > longestGap.length) longestGap = run;
}
const gapSentence = longestGap.length === 0
    ? 'Every month in that span had at least one trip.'
    : longestGap.length === 1
        ? `The longest quiet stretch was a single month, ${longLabel(longestGap[0])}.`
        : `The longest quiet stretch was ${plural(longestGap.length, 'month')}, ${longLabel(longestGap[0])} to ${longLabel(longestGap[longestGap.length - 1])}.`;
const plotSummary = [
    `${plural(trips.length, 'trip')} to ${plural(destinations, 'destination')} across ${plural(months.length, 'month')}, ${spanLabel.replace(' – ', ' to ')}.`,
    peakNamed
        ? `${listAnd(peakMonths.map(longLabel))} ${peakMonths.length === 1 ? 'was' : 'were'} the busiest at ${plural(peak, 'trip')}${peakMonths.length > 1 ? ' each' : ''}.`
        : 'No month had more than one trip.',
    quiet > 0 ? `${quiet} of those months had no trips.` : null,
    gapSentence,
    'Month-by-month counts follow.',
].filter(Boolean).join(' ');
---

<Base
    title="Travel — Samuel Woo"
    description="Places Samuel Woo has traveled — a wall of boarding passes."
    page="travel"
    skipTarget="travel"
>
    {/* The Kaushan Script / Oswald / Archivo stylesheet that used to load here
        is GONE. It was described as "airline-wordmark approximations", but the
        wordmarks are all <img> logos now and nothing referenced those three
        families: grepped across public/ and src/, the only hit was the <link>
        itself. It cost a third-party stylesheet request plus up to six font
        files on the critical path of this page for zero rendered glyphs.
        `.pass-airline` ("Road Trip", the one text wordmark left) uses the
        site's own --display stack. */}

    <main class="content">

        {/* TRAVEL HERO */}
        <section id="travel" class="band band-travel-hero band--shapes" aria-labelledby="travel-title">
            {/* Flight-path line art: the arc draws itself in, then a sage dot
                 flies it on a loop. Static (arc drawn, dot parked) with motion off. */}
            <svg class="shape-field shape-field--travel" viewBox="0 0 320 220" fill="none" aria-hidden="true">
                <g class="shape-drift">
                    <circle class="shape-ring" cx="160" cy="150" r="104" />
                    <path class="shape-line flight-arc" d="M42 168 C 92 44, 228 44, 278 168" />
                    <path class="shape-line" d="M20 190 L 300 190" />
                    <circle class="shape-dot" cx="42" cy="168" r="4.5" />
                    <circle class="shape-dot" cx="278" cy="168" r="4.5" />
                    <circle class="shape-dot shape-dot--soft flight-dot" cx="42" cy="168" r="5.5" />
                    <path class="shape-tick" d="M34 202 L 34 210 M90 202 L 90 210 M146 202 L 146 210 M202 202 L 202 210 M258 202 L 258 210" />
                </g>
            </svg>
            <div class="band-inner">
                <p class="kicker reveal reveal-clip">Travel</p>
                <h1 id="travel-title" class="section-title reveal reveal-clip">Where I've been</h1>
                <p class="section-intro reveal">I plan trips around meals and mostly regret nothing. Every stub below is a real one — pulled straight from the places my card statements say I actually went.</p>
            </div>
        </section>

        {/* BOARDING PASS WALL */}
        {/* Inverted, which is the whole point of the wall: the passes are
             saturated airline colours, and on the light sheet they read as
             eleven bright rectangles floating in white space. On the dark
             plate they read as a departures board — the plate does the job a
             gallery wall does. `.band--dark` redefines tokens for its
             subtree; each `.pass` carries its own `--pass-bg`/`--pass-ink`,
             so no pass colour or contrast moves. */}
        <section class="band band-flush-top band--dark" aria-labelledby="wall-title">
            <div class="band-inner" data-rail="02 / Boarding passes">
                {/* HEADING STRUCTURE. Audited, this page had exactly ONE heading
                    on it — the h1 — while the boarding-pass wall, which is the
                    entire substance of the page, had no heading at all: a
                    reader navigating by heading found nothing after "Where I've
                    been". The band identifies itself visually through its
                    inverted plate and its rotated `data-rail` running head,
                    neither of which reaches the accessibility tree (the rail is
                    generated content). This h2 supplies the missing rung and
                    also gives the section a real accessible name, replacing the
                    free-floating `aria-label` that duplicated it. */}
                <h2 id="wall-title" class="visually-hidden">Boarding passes</h2>

                {/* Trip cadence. The wall below is ordered by feel, not by
                     date, so the one fact it genuinely hides is WHEN the trips
                     clustered. Count is encoded by the NUMBER of stacked marks
                     and restated as hidden TEXT in every column, never by hue —
                     the sage fill is decorative reinforcement only. Empty
                     months are told apart by tick HEIGHT, not colour. Quiet
                     months are kept on the axis as bare baseline ticks rather
                     than dropped, so the gaps read as gaps, and a derived
                     one-sentence summary above the plot states that shape for
                     anyone who cannot see it. */}
                <figure class="trip-summary reveal">
                    <figcaption class="trip-summary-head">
                        {/* A real <h3>, not a styled <span>: the cadence chart was
                            the only substantive block on this page with no heading,
                            so it could not be reached by heading navigation. The UA's
                            default margin and bold weight are reset in styles.css so
                            the baseline-aligned flex row is unchanged. */}
                        <h3 class="trip-summary-title">Trip cadence</h3>
                        <span class="trip-summary-span">{spanLabel}</span>
                    </figcaption>

                    <dl class="trip-stats">
                        <div class="trip-stat">
                            <dt>Trips</dt>
                            <dd>{trips.length}</dd>
                        </div>
                        <div class="trip-stat">
                            <dt>Destinations</dt>
                            <dd>{destinations}</dd>
                        </div>
                        <div class="trip-stat">
                            <dt>{peakTerm}</dt>
                            <dd>{peakValue}{peakSub && <span class="trip-stat-sub">{peakSub}</span>}</dd>
                        </div>
                    </dl>

                    <p class="visually-hidden">{plotSummary}</p>

                    {/* The list carries an accessible name of its own: the
                        figure's name comes from its <figcaption>, which says
                        "Trip cadence" and a date range but never says what the
                        eleven items ARE. */}
                    <ul class="trip-plot" style={`--trip-peak:${peak}`} aria-label="Trips per month">
                        {months.map((mo) => (
                            <li class:list={['trip-col', { 'is-empty': mo.count === 0 }]}>
                                <span class="trip-marks" aria-hidden="true">
                                    {Array.from({ length: mo.count }).map(() => (
                                        <span class="trip-mark"></span>
                                    ))}
                                </span>
                                <span class="trip-col-tick" aria-hidden="true"></span>
                                {/* Full 3-letter month. A single initial would
                                    render three indistinguishable "J"s
                                    (Jan/Jun/Jul) and two "M"s (Mar/May) on
                                    this exact span; the year is appended only
                                    where it turns over, to mark the boundary
                                    without repeating itself 11 times.

                                    An expression comment, not an HTML one: this
                                    note sits INSIDE `months.map()`, and Astro
                                    ships HTML comments verbatim. Measured in the
                                    built page — the HTML form appeared 11
                                    times, ~4.3 KB of duplicated developer note
                                    in a 37 KB document. The expression form is
                                    stripped at build.
                                    (Do not write the comment-closing sequence
                                    inside one of these, even in backticks — it
                                    terminates the comment early and the build
                                    fails with "Unexpected token". That is
                                    exactly how this line broke once.) */}
                                <span class="trip-col-label" aria-hidden="true">
                                    {mo.m === 1 || mo.key === months[0].key
                                        ? shortLabel(mo)
                                        : MONTH_ABBR[mo.m - 1]}
                                </span>
                                {/* REAL TEXT, not an `aria-label` on the <li>.
                                    ARIA permits naming a `listitem`, but every
                                    visible child here is aria-hidden, so the
                                    item's only accessible text WAS that label —
                                    and VoiceOver is unreliable about honouring
                                    author names on list items, which left the
                                    column liable to being announced as empty.
                                    Hidden text is announced by every screen
                                    reader in every mode. `.visually-hidden` is
                                    `position:absolute`, so it is not a flex
                                    item and takes no share of `.trip-col`'s
                                    6px gap — the column's layout is unchanged. */}
                                <span class="visually-hidden">
                                    {longLabel(mo)}: {mo.count} {mo.count === 1 ? 'trip' : 'trips'}
                                </span>
                            </li>
                        ))}
                    </ul>
                </figure>

                {/* 12-column grid (layout.css §12). This comment used to
                     claim "the two long-haul passes span six columns across
                     the top row, then three rows of three" — it does not
                     happen and never did. Every pass gets `grid-column: span
                     4` at >=1080px with no per-pass override anywhere (no
                     `.pass--wide`, and the `:nth-child` ladder sets only
                     `rotate`/`translate`), so the wall is a uniform 3-up:
                     rows of 3, 3, 3, 2. Measured in the built page at
                     1440px — all 11 passes `span 4`, ~299px wide each, four
                     row offsets. It collapses to 2-up at 760–1079px and
                     1-up below 760px. Uniform is the point: every stub is
                     the same size, which is a hard requirement.
                     gsap-motion.js staggers the wall with `grid: 'auto'`,
                     measuring the real laid-out geometry, so the diagonal
                     entrance adapts to each collapse on its own. */}
                <div class="pass-wall">

                    {/* 01 Tokyo */}
                    <article class="pass pass--zipair reveal gsap-reveal" aria-labelledby="pass-1-route">
                        <div class="pass-main">
                            <div class="pass-head">
                                {/* The wordmark in this file reads "ZIPAIR", one
                                     word, and that is the airline's name; the alt
                                     said "Zip Air". These logos are IMAGES OF
                                     TEXT, so the alt has to be the words in the
                                     image.
                                     `loading` is lazy like the other ten, not
                                     eager. Eager was justified as "the first
                                     visible row", but measured in the built page
                                     at 1440x757 the wall starts at y=910 — the
                                     whole wall, this pass included, is below the
                                     fold, so eager only put a 14.6 KB PNG on the
                                     hero's critical path. gsap-motion.js §9
                                     already refreshes ScrollTrigger per image
                                     load, so late-decoding logos are handled. */}
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="/assets/airlines/zipair-t-c.png" alt="ZIPAIR" width="254" height="60" loading="lazy" decoding="async"></span>
                                <span class="pass-date"><span class="pass-k">Date</span>Sep 2025</span>
                            </div>
                            <div class="pass-cities" id="pass-1-route"><span>San Jose</span><span class="visually-hidden">to</span><span>Tokyo</span></div>
                            <div class="pass-route">
                                <span class="pass-code">SJC</span>
                                <svg class="pass-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h16m0 0l-4-4m4 4l-4 4M20 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="pass-code">NRT</span>
                            </div>
                            <div class="pass-foot">
                                <span class="pass-dest"><span class="pass-k">Destination</span><span class="pass-destv">Japan</span></span>
                                <span class="pass-spent"><span class="pass-k">Spent on</span><span class="pass-v">Travel</span></span>
                            </div>
                        </div>
                        <div class="pass-stub" aria-hidden="true">
                            <span class="pass-idx">01</span>
                            <span class="pass-barcode"></span>
                        </div>
                    </article>

                    {/* 02 Seoul */}
                    <article class="pass pass--korean reveal gsap-reveal" aria-labelledby="pass-2-route">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="/assets/airlines/korean-c.png" alt="Korean Air" width="264" height="31" loading="lazy" decoding="async"></span>
                                <span class="pass-date"><span class="pass-k">Date</span>Sep 2025</span>
                            </div>
                            <div class="pass-cities" id="pass-2-route"><span>Osaka</span><span class="visually-hidden">to</span><span>Seoul</span></div>
                            <div class="pass-route">
                                <span class="pass-code">KIX</span>
                                <svg class="pass-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h16m0 0l-4-4m4 4l-4 4M20 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="pass-code">ICN</span>
                            </div>
                            <div class="pass-foot">
                                <span class="pass-dest"><span class="pass-k">Destination</span><span class="pass-destv">Korea</span></span>
                                <span class="pass-spent"><span class="pass-k">Spent on</span><span class="pass-v">Travel</span></span>
                            </div>
                        </div>
                        <div class="pass-stub" aria-hidden="true">
                            <span class="pass-idx">02</span>
                            <span class="pass-barcode"></span>
                        </div>
                    </article>

                    {/* 03 Mexico City */}
                    <article class="pass pass--aeromexico reveal gsap-reveal" aria-labelledby="pass-3-route">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="/assets/airlines/aeromexico-c.png" alt="Aeroméxico" width="264" height="42" loading="lazy" decoding="async"></span>
                                <span class="pass-date"><span class="pass-k">Date</span>Apr 2026</span>
                            </div>
                            <div class="pass-cities" id="pass-3-route"><span>San Jose</span><span class="visually-hidden">to</span><span>Mexico City</span></div>
                            <div class="pass-route">
                                <span class="pass-code">SJC</span>
                                <svg class="pass-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h16m0 0l-4-4m4 4l-4 4M20 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="pass-code">MEX</span>
                            </div>
                            <div class="pass-foot">
                                <span class="pass-dest"><span class="pass-k">Destination</span><span class="pass-destv">Mexico</span></span>
                                <span class="pass-spent"><span class="pass-k">Spent on</span><span class="pass-v">Dining</span></span>
                            </div>
                        </div>
                        <div class="pass-stub" aria-hidden="true">
                            <span class="pass-idx">03</span>
                            <span class="pass-barcode"></span>
                        </div>
                    </article>

                    {/* 04 Hawaii */}
                    <article class="pass pass--hawaiian reveal gsap-reveal" aria-labelledby="pass-4-route">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="/assets/airlines/hawaiian-t-c.png" alt="Hawaiian Airlines" width="217" height="60" loading="lazy" decoding="async"></span>
                                <span class="pass-date"><span class="pass-k">Date</span>May 2026</span>
                            </div>
                            <div class="pass-cities" id="pass-4-route"><span>San Jose</span><span class="visually-hidden">to</span><span>Honolulu</span></div>
                            <div class="pass-route">
                                <span class="pass-code">SJC</span>
                                <svg class="pass-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h16m0 0l-4-4m4 4l-4 4M20 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="pass-code">HNL</span>
                            </div>
                            <div class="pass-foot">
                                <span class="pass-dest"><span class="pass-k">Destination</span><span class="pass-destv">Hawaii</span></span>
                                <span class="pass-spent"><span class="pass-k">Spent on</span><span class="pass-v">Travel</span></span>
                            </div>
                        </div>
                        <div class="pass-stub" aria-hidden="true">
                            <span class="pass-idx">04</span>
                            <span class="pass-barcode"></span>
                        </div>
                    </article>

                    {/* 05 New York */}
                    <article class="pass pass--jetblue reveal gsap-reveal" aria-labelledby="pass-5-route">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="/assets/airlines/jetblue-c.png" alt="JetBlue" width="183" height="60" loading="lazy" decoding="async"></span>
                                <span class="pass-date"><span class="pass-k">Date</span>Oct 2025</span>
                            </div>
                            <div class="pass-cities" id="pass-5-route"><span>San Jose</span><span class="visually-hidden">to</span><span>New York</span></div>
                            <div class="pass-route">
                                <span class="pass-code">SJC</span>
                                <svg class="pass-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h16m0 0l-4-4m4 4l-4 4M20 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="pass-code">JFK</span>
                            </div>
                            <div class="pass-foot">
                                <span class="pass-dest"><span class="pass-k">Destination</span><span class="pass-destv">New York</span></span>
                                <span class="pass-spent"><span class="pass-k">Spent on</span><span class="pass-v">Dining</span></span>
                            </div>
                        </div>
                        <div class="pass-stub" aria-hidden="true">
                            <span class="pass-idx">05</span>
                            <span class="pass-barcode"></span>
                        </div>
                    </article>

                    {/* 06 Vancouver */}
                    <article class="pass pass--aircanada reveal gsap-reveal" aria-labelledby="pass-6-route">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="/assets/airlines/aircanada-t-c.png" alt="Air Canada" width="264" height="35" loading="lazy" decoding="async"></span>
                                <span class="pass-date"><span class="pass-k">Date</span>Jul 2026</span>
                            </div>
                            <div class="pass-cities" id="pass-6-route"><span>San Jose</span><span class="visually-hidden">to</span><span>Vancouver</span></div>
                            <div class="pass-route">
                                <span class="pass-code">SJC</span>
                                <svg class="pass-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h16m0 0l-4-4m4 4l-4 4M20 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="pass-code">YVR</span>
                            </div>
                            <div class="pass-foot">
                                <span class="pass-dest"><span class="pass-k">Destination</span><span class="pass-destv">Canada</span></span>
                                <span class="pass-spent"><span class="pass-k">Spent on</span><span class="pass-v">Dining</span></span>
                            </div>
                        </div>
                        <div class="pass-stub" aria-hidden="true">
                            <span class="pass-idx">06</span>
                            <span class="pass-barcode"></span>
                        </div>

                    <!-- 07 Seattle -->
                    <article class="pass pass--alaska reveal gsap-reveal">
                        <div class="pass-main">
                            <div class="pass-head">
                                <span class="pass-logoband"><img class="pass-logo pass-logo--white" src="assets/airlines/alaska-c.png" alt="Alaska Airlines"></span>

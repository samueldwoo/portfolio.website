---
/**
 * Base.astro — the single source of truth for <head>, the atmosphere layer,
 * the skip link and the top nav. Previously triplicated verbatim across
 * index.html / projects.html / travel.html.
 *
 * Every per-page difference is a prop:
 *   title / description  — <head> metadata
 *   page                 — 'home' | 'projects' | 'travel'; drives the brand
 *                          href, whether nav hrefs are same-page hashes or
 *                          cross-page, and which link carries is-active +
 *                          aria-current
 *   skipTarget           — the skip-link's #id ('home' | 'projects' | 'travel')
 *
 * The `head` slot lets a page append extra <head> tags (travel.html loads a
 * second Google Fonts stylesheet for the airline wordmarks).
 *
 * ---------------------------------------------------------------------------
 * NAVIGATION (see public/css/nav.css for the full rationale)
 *
 * The bar is `position: fixed` with an explicit `.topbar-spacer` holding the
 * old 68px of flow space. It used to be `sticky`, but the bar now condenses
 * on scroll and a sticky element that changes height drags every pixel of the
 * document up with it. Fixed + a constant spacer makes the height purely
 * visual. `--topbar-h` stays the layout reservation that styles.css's
 * `.band { scroll-margin-top }` is calibrated against.
 *
 * Two native <dialog>s live at the end of <body>:
 *   #nav-drawer — the mobile menu
 *   #cmdk       — the Cmd/Ctrl-K command palette
 * Native + showModal() rather than a div, because that is where the focus
 * trap, Escape-to-close, top-layer stacking and focus restoration come from
 * for free. Their section lists are filled in by script.js from the page's
 * own `.band` elements, so a page that gains a section gains a nav entry with
 * no edit here.
 *
 * The <head> carries one inline classList line. It has to be inline and in
 * <head> so `.nav-js` is set before first paint: without JS the dialogs can
 * never open, so nav.css keeps the link row on screen at every width, and
 * that fallback must not flash for readers who do have JS.
 * ---------------------------------------------------------------------------
 */
interface Props {
  title: string;
  description: string;
  page: 'home' | 'projects' | 'travel';
  skipTarget: string;
}

const { title, description, page, skipTarget } = Astro.props;

// On the home page the section links are same-page hashes and carry data-nav
// so script.js's scroll-spy can claim them. From the sub-pages they point back
// at index.html and there is nothing to spy on.
const isHome = page === 'home';
/* ROOT-ABSOLUTE, not relative, and this is a bug fix rather than a preference.
   These used to be `index.html#home`. That was correct while pages emitted as
   flat files at the root (`/projects.html`), because a relative `index.html`
   resolved to `/index.html`. Adding the Vercel adapter forced
   `build.format: 'directory'`, so the page now lives at `/projects/`, and the
   SAME relative href resolves to `/projects/index.html` — which is the projects
   page itself. Every cross-page nav link, the brand and the footer silently
   pointed at the page you were already on, with a dead anchor.
   The `/index.html` -> `/` redirect never fired, because the browser never
   requested `/index.html`. A leading slash is what makes these absolute. */
const brandHref = isHome ? '#home' : '/#home';
const href = (hash: string) => (isHome ? `#${hash}` : `/#${hash}`);
const spy = (hash: string) => (isHome ? { 'data-nav': hash } : {});

// Cross-page destinations, shared by the drawer and (via the DOM) harvested
// into the command palette so there is exactly one list to keep correct.
const pageLinks = [
  { key: 'home', label: 'Home', href: brandHref },
  { key: 'projects', label: 'Projects', href: '/projects' },
  { key: 'travel', label: 'Travel', href: '/travel' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="description" content={description}>
    <title>{title}</title>

    <!-- Nav capability flag. Inline and in <head> on purpose: nav.css's
         no-JS fallback keeps the full link row on screen at mobile widths
         (because the drawer needs showModal() to open at all), and that
         fallback must not flash before script.js runs at the end of body. -->
    <script is:inline>document.documentElement.classList.add('nav-js');</script>

    <!-- Animation capability flag, set BEFORE first paint for the same reason
         nav-js is: `html.js-anim .reveal` carries the invisible from-state, so
         setting it late would paint the finished page and then hide it.

         The timer is the safety net. `.reveal` used to be opacity:0
         unconditionally, which meant a script.js that never loaded left the page
         blank — see the note in styles.css and the 404 incident recorded below.
         script.js adds `anim-live` as soon as it runs (whether it goes on to
         animate or to reveal everything immediately), so if that has not
         happened by the deadline the from-state is withdrawn and the content
         simply appears. Failure degrades to "no animation", never to "no page". -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js-anim');
        setTimeout(function () {
          if (!d.classList.contains('anim-live')) d.classList.remove('js-anim');
        }, 3000);
      })();
    </script>

    <!-- Inline SVG favicon: sage "S" monogram on a light canvas -->
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23eceee6'/%3E%3Ctext x='16' y='23' font-family='Verdana,Geneva,sans-serif' font-size='20' font-weight='700' text-anchor='middle' fill='%235f7a4f'%3ES%3C/text%3E%3C/svg%3E">

    <!-- Google Fonts: Space Grotesk (display), Inter (body/UI), DM Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <slot name="head" />

    <!-- ASSET PATHS ARE ROOT-ABSOLUTE ("/styles.css"), NOT RELATIVE. Do not
         "tidy" the leading slash away.

         These were relative while astro.config set `build.format: 'file'`, which
         emitted every page at the root (/travel.html), so "styles.css" resolved
         to /styles.css. @astrojs/vercel hard-forces `build.format: "directory"`,
         so pages now emit at /travel/index.html and a relative "styles.css"
         resolves to /travel/styles.css — a 404.

         Measured on the built output before this fix: /projects and /travel each
         threw 21 severe console errors and rendered with NO CSS and NO JS at all.
         All 13 refs here plus the 10 airline logos in travel.astro were broken;
         the homepage was fine only because it happens to live at the root.

         The redirects in astro.config.mjs do NOT cover this. They rewrite an
         incoming PAGE url; they cannot touch a relative ASSET url inside the
         HTML that gets served. -->
    <!-- The hand-written stylesheet, served verbatim from public/ as one
         global sheet. Deliberately NOT imported through Astro/Vite: no
         scoping, no splitting, no hashing — same file, same cascade. -->
    <link rel="stylesheet" href="/styles.css">

    <!-- Domain-split overhaul layer, loaded in cascade order AFTER styles.css
         so each file wins on equal specificity. One file per domain because
         styles.css is ~2400 lines and is the repo's worst merge-conflict
         surface — the split is what lets navigation, scroll, layout and
         micro-interaction work proceed in parallel without rewriting the same
         hunks. Each file documents what it owns; keep edits inside your file. -->
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/scroll.css">
    <link rel="stylesheet" href="/css/motion.css">
</head>
<body>
    <!-- Fixed background atmosphere: faint sage radial wash + abstract shapes -->
    <div class="atmosphere" aria-hidden="true">
        <div class="glow glow-sage"></div>
        <div class="glow glow-olive"></div>
    </div>
    <a class="skip-link" href={`#${skipTarget}`}>Skip to content</a>

    <!-- Fixed top navigation bar. Always visible: it condenses on the way
         down but never translates away, never fades and never needs to be
         hunted for. -->
    {/* No aria-label here. <header> at body level IS the `banner` landmark, so
        aria-label="Primary" named the BANNER "Primary" — measured: Chrome's AX
        tree reported `banner(Primary)`, i.e. a screen reader announced "Primary
        banner". "Primary" belongs on the nav landmark below, which is what it
        was written for. */}
    <header class="topbar">
        <div class="topbar-inner">
            {/* Springy wordmark: per-letter spans so GSAP can stagger them, plus a
                sage rule that sweeps in underneath. No icon — the type IS the mark.
                Letters are wrapped in aria-hidden and the accessible name comes from
                aria-label, so screen readers hear "Samuel Woo — home", not "s a m".
                Untouched by this overhaul: gsap-motion.js reaches for .brand-ltr /
                .brand-rule and for `brand.closest('.topbar')`. */}
            <a class="brand" href={brandHref} aria-label="Samuel Woo — home">
                <span class="brand-name" aria-hidden="true"
                    ><span class="brand-ltr">s</span><span class="brand-ltr">a</span><span
                        class="brand-ltr">m</span><span class="brand-ltr brand-dot">.</span
                    ><span class="brand-rule"></span></span>
            </a>

            {/* Segmented-control link track. `.nav-marker` is the single filled
                sage pill that travels behind whichever link is active — script.js
                owns its transform + width and nothing else writes them. It is
                aria-hidden decoration; `aria-current` on the link is what
                actually announces the active section. */}
            {/* "Primary", not "Sections": this row carries the cross-page
                Projects/Travel links as well as same-page hashes, and the rail
                below was already called "Sections on this page" — two nav
                landmarks whose names differ by four words is a landmark list
                nobody can navigate by. */}
            <nav class="nav-links" id="nav-links" aria-label="Primary">
                <span class="nav-marker" id="nav-marker" aria-hidden="true"></span>
                <a href={href('interests')} class="nav-link" {...spy('interests')}>Interests</a>
                {/* `data-nav-page` marks the link for the page you are ON. It is
                    where the marker parks whenever no section on this page owns a
                    nav link — which is most of projects.html and travel.html, and
                    is why the old build dropped its own active state as soon as
                    you scrolled past the first band. */}
                {page === 'projects' ? (
                    <a href="/projects" class="nav-link is-active" data-nav="projects" data-nav-page aria-current="page">Projects</a>
                ) : (
                    /* On the home page this ALSO spies on the #projects band. The
                       old build left the bar with no active link at all while you
                       read that section, because the only Projects link pointed at
                       the sub-page. It still navigates to projects.html. */
                    <a href="/projects" class="nav-link" {...spy('projects')}>Projects</a>
                )}
                {page === 'travel' ? (
                    <a href="/travel" class="nav-link is-active" data-nav="travel" data-nav-page aria-current="page">Travel</a>
                ) : (
                    <a href="/travel" class="nav-link">Travel</a>
                )}
                <a href={href('work')} class="nav-link" {...spy('work')}>Work</a>
                <a href={href('connect')} class="nav-cta" {...spy('connect')}>Connect</a>
            </nav>

            <div class="topbar-tools">
                {/* Palette trigger. The shortcut is DISCOVERABLE — a visible
                    button carrying its own key hint — because a hidden Cmd-K is
                    a feature only its author knows about. script.js rewrites the
                    kbd to "Ctrl K" off macOS. */}
                {/* aria-expanded, maintained by script.js: with aria-haspopup
                    alone there was no way for a screen reader to tell whether
                    the palette it controls is currently open. */}
                <button class="nav-cmd" id="nav-cmd" type="button"
                        aria-haspopup="dialog" aria-controls="cmdk"
                        aria-expanded="false"
                        aria-keyshortcuts="Meta+K Control+K"
                        aria-label="Jump to a section or page">
                    <svg class="nav-cmd-icon" viewBox="0 0 20 20" aria-hidden="true">
                        <circle cx="9" cy="9" r="5.5" stroke-linecap="round"></circle>
                        <path d="M13.2 13.2 17.5 17.5" stroke-linecap="round"></path>
                    </svg>
                    <span class="nav-cmd-text" aria-hidden="true">Jump to</span>
                    <kbd id="nav-cmd-key" aria-hidden="true">⌘K</kbd>
                </button>

                {/* The label is STABLE. It used to flip to "Close menu" on open,
                    which double-encoded the state next to aria-expanded ("Close
                    menu, expanded") — and could never be heard anyway, because
                    showModal() makes everything outside the drawer inert. */}
                <button class="nav-toggle" id="nav-toggle" type="button"
                        aria-haspopup="dialog" aria-controls="nav-drawer"
                        aria-expanded="false" aria-label="Menu">
                    <span class="nav-toggle-bar" aria-hidden="true"></span>
                    <span class="nav-toggle-bar" aria-hidden="true"></span>
                    <span class="nav-toggle-bar" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        {/* Progress on the bar's own edge: the fill is where you are, the
            ticks are where each section starts. This is the narrow-viewport
            stand-in for the right-hand rail. Ticks come from script.js. */}
        <div class="bar-progress" aria-hidden="true">
            <div class="scroll-progress" id="scroll-progress"></div>
        </div>
    </header>
    {/* Holds the bar's ORIGINAL 68px of flow space so condensing costs no
        layout. Do not bind this to the live bar height. */}
    <div class="topbar-spacer" aria-hidden="true"></div>

    {/* Right-edge section rail (>=1024px). Filled in by script.js from this
        page's own `.band` elements — empty is display:none, so a JS-off
        reader sees nothing rather than an empty gutter. */}
    <nav class="section-rail" id="section-rail" aria-label="On this page"></nav>

    <slot />

    <!-- ===================================================================
         Mobile drawer. A native <dialog>, so the focus trap, Escape and the
         top layer are the platform's job, not ours. Rows carry
         `.drawer-stagger`; nav.css animates them from a `from`-only keyframe
         so the resting state is the finished state and reduced motion simply
         shows the finished list.
         =================================================================== -->
    <dialog id="nav-drawer" class="nav-dialog drawer" aria-label="Menu">
        <div class="drawer-panel">
            <div class="drawer-head">
                <span class="drawer-eyebrow">Menu</span>
                <button class="drawer-close" id="drawer-close" type="button" aria-label="Close menu">
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"></path>
                    </svg>
                </button>
            </div>

            <button class="drawer-search drawer-stagger" id="drawer-search" type="button"
                    aria-haspopup="dialog" aria-controls="cmdk" aria-expanded="false">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                    <circle cx="9" cy="9" r="5.5" stroke-linecap="round"></circle>
                    <path d="M13.2 13.2 17.5 17.5" stroke-linecap="round"></path>
                </svg>
                Search everything
            </button>

            <div class="drawer-group">
                <span class="drawer-eyebrow" id="drawer-pages-label">Pages</span>
                <nav aria-labelledby="drawer-pages-label">
                    {/* No `is-active` here on purpose: the full fill is reserved
                        for the section you are reading. "The page you are on" is
                        the softer aria-current="page" chip — see nav.css. */}
                    {pageLinks.map((p) => (
                        <a href={p.href} class="drawer-link drawer-stagger"
                           {...(p.key === page ? { 'aria-current': 'page' } : {})}>{p.label}</a>
                    ))}
                </nav>
            </div>

            {/* Filled in by script.js from this page's `.band` elements. */}
            <div class="drawer-group" id="drawer-sections-group" hidden>
                <span class="drawer-eyebrow" id="drawer-sections-label">On this page</span>
                <nav id="drawer-sections" aria-labelledby="drawer-sections-label"></nav>
            </div>

            <a href={href('connect')} class="drawer-link drawer-cta drawer-stagger">Get in touch</a>

            <div class="drawer-foot">
                <a href="mailto:samuel.dw.woo@gmail.com">Email</a>
                <a href="https://github.com/samueldwoo" target="_blank" rel="noopener">GitHub</a>
                <a href="https://linkedin.com/in/samueldwwoo" target="_blank" rel="noopener">LinkedIn</a>
            </div>
        </div>
    </dialog>

    <!-- ===================================================================
         Command palette (Cmd/Ctrl-K, or `/`). Not a <form>: Enter has to open
         the highlighted result, and a `method="dialog"` form would swallow it
         to close the dialog instead. The input is a combobox pointing at the
         listbox below it, so the highlighted row is announced as you arrow
         through it without moving DOM focus off the text field.
         =================================================================== -->
    <dialog id="cmdk" class="nav-dialog cmdk" aria-label="Jump to a section or page">
        <div class="cmdk-panel">
            <div class="cmdk-head">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                    <circle cx="9" cy="9" r="5.5" stroke-linecap="round"></circle>
                    <path d="M13.2 13.2 17.5 17.5" stroke-linecap="round"></path>
                </svg>
                {/* aria-expanded starts FALSE and is written by renderPalette()
                    from the live result count. It used to be hard-coded "true",
                    so a query that matched nothing still told the screen reader
                    the popup was open — measured: 0 options, aria-expanded=true. */}
                <input id="cmdk-input" class="cmdk-input" type="text"
                       placeholder="Jump to a section or page…"
                       role="combobox" aria-expanded="false" aria-controls="cmdk-list"
                       aria-autocomplete="list" aria-label="Jump to a section or page"
                       autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
                {/* A real button: pointer users get a close control, and a modal
                    with a single focusable child leaves Tab with nowhere to go
                    (Chrome drops focus to the document and the ring disappears).

                    The accessible name has to CONTAIN the visible word "esc" or
                    this fails WCAG 2.5.3 Label in Name (Level A) — with
                    aria-label="Close", a voice-control user saying "click esc"
                    addressed nothing. Measured as the only 2.5.3 miss in the
                    chrome. */}
                <button type="button" class="cmdk-esc" id="cmdk-close"
                        aria-label="Close (esc)">esc</button>
            </div>
            {/* A DIV, not a UL. role="listbox" may only own `option` and `group`
                children, and the group headings were `li[role="presentation"]`
                whose text ("This page", "Site", "Reach out") was still exposed
                INSIDE the listbox. renderPalette() now emits
                div[role=group][aria-label] wrappers around div[role=option]
                rows, which is legal ARIA and legal HTML — a `li` cannot contain
                the `li`s a nested group would need. */}
            <div class="cmdk-list" id="cmdk-list" role="listbox" aria-label="Results"></div>
            {/* Visual empty state only; the announcement is the status region
                below, so this must not be read a second time. */}
            <p class="cmdk-empty" id="cmdk-empty" hidden aria-hidden="true">Nothing matches that.</p>
            {/* The result count had NO announcement at all: typing a query that
                matched nothing simply went quiet — aria-activedescendant was
                cleared and nothing replaced it. script.js writes a debounced
                count here so the region speaks once per pause, not per keystroke. */}
            <p class="nav-sr" id="cmdk-status" role="status" aria-live="polite"></p>
            <div class="cmdk-foot" aria-hidden="true">
                <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
                <span><kbd>↵</kbd> open</span>
                <span><kbd>esc</kbd> close</span>
            </div>
        </div>
    </dialog>

    <!-- Vendored libs + the two hand-written motion files, in the exact order
         the static pages used them. `is:inline` keeps Astro/Vite from
         bundling, hashing or reordering any of it — these are byte-identical
         <script src> tags pointing at public/.

         Order matters: GSAP + ScrollTrigger, then gsap-motion.js so it can
         claim its elements via html.gsap-on BEFORE script.js runs and decides
         whether to skip .gsap-reveal nodes. anime.min.js only has to precede
         script.js.

         motion.min.js is Motion's (motion.dev) own UMD bundle — its
         `dist/motion.js`, which exposes the whole vanilla API on
         `window.Motion` from a plain <script>, so no bundler is involved.
         motion-ux.js runs LAST: its nav-indicator watches the `is-active`
         class that script.js's scroll-spy sets, so the spy must have run
         and placed the initial active link first. -->
    <script is:inline src="/gsap.min.js"></script>
    <script is:inline src="/ScrollTrigger.min.js"></script>
    <script is:inline src="/SplitText.min.js"></script>
    <script is:inline src="/gsap-motion.js"></script>
    <script is:inline src="/anime.min.js"></script>
    <script is:inline src="/script.js"></script>
    <script is:inline src="/motion.min.js"></script>
    <script is:inline src="/motion-ux.js"></script>
</body>
</html>

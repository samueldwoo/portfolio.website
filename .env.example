# =============================================================================
# [us] — the private wing. Environment variables.
#
# COPY THIS FILE, NEVER FILL THIS ONE IN.
# `.env` is gitignored; this example is the only one that gets committed, and
# THIS REPO IS PUBLIC. A real value pasted here is a published secret.
#
# Generate the gate secrets with:   npm run gate:hash
# It writes .env for local dev and prints the block to paste into
# Vercel → Project → Settings → Environment Variables (all environments).
# =============================================================================


# --- THE GATE (required — without all three, the gate fails CLOSED) ----------

# HMAC key for answer digests. Generated once by gate:hash.
# CHANGING THIS INVALIDATES EVERY ANSWER — you would have to re-run gate:hash
# and re-paste US_ANSWERS. It is not a rotate-whenever value.
US_ANSWER_PEPPER=

# HMAC key for session / progress / admin tokens.
# Changing this signs everyone out. Safe to rotate; independent of the pepper,
# which is exactly why they are two variables and not one.
US_SESSION_SECRET=

# base64(JSON) — string[][]. Outer index = question, inner list = every accepted
# phrasing's digest. Order MUST match src/lib/us/questions.mjs. Produced by
# gate:hash, which walks that same file so the two cannot drift.
US_ANSWERS=


# --- CONTENT (optional) ------------------------------------------------------

# Her name, for copy. In an env var because the repo is public and her name is
# hers. Unset falls back to "you", which reads as deliberate second person
# rather than a broken template.
US_HER_NAME=

# base64(JSON) — Question[]. Overrides src/lib/us/questions.mjs wholesale.
# Only needed if a QUESTION (not an answer) would be embarrassing to publish.
US_QUESTIONS=

# Set to 1 to assert that the gate answers are NOT derivable from anything
# already published (the portfolio, a public profile, this repo). Until it is
# set, the gate logs a loud warning and shows a dev banner, because the failure
# it guards against is silent: the wing looks locked while being openable by
# anyone who read samueldwoo.com. `gate:hash` asks and sets this for you.
US_GATE_REVIEWED=

# Digest of my admin passcode, for /stronger/dj. From gate:hash.
# Compared RAW, not normalized — case and punctuation count.
US_ADMIN_PASSCODE_DIGEST=


# --- CLOUDFLARE R2: photos, and the song archive (optional) ------------------
#
# Unset = the studio renders generated placeholder images and songs persist
# in-process only. Everything is demoable with none of this filled in.
#
# Setup: Cloudflare → R2 → create a PRIVATE bucket → Account Details →
# API Tokens → Manage → Account API token → permission "Object Read & Write",
# scoped to that one bucket. The Secret Access Key is shown exactly once.
#
# !!! DO NOT enable the r2.dev public dev URL, and DO NOT attach a custom
# !!! domain to this bucket. Either makes every photo world-readable at a
# !!! guessable URL and silently defeats the entire lock. Access is ONLY ever
# !!! via the short-lived presigned URLs minted after a cookie check.
#
# Endpoint is derived: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=


# --- UPSTASH REDIS (optional) -----------------------------------------------
#
# Only genuinely needed for a rate limiter that counts correctly ACROSS
# serverless instances. Unset, the limiter falls back to a per-instance
# in-process counter — best-effort, and a determined attacker gets more than
# the stated 12 attempts per window. Free tier needs no credit card.
#
# The limiter FAILS OPEN if Upstash errors: the answers are the primary control
# and an outage must not lock her out of her own present.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
